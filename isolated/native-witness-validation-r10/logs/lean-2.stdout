theorem YulangClosure.NativeExternalEffectFrameR8.effect_frame : ∀ (s : State) (e : Effect), pi (e.apply s) = pi s :=
fun s e =>
  State.casesOn (motive := fun t => s = t → pi (e.apply s) = pi s) s
    (fun evidence observed h =>
      Eq.symm h ▸
        Effect.casesOn (motive := fun t =>
          e = t →
            pi (e.apply { evidence := evidence, observed := observed }) =
              pi { evidence := evidence, observed := observed })
          e (fun h => Eq.symm h ▸ Eq.refl (pi (Effect.physical.apply { evidence := evidence, observed := observed })))
          (fun h => Eq.symm h ▸ Eq.refl (pi (Effect.failed.apply { evidence := evidence, observed := observed })))
          (fun n h =>
            Eq.symm h ▸ Eq.refl (pi ((Effect.attempts n).apply { evidence := evidence, observed := observed })))
          (fun capacity h =>
            Eq.symm h ▸
              Eq.refl (pi ((Effect.journalPeak capacity).apply { evidence := evidence, observed := observed })))
          (fun image h =>
            Eq.symm h ▸ Eq.refl (pi ((Effect.ledger image).apply { evidence := evidence, observed := observed })))
          (fun image h =>
            Eq.symm h ▸ Eq.refl (pi ((Effect.counters image).apply { evidence := evidence, observed := observed })))
          (fun n h =>
            Eq.symm h ▸ Eq.refl (pi ((Effect.samples n).apply { evidence := evidence, observed := observed })))
          (fun image h =>
            Eq.symm h ▸ Eq.refl (pi ((Effect.trace image).apply { evidence := evidence, observed := observed })))
          (fun image h =>
            Eq.symm h ▸ Eq.refl (pi ((Effect.walker image).apply { evidence := evidence, observed := observed })))
          (fun image h =>
            Eq.symm h ▸ Eq.refl (pi ((Effect.sink image).apply { evidence := evidence, observed := observed })))
          (fun h => Eq.symm h ▸ Eq.refl (pi (Effect.takeMatrix.apply { evidence := evidence, observed := observed })))
          (fun image h =>
            Eq.symm h ▸ Eq.refl (pi ((Effect.detached image).apply { evidence := evidence, observed := observed })))
          (fun h => Eq.symm h ▸ Eq.refl (pi (Effect.dropDetached.apply { evidence := evidence, observed := observed })))
          (fun image h =>
            Eq.symm h ▸
              Eq.refl (pi ((Effect.restoreMatrix image).apply { evidence := evidence, observed := observed })))
          (fun tag h =>
            Eq.symm h ▸ Eq.refl (pi ((Effect.milestone tag).apply { evidence := evidence, observed := observed })))
          (Eq.refl e))
    (Eq.refl s)
'YulangClosure.NativeExternalEffectFrameR8.effect_frame' does not depend on any axioms
theorem YulangClosure.NativeExternalEffectFrameR8.effect_keeps_replay_undo : ∀ (s : State) (e : Effect),
  (e.apply s).observed.replayUndoCapacity = s.observed.replayUndoCapacity :=
fun s e =>
  State.casesOn (motive := fun t => s = t → (e.apply s).observed.replayUndoCapacity = s.observed.replayUndoCapacity) s
    (fun evidence observed h =>
      Eq.symm h ▸
        Effect.casesOn (motive := fun t =>
          e = t →
            (e.apply { evidence := evidence, observed := observed }).observed.replayUndoCapacity =
              { evidence := evidence, observed := observed }.observed.replayUndoCapacity)
          e
          (fun h =>
            Eq.symm h ▸
              Eq.refl
                (Effect.physical.apply { evidence := evidence, observed := observed }).observed.replayUndoCapacity)
          (fun h =>
            Eq.symm h ▸
              Eq.refl (Effect.failed.apply { evidence := evidence, observed := observed }).observed.replayUndoCapacity)
          (fun n h =>
            Eq.symm h ▸
              Eq.refl
                ((Effect.attempts n).apply { evidence := evidence, observed := observed }).observed.replayUndoCapacity)
          (fun capacity h =>
            Eq.symm h ▸
              Eq.refl
                ((Effect.journalPeak capacity).apply
                      { evidence := evidence, observed := observed }).observed.replayUndoCapacity)
          (fun image h =>
            Eq.symm h ▸
              Eq.refl
                ((Effect.ledger image).apply
                      { evidence := evidence, observed := observed }).observed.replayUndoCapacity)
          (fun image h =>
            Eq.symm h ▸
              Eq.refl
                ((Effect.counters image).apply
                      { evidence := evidence, observed := observed }).observed.replayUndoCapacity)
          (fun n h =>
            Eq.symm h ▸
              Eq.refl
                ((Effect.samples n).apply { evidence := evidence, observed := observed }).observed.replayUndoCapacity)
          (fun image h =>
            Eq.symm h ▸
              Eq.refl
                ((Effect.trace image).apply { evidence := evidence, observed := observed }).observed.replayUndoCapacity)
          (fun image h =>
            Eq.symm h ▸
              Eq.refl
                ((Effect.walker image).apply
                      { evidence := evidence, observed := observed }).observed.replayUndoCapacity)
          (fun image h =>
            Eq.symm h ▸
              Eq.refl
                ((Effect.sink image).apply { evidence := evidence, observed := observed }).observed.replayUndoCapacity)
          (fun h =>
            Eq.symm h ▸
              Eq.refl
                (Effect.takeMatrix.apply { evidence := evidence, observed := observed }).observed.replayUndoCapacity)
          (fun image h =>
            Eq.symm h ▸
              Eq.refl
                ((Effect.detached image).apply
                      { evidence := evidence, observed := observed }).observed.replayUndoCapacity)
          (fun h =>
            Eq.symm h ▸
              Eq.refl
                (Effect.dropDetached.apply { evidence := evidence, observed := observed }).observed.replayUndoCapacity)
          (fun image h =>
            Eq.symm h ▸
              Eq.refl
                ((Effect.restoreMatrix image).apply
                      { evidence := evidence, observed := observed }).observed.replayUndoCapacity)
          (fun tag h =>
            Eq.symm h ▸
              Eq.refl
                ((Effect.milestone tag).apply
                      { evidence := evidence, observed := observed }).observed.replayUndoCapacity)
          (Eq.refl e))
    (Eq.refl s)
'YulangClosure.NativeExternalEffectFrameR8.effect_keeps_replay_undo' does not depend on any axioms
theorem YulangClosure.NativeExternalEffectFrameR8.effects_frame : ∀ (s : State) (es : List Effect),
  pi (applyEffects s es) = pi s :=
fun s es =>
  List.rec (motive := fun es => ∀ (s : State), pi (applyEffects s es) = pi s)
    (fun s => Eq.refl (pi (applyEffects s []))) (fun e es ih s => Eq.trans (ih (e.apply s)) (effect_frame s e)) es s
'YulangClosure.NativeExternalEffectFrameR8.effects_frame' does not depend on any axioms
theorem YulangClosure.NativeExternalEffectFrameR8.every_prefix_frame : ∀ (s : State) (es : List Effect) (n : Nat),
  pi (applyEffects s (List.take n es)) = pi s :=
fun s es n => effects_frame s (List.take n es)
'YulangClosure.NativeExternalEffectFrameR8.every_prefix_frame' does not depend on any axioms
theorem YulangClosure.NativeExternalEffectFrameR8.callback_frame : ∀ (s : State) (io : WriteAll) (p : CallbackPlan),
  pi (applyEffects s (callback io p).effects) = pi s :=
fun s io p => effects_frame s (callback io p).effects
'YulangClosure.NativeExternalEffectFrameR8.callback_frame' depends on axioms: [propext]
theorem YulangClosure.NativeExternalEffectFrameR8.observed_capacity_frame : ∀ (s : State) (io : WriteAll)
  (changed active : Bool) (p : CallbackPlan),
  pi (applyEffects s (observeCapacity io changed active p).effects) = pi s :=
fun s io changed active p => effects_frame s (observeCapacity io changed active p).effects
'YulangClosure.NativeExternalEffectFrameR8.observed_capacity_frame' depends on axioms: [propext]
theorem YulangClosure.NativeExternalEffectFrameR8.native_frame_conditional : ∀ {Native : Type} (view : Native → State)
  (reaches : Native → Native → Prop) (start : Native) (io : WriteAll) (changed active : Bool) (p : CallbackPlan),
  (∀ (stop : Native),
      reaches start stop →
        ∃ n, view stop = applyEffects (view start) (List.take n (observeCapacity io changed active p).effects)) →
    ∀ (stop : Native), reaches start stop → pi (view stop) = pi (view start) :=
fun {Native} view reaches start io changed active p extract stop h =>
  Exists.casesOn (extract stop h) fun n represented =>
    Eq.trans (congrArg pi represented) (every_prefix_frame (view start) (observeCapacity io changed active p).effects n)
'YulangClosure.NativeExternalEffectFrameR8.native_frame_conditional' depends on axioms: [propext]
