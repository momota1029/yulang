import Std

/-!
Native typed-drain stack rollback, in the logical successful-prefix projection.
`frames` is top first (the reverse of the native vector), and `undo` is newest
first (the reverse of the native undo vector). Numeric indices remain native
bottom-based indices. Frame payloads are opaque and may contain every field.
No native source authentication, resource success, or typing law is assumed
to follow from this storage projection.
-/
namespace YulangClosure.NativeFrameRollback

variable {α : Type}

structure State (α : Type) where
  frames : List α
  undo : List (Nat × α)
  deriving Repr, DecidableEq

def initial (base : List α) : State α := ⟨base, []⟩

def Seen (undo : List (Nat × α)) (index : Nat) : Prop :=
  index ∈ undo.map Prod.fst

instance (undo : List (Nat × α)) (index : Nat) : Decidable (Seen undo index) :=
  inferInstanceAs (Decidable (index ∈ undo.map Prod.fst))

def oldUndo (bound : Nat) (undo : List (Nat × α)) : List (Nat × α) :=
  undo.filter (fun entry => decide (entry.1 < bound))

theorem seen_cons (undo : List (Nat × α)) (index key : Nat) (frame : α) :
    Seen ((key, frame) :: undo) index ↔ index = key ∨ Seen undo index := by
  simp only [Seen, List.map_cons, List.mem_cons]

theorem seen_old_iff (undo : List (Nat × α)) {index bound : Nat}
    (h : index < bound) : Seen (oldUndo bound undo) index ↔ Seen undo index := by
  simp only [Seen, oldUndo, List.mem_map, List.mem_filter, decide_eq_true_eq]
  constructor
  · rintro ⟨entry, ⟨mem, _⟩, eq⟩
    exact ⟨entry, mem, eq⟩
  · rintro ⟨entry, mem, eq⟩
    exact ⟨entry, ⟨mem, by omega⟩, eq⟩

/-- The old snapshots are generated by successively exposing the old top.
This is a derived invariant, never an input to the execution theorem. -/
inductive Saved (base : List α) : List (Nat × α) → List α → Prop
  | initial : Saved base [] base
  | touch {undo : List (Nat × α)} {frame : α} {untouched : List α} :
      Saved base undo (frame :: untouched) →
      Saved base ((untouched.length, frame) :: undo) untouched

theorem Saved.length_le {base untouched : List α} {undo : List (Nat × α)}
    (h : Saved base undo untouched) : untouched.length ≤ base.length := by
  induction h with
  | initial => exact Nat.le_refl _
  | touch _ ih => simp only [List.length_cons] at ih; omega

theorem Saved.seen_iff {base untouched : List α} {undo : List (Nat × α)}
    (h : Saved base undo untouched) (index : Nat) :
    Seen undo index ↔ untouched.length ≤ index ∧ index < base.length := by
  induction h with
  | initial => simp [Seen]
  | @touch undo frame untouched h ih =>
    have bound := h.length_le
    rw [seen_cons, ih]
    simp only [List.length_cons] at bound ⊢
    constructor
    · rintro (eq | ⟨lower, upper⟩) <;> omega
    · rintro ⟨lower, upper⟩
      by_cases eq : index = untouched.length
      · exact Or.inl eq
      · exact Or.inr ⟨by omega, upper⟩

theorem Saved.original_split {base untouched : List α} {undo : List (Nat × α)}
    (h : Saved base undo untouched) :
    base = undo.reverse.map Prod.snd ++ untouched := by
  induction h with
  | initial => rfl
  | touch _ ih => simpa [List.reverse_cons, List.map_append, List.append_assoc] using ih

theorem Saved.increasing_indices {base untouched : List α} {undo : List (Nat × α)}
    (h : Saved base undo untouched) :
    undo.map Prod.fst = List.range' untouched.length (base.length - untouched.length) := by
  induction h with
  | initial => simp
  | @touch undo frame untouched h ih =>
    have bound := h.length_le
    have count : base.length - untouched.length =
        (base.length - (frame :: untouched).length) + 1 := by
      simp only [List.length_cons] at bound ⊢
      omega
    rw [List.map_cons, ih, count, List.range'_succ]
    rfl

/-- The remaining stack contains the untouched old prefix at its bottom.
Only the filtered old journal is constrained; new indices may be interleaved. -/
def Invariant (base : List α) (s : State α) : Prop :=
  ∃ undo untouched live,
    Saved base undo untouched ∧ s.frames = live ++ untouched ∧
    oldUndo base.length s.undo = undo

theorem initial_invariant (base : List α) : Invariant base (initial base) :=
  ⟨[], base, [], Saved.initial, rfl, rfl⟩

inductive Event (α : Type) where
  | begin (frame : α)
  | prepare
  | write (frame : α)
  | pop
  deriving Repr, DecidableEq

/-- Preparation reads the actual top frame, deduplicating by numeric index.
Write/pop require an existing snapshot for old slots. New slots need none.
This guard records storage ownership, not the native semantic stage guards. -/
def step (bound : Nat) (s : State α) : Event α → Option (State α)
  | .begin frame => some { s with frames := frame :: s.frames }
  | .prepare =>
      match s.frames with
      | [] => none
      | frame :: rest =>
          if Seen s.undo rest.length then some s
          else some { s with undo := (rest.length, frame) :: s.undo }
  | .write frame =>
      match s.frames with
      | [] => none
      | _ :: rest =>
          if bound ≤ rest.length ∨ Seen s.undo rest.length then
            some { s with frames := frame :: rest }
          else none
  | .pop =>
      match s.frames with
      | [] => none
      | _ :: rest =>
          if bound ≤ rest.length ∨ Seen s.undo rest.length then
            some { s with frames := rest }
          else none

theorem step_preserves {base : List α} {s t : State α} {event : Event α}
    (inv : Invariant base s) (exec : step base.length s event = some t) :
    Invariant base t := by
  obtain ⟨undo, untouched, live, saved, stack, journal⟩ := inv
  have oldSeen (i) (hi : i < base.length) :
      Seen s.undo i ↔ untouched.length ≤ i ∧ i < base.length := by
    rw [← seen_old_iff s.undo hi, journal]
    exact saved.seen_iff i
  cases event with
  | begin frame =>
    simp only [step, Option.some.injEq] at exec
    subst t
    exact ⟨undo, untouched, frame :: live, saved, by simp [stack], journal⟩
  | prepare =>
    cases live with
    | nil =>
      simp only [List.nil_append] at stack
      cases untouched with
      | nil => simp [step, stack] at exec
      | cons frame rest =>
        have bound : rest.length < base.length := by
          have := saved.length_le
          simp only [List.length_cons] at this
          omega
        have unseen : ¬ Seen s.undo rest.length := by
          rw [oldSeen _ bound]
          simp only [List.length_cons]
          omega
        simp only [step, stack, unseen, ↓reduceIte, Option.some.injEq] at exec
        subst t
        refine ⟨(rest.length, frame) :: undo, rest, [frame], Saved.touch saved, ?_, ?_⟩
        · simp
        · simp only [oldUndo] at journal ⊢
          simpa [bound] using congrArg (List.cons (rest.length, frame)) journal
    | cons frame rest =>
      have top : s.frames = frame :: (rest ++ untouched) := by simpa using stack
      by_cases seen : Seen s.undo (rest ++ untouched).length
      · simp only [step, top, seen, ↓reduceIte, Option.some.injEq] at exec
        subst t
        exact ⟨undo, untouched, frame :: rest, saved, stack, journal⟩
      · have fresh : base.length ≤ (rest ++ untouched).length := by
          by_cases h : base.length ≤ (rest ++ untouched).length
          · exact h
          · have hi : (rest ++ untouched).length < base.length := by omega
            have cov := (oldSeen _ hi).mpr
              (And.intro (by simp only [List.length_append]; omega) hi)
            exact False.elim (seen cov)
        simp only [step, top, seen, ↓reduceIte, Option.some.injEq] at exec
        subst t
        refine ⟨undo, untouched, frame :: rest, saved, rfl, ?_⟩
        simp only [List.length_append] at fresh
        simpa [oldUndo, Nat.not_lt.mpr fresh] using journal
  | write frame =>
    cases live with
    | nil =>
      simp only [List.nil_append] at stack
      cases untouched with
      | nil => simp [step, stack] at exec
      | cons old rest =>
        have bound : rest.length < base.length := by
          have := saved.length_le
          simp only [List.length_cons] at this
          omega
        have unseen : ¬ Seen s.undo rest.length := by
          rw [oldSeen _ bound]
          simp only [List.length_cons]
          omega
        simp [step, stack, unseen, Nat.not_le.mpr bound] at exec
    | cons old rest =>
      have top : s.frames = old :: (rest ++ untouched) := by simpa using stack
      simp only [step, top] at exec
      split at exec <;> simp only [Option.some.injEq, reduceCtorEq] at exec
      subst t
      exact ⟨undo, untouched, frame :: rest, saved, rfl, journal⟩
  | pop =>
    cases live with
    | nil =>
      simp only [List.nil_append] at stack
      cases untouched with
      | nil => simp [step, stack] at exec
      | cons old rest =>
        have bound : rest.length < base.length := by
          have := saved.length_le
          simp only [List.length_cons] at this
          omega
        have unseen : ¬ Seen s.undo rest.length := by
          rw [oldSeen _ bound]
          simp only [List.length_cons]
          omega
        simp [step, stack, unseen, Nat.not_le.mpr bound] at exec
    | cons old rest =>
      have top : s.frames = old :: (rest ++ untouched) := by simpa using stack
      simp only [step, top] at exec
      split at exec <;> simp only [Option.some.injEq, reduceCtorEq] at exec
      subst t
      exact ⟨undo, untouched, rest, saved, rfl, journal⟩

def run (bound : Nat) (s : State α) : List (Event α) → Option (State α)
  | [] => some s
  | event :: rest => (step bound s event).bind (fun t => run bound t rest)

theorem run_preserves {base : List α} {s t : State α} {events : List (Event α)}
    (inv : Invariant base s) (exec : run base.length s events = some t) :
    Invariant base t := by
  induction events generalizing s with
  | nil => simp only [run, Option.some.injEq] at exec; subst t; exact inv
  | cons event rest ih =>
    simp only [run] at exec
    cases hs : step base.length s event with
    | none => simp [hs] at exec
    | some u =>
      simp only [hs, Option.bind_some] at exec
      exact ih (step_preserves inv hs) exec

theorem checked_snapshot_structure (base : List α) (events : List (Event α)) {s : State α}
    (exec : run base.length (initial base) events = some s) :
    ∃ untouched live,
      s.frames = live ++ untouched ∧ untouched.length ≤ s.frames.length ∧
      base = (oldUndo base.length s.undo).reverse.map Prod.snd ++ untouched ∧
      (oldUndo base.length s.undo).map Prod.fst =
        List.range' untouched.length (base.length - untouched.length) := by
  obtain ⟨undo, untouched, live, saved, stack, journal⟩ :=
    run_preserves (initial_invariant base) exec
  refine ⟨untouched, live, stack, ?_, ?_, ?_⟩
  · rw [stack, List.length_append]
    omega
  · rw [journal]
    exact saved.original_split
  · rw [journal]
    exact saved.increasing_indices

/-- Bottom-indexed replace, or push when the index equals the length.
`none` is precisely the native no-gap assertion failure. -/
def restoreAt : Nat → α → List α → Option (List α)
  | 0, frame, [] => some [frame]
  | 0, frame, _ :: rest => some (frame :: rest)
  | _ + 1, _, [] => none
  | index + 1, frame, old :: rest => (restoreAt index frame rest).map (old :: ·)

theorem restoreAt_prefix (lower extra : List α) (frame : α) :
    restoreAt lower.length frame (lower ++ extra) =
      some (lower ++ frame :: extra.drop 1) := by
  induction lower with
  | nil => cases extra <;> rfl
  | cons old rest ih => simp [restoreAt, ih]

theorem restoreAt_success_iff (index : Nat) (frame : α) (frames : List α) :
    (∃ restored, restoreAt index frame frames = some restored) ↔ index ≤ frames.length := by
  induction frames generalizing index with
  | nil => cases index <;> simp [restoreAt]
  | cons old rest ih =>
    cases index with
    | zero => simp [restoreAt]
    | succ index =>
      simp only [restoreAt, List.length_cons, Nat.succ_le_succ_iff]
      rw [← ih index]
      cases h : restoreAt index frame rest <;> simp

def unwind (undo : List (Nat × α)) (frames : List α) : Option (List α) :=
  match undo with
  | [] => some frames
  | (index, frame) :: rest => (restoreAt index frame frames).bind (unwind rest)

/-- Exact old-index skip order of the native reverse journal traversal. -/
def nativeUnwind (bound : Nat) (undo : List (Nat × α)) (frames : List α) : Option (List α) :=
  match undo with
  | [] => some frames
  | (index, frame) :: rest =>
      if index < bound then
        (restoreAt index frame frames).bind (nativeUnwind bound rest)
      else nativeUnwind bound rest frames

theorem nativeUnwind_filter (bound : Nat) (undo : List (Nat × α)) (frames : List α) :
    nativeUnwind bound undo frames = unwind (oldUndo bound undo) frames := by
  induction undo generalizing frames with
  | nil => rfl
  | cons entry rest ih =>
    obtain ⟨index, frame⟩ := entry
    by_cases old : index < bound
    · simp only [nativeUnwind, old, ↓reduceIte, oldUndo, List.filter_cons,
        decide_true, unwind]
      cases hr : restoreAt index frame frames <;> simp [ih, oldUndo]
    · simpa [nativeUnwind, old, oldUndo] using ih frames

/-- Every retained entry meets the native append-or-replace index guard. -/
def NoGaps (bound : Nat) (undo : List (Nat × α)) (frames : List α) : Prop :=
  match undo with
  | [] => True
  | (index, frame) :: rest =>
      if index < bound then
        index ≤ frames.length ∧
          ∃ restored, restoreAt index frame frames = some restored ∧ NoGaps bound rest restored
      else NoGaps bound rest frames

theorem nativeUnwind_no_gaps (bound : Nat) (undo : List (Nat × α))
    (frames restored : List α) (h : nativeUnwind bound undo frames = some restored) :
    NoGaps bound undo frames := by
  induction undo generalizing frames with
  | nil => trivial
  | cons entry rest ih =>
    obtain ⟨index, frame⟩ := entry
    by_cases old : index < bound
    · simp only [nativeUnwind, old, ↓reduceIte] at h
      cases hr : restoreAt index frame frames with
      | none => simp [hr] at h
      | some next =>
        simp only [hr, Option.bind_some] at h
        have bound := (restoreAt_success_iff index frame frames).mp ⟨next, hr⟩
        exact by
          simp only [NoGaps, old, ↓reduceIte]
          exact ⟨bound, next, hr, ih next h⟩
    · simp only [nativeUnwind, old, ↓reduceIte] at h
      simpa only [NoGaps, old, ↓reduceIte] using ih frames h

theorem Saved.reconstruct {base untouched : List α} {undo : List (Nat × α)}
    (saved : Saved base undo untouched) (extra : List α) :
    unwind undo (untouched.reverse ++ extra) =
      some (base.reverse ++ extra.drop (base.length - untouched.length)) := by
  induction saved generalizing extra with
  | initial => simp [unwind]
  | @touch undo frame untouched saved ih =>
    have bound := saved.length_le
    simp only [List.length_cons] at bound
    have count : 1 + (base.length - (frame :: untouched).length) =
        base.length - untouched.length := by simp only [List.length_cons]; omega
    simp only [unwind]
    rw [show restoreAt untouched.length frame (untouched.reverse ++ extra) =
      some (untouched.reverse ++ frame :: extra.drop 1) from
      by simpa only [List.length_reverse] using restoreAt_prefix untouched.reverse extra frame]
    simp only [Option.bind_some]
    have shape : untouched.reverse ++ frame :: extra.drop 1 =
        (frame :: untouched).reverse ++ extra.drop 1 := by
      simp [List.reverse_cons, List.append_assoc]
    rw [shape, ih]
    simp only [List.drop_drop, count]

def rollback (bound : Nat) (s : State α) : Option (List α) :=
  (nativeUnwind bound s.undo s.frames.reverse).map (fun frames => (frames.take bound).reverse)

/-- This simultaneous reconstruction yields the native no-gap assertion and
the exact entire checkpoint stack; no final rollback-success premise occurs. -/
theorem invariant_rollback {base : List α} {s : State α} (inv : Invariant base s) :
    (∃ extra, nativeUnwind base.length s.undo s.frames.reverse =
      some (base.reverse ++ extra)) ∧ rollback base.length s = some base := by
  obtain ⟨undo, untouched, live, saved, stack, journal⟩ := inv
  have restored : nativeUnwind base.length s.undo s.frames.reverse =
      some (base.reverse ++ live.reverse.drop (base.length - untouched.length)) := by
    rw [nativeUnwind_filter, journal, stack, List.reverse_append]
    exact saved.reconstruct live.reverse
  refine ⟨⟨_, restored⟩, ?_⟩
  simp [rollback, restored]

theorem checked_rollback (base : List α) (events : List (Event α)) {s : State α}
    (exec : run base.length (initial base) events = some s) :
    (∃ extra, nativeUnwind base.length s.undo s.frames.reverse =
      some (base.reverse ++ extra)) ∧ rollback base.length s = some base :=
  invariant_rollback (run_preserves (initial_invariant base) exec)

theorem checked_no_gaps (base : List α) (events : List (Event α)) {s : State α}
    (exec : run base.length (initial base) events = some s) :
    NoGaps base.length s.undo s.frames.reverse := by
  obtain ⟨extra, restored⟩ := (checked_rollback base events exec).1
  exact nativeUnwind_no_gaps _ _ _ _ restored

theorem run_append (bound : Nat) (s : State α) (first second : List (Event α)) :
    run bound s (first ++ second) =
      (run bound s first).bind (fun t => run bound t second) := by
  induction first generalizing s with
  | nil => rfl
  | cons event rest ih =>
    simp only [List.cons_append, run]
    cases hs : step bound s event <;> simp [ih]

/-- Every computed successful prefix reconstructs the same checkpoint.
The index may exceed the event count; `take` then denotes the whole history. -/
theorem checked_all_prefixes (base : List α) (events : List (Event α)) {s : State α}
    (exec : run base.length (initial base) events = some s) (count : Nat) :
    ∃ t, run base.length (initial base) (events.take count) = some t ∧
      Invariant base t ∧
      (∃ extra, nativeUnwind base.length t.undo t.frames.reverse =
        some (base.reverse ++ extra)) ∧ rollback base.length t = some base := by
  have splitRun : (run base.length (initial base) (events.take count)).bind
      (fun t => run base.length t (events.drop count)) = some s := by
    rw [← run_append, List.take_append_drop]
    exact exec
  cases h : run base.length (initial base) (events.take count) with
  | none => simp [h] at splitRun
  | some t =>
    have inv := run_preserves (initial_invariant base) h
    exact ⟨t, rfl, inv, invariant_rollback inv⟩

namespace Witness

def base : List Nat := [20, 10]

/-- Pop both original frames, reuse both old numeric slots, and exercise a
new slot above the checkpoint. Every old slot keeps its first payload. -/
def events : List (Event Nat) :=
  [.prepare, .write 21, .pop, .prepare, .write 11, .pop,
   .begin 30, .prepare, .write 31, .begin 40, .prepare, .pop,
   .begin 50, .prepare, .write 51, .begin 60, .prepare, .write 61, .pop]

def finalState : State Nat := ⟨[51, 31], [(2, 60), (0, 10), (1, 20)]⟩

theorem pop_reuse_computed : run base.length (initial base) events = some finalState := by
  decide

theorem pop_reuse_rollback : rollback base.length finalState = some base :=
  (checked_rollback base events pop_reuse_computed).2

theorem pop_reuse_every_prefix (count : Nat) :
    ∃ t, run base.length (initial base) (events.take count) = some t ∧
      Invariant base t ∧
      (∃ extra, nativeUnwind base.length t.undo t.frames.reverse =
        some (base.reverse ++ extra)) ∧ rollback base.length t = some base :=
  checked_all_prefixes base events pop_reuse_computed count

/-- This is the journal produced by the erroneous snapshot-every-reuse model,
not a native history. Reverse traversal immediately encounters an old gap. -/
theorem duplicated_reuse_gap :
    nativeUnwind 2 [(1, 40), (0, 30), (0, 10), (1, 20)] ([] : List Nat) = none := by
  decide

end Witness

end YulangClosure.NativeFrameRollback
