import YulangClosure.OriginalSourceSyntax

/-!
Constructor-directed static source-signature frames and origin partitions.

Authority: native-signature-formation-definition (2026-10-08) §§2–4,
selecting source-signature-incidence-construction §§3.2–4 and its finite
registered graph construction; call-source-interface-definition §§2–3.

This first slice constructs support, complete finite reference developments,
actual contextual routes, and a source Call-incidence clause. It does not
supply primitive/operator license laws, complete C0, live authority, annotation
realization, or a correspondence from Rust allocations to original source
registrations. The original complete dependent packet is arbitrary and is
never projected to an effect address. No semantic witness is generated by a
static slot. Recursive edges remain finite graph edges.
-/
namespace YulangClosure.SourceSignatureConstruction

open OriginalSource

variable {Joint : Type}

/-- A port catalogue is independent of applicability. Its fields may be an
arbitrary dependent telescope, including provider, future, admission and proof
fields. The complete original joint tuple indexes every field together. -/
structure Catalogue (Joint : Type) where
  Port : Type
  Packet : Joint → Port → Type
  scope : List Binder
  /-- Only the original registered slot-sharing action; no witness quotient. -/
  sharedSlot : Port → Nat

inductive OriginKind where
  | primitive | localOperator | upper
  deriving DecidableEq, Repr

/-- Data at a genuine original primitive/local introduction. Its independent
semantic law is retained as a complete dependent license fiber, not inferred
from a support slot. Authentication of such an input belongs to its owner. -/
structure Introduction (Joint : Type) where
  owner : Site
  occurrence : Site
  kind : OriginKind
  catalogue : Catalogue Joint
  License : (whole : Joint) → (port : catalogue.Port) → catalogue.Packet whole port → Type

inductive Phase where
  | callee | wholeArgument | calleeReturn | receiver | returned | future
  | arm (index : Nat)
  deriving DecidableEq, Repr

/-- The complete static Call slot family. These are interface handles, not
executed values or a finite enumeration of future providers. -/
structure CallNodes where
  callee : Nat
  wholeArgument : Nat
  calleeReturn : Nat
  receiver : Nat
  returned : Nat
  future : Nat
  arms : List Nat
  deriving DecidableEq, Repr

def CallNodes.at (nodes : CallNodes) : Phase → Option Nat
  | .callee => some nodes.callee
  | .wholeArgument => some nodes.wholeArgument
  | .calleeReturn => some nodes.calleeReturn
  | .receiver => some nodes.receiver
  | .returned => some nodes.returned
  | .future => some nodes.future
  | .arm i => nodes.arms[i]?

def CallNodes.entries (nodes : CallNodes) : List (Phase × Nat) :=
  [(.callee, nodes.callee), (.wholeArgument, nodes.wholeArgument),
   (.calleeReturn, nodes.calleeReturn), (.receiver, nodes.receiver),
   (.returned, nodes.returned), (.future, nodes.future)] ++
  nodes.arms.zipIdx.map (fun (node, i) => (.arm i, node))

/-- Every contextual step contains its actual constructor occurrence. A
reference retains its original target and whole substitution identity. -/
inductive Step where
  | alternative (site : Site) (right : Bool)
  | conjunction (site : Site) (right : Bool)
  | operand (site : Site) (index : Nat)
  | call (site : Site) (phase : Phase)
  | reference (site : Site) (root substitution : Nat)
  | scope (binder : Binder)
  | rename (site : Site) (substitution : Nat)
  | insertion (root clause : Nat)
  | annotation (site : Site) (annotation : Annotation)
  deriving DecidableEq, Repr

/-- Import classification is constructor history, not owner/receiver equality.
Insertion and annotations cannot erase an antecedent import. -/
def Step.imports : Step → Bool
  | .alternative .. | .conjunction .. | .operand .. | .call .. | .reference .. => true
  | _ => false

/-- A finite registered port-frame graph. A whole result node retains every
operand/alternative plus only the genuinely introduced local fields. Result
catalogues are independently typed schemas, not semantic inclusion claims.
Reference nodes do not acquire local introductions. -/
inductive Node (Joint : Type) where
  | primitive (intro : Introduction Joint)
  | alternative (site : Site) (left right : Nat) (result : Catalogue Joint)
  | conjunction (site : Site) (left right : Nat) (result : Catalogue Joint)
  | image (site : Site) (operator : Rule) (operands : List Nat) (localFields : List (Introduction Joint))
      (result : Catalogue Joint)
  | call (context : Context) (mark : Mark) (callee argument : Source .expression)
      (nodes : CallNodes) (localFields : List (Introduction Joint)) (result : Catalogue Joint)
  | reference (site : Site) (root substitution : Nat) (result : Catalogue Joint)
  | scope (binder : Binder) (child : Nat) (result : Catalogue Joint)
  | rename (site : Site) (substitution child : Nat) (result : Catalogue Joint)
  | insertion (root clause child : Nat) (result : Catalogue Joint)
  | annotation (site : Site) (annotation : Annotation) (child : Nat) (result : Catalogue Joint)

/-- The original catalogue is retained even if every license fiber is empty. -/
def Node.catalogue : Node Joint → Catalogue Joint
  | .primitive intro => intro.catalogue
  | .alternative _ _ _ result | .conjunction _ _ _ result
  | .image _ _ _ _ result | .call _ _ _ _ _ _ result
  | .reference _ _ _ result | .scope _ _ result | .rename _ _ _ result
  | .insertion _ _ _ result | .annotation _ _ _ result => result

def Node.introductions : Node Joint → List (Introduction Joint)
  | .primitive intro => [intro]
  | .image _ _ _ localFields _ | .call _ _ _ _ _ localFields _ => localFields
  | _ => []

/-- The actual compiler pass. No license, comparison, execution, owner equality
or applicability test participates in this list construction. -/
def Node.edges : Node Joint → List (Step × Nat)
  | .primitive _ => []
  | .alternative site left right _ =>
      [(.alternative site false, left), (.alternative site true, right)]
  | .conjunction site left right _ =>
      [(.conjunction site false, left), (.conjunction site true, right)]
  | .image site _ operands _ _ =>
      operands.zipIdx.map (fun (child, i) => (.operand site i, child))
  | .call _ mark _ _ nodes _ _ =>
      nodes.entries.map (fun (phase, child) => (.call mark.site phase, child))
  | .reference site root substitution _ => [(.reference site root substitution, root)]
  | .scope binder child _ => [(.scope binder, child)]
  | .rename site substitution child _ => [(.rename site substitution, child)]
  | .insertion root clause child _ => [(.insertion root clause, child)]
  | .annotation site ann child _ => [(.annotation site ann, child)]

structure Graph (Joint : Type) where
  nodes : List (Node Joint)
  /-- Root-registration identity is kept separately from original owners. -/
  registration : Nat → Site
  /-- The original legal whole substitution actions, supplied by their local
  owners. This is an action on the ENTIRE dependent tuple, not endpoint IDs.
  Their semantic legality is not inferred from static frame construction. -/
  substitution : Nat → Joint → Joint

def Graph.node (graph : Graph Joint) (index : Nat) : Option (Node Joint) := graph.nodes[index]?

/-- Only the actual original reference/rename applies its whole action. Every
other contextual injection retains the same complete original tuple. -/
def Step.action (graph : Graph Joint) : Step → Joint → Joint
  | .reference _ _ substitution | .rename _ substitution => graph.substitution substitution
  | _ => id

def routeAction (graph : Graph Joint) (route : List Step) (whole : Joint) : Joint :=
  route.foldl (fun row step => step.action graph row) whole

theorem route_action_nil (graph : Graph Joint) (whole : Joint) :
    routeAction graph [] whole = whole := rfl

theorem route_action_cons (graph : Graph Joint) (step : Step) (route : List Step)
    (whole : Joint) :
    routeAction graph (step :: route) whole = routeAction graph route (step.action graph whole) := rfl

theorem route_action_append (graph : Graph Joint) (first second : List Step) (whole : Joint) :
    routeAction graph (first ++ second) whole =
      routeAction graph second (routeAction graph first whole) := by
  exact List.foldl_append

theorem reference_action_once (graph : Graph Joint) (site : Site) (root substitution : Nat)
    (route : List Step) (whole : Joint) :
    routeAction graph (.reference site root substitution :: route) whole =
      routeAction graph route (graph.substitution substitution whole) := rfl

/-- Original source-edge rules. This independent grammar reads actual original
constructors; it mentions neither Node.edges nor the compiled frame. -/
inductive SourceEdge : Node Joint → Step → Nat → Prop where
  | alternativeLeft : SourceEdge (.alternative site left right result) (.alternative site false) left
  | alternativeRight : SourceEdge (.alternative site left right result) (.alternative site true) right
  | conjunctionLeft : SourceEdge (.conjunction site left right result) (.conjunction site false) left
  | conjunctionRight : SourceEdge (.conjunction site left right result) (.conjunction site true) right
  | operand (found : operands[i]? = some child) :
      SourceEdge (.image site operator operands locals result) (.operand site i) child
  | call (found : nodes.at phase = some child) :
      SourceEdge (.call context mark callee argument nodes locals result) (.call mark.site phase) child
  | reference : SourceEdge (.reference site root substitution result)
      (.reference site root substitution) root
  | scope : SourceEdge (.scope binder child result) (.scope binder) child
  | rename : SourceEdge (.rename site substitution child result) (.rename site substitution) child
  | insertion : SourceEdge (.insertion root clause child result) (.insertion root clause) child
  | annotation : SourceEdge (.annotation site annotation child result) (.annotation site annotation) child

/-- Compiled nodes retain all original result and introduction telescopes. -/
structure CompiledNode (Joint : Type) where
  source : Node Joint
  catalogue : Catalogue Joint
  introductions : List (Introduction Joint)
  edges : List (Step × Nat)

def compileNode (node : Node Joint) : CompiledNode Joint :=
  ⟨node, node.catalogue, node.introductions, node.edges⟩

def build (graph : Graph Joint) : List (CompiledNode Joint) := graph.nodes.map compileNode

theorem build_length (graph : Graph Joint) : (build graph).length = graph.nodes.length := by
  simp [build]

theorem build_lookup (graph : Graph Joint) (index : Nat) :
    (build graph)[index]? = (graph.node index).map compileNode := by
  simp [build, Graph.node, List.getElem?_map]

theorem compile_keeps_catalogue (node : Node Joint) :
    (compileNode node).catalogue = node.catalogue := rfl

theorem compile_keeps_source (node : Node Joint) : (compileNode node).source = node := rfl

theorem compile_keeps_introductions (node : Node Joint) :
    (compileNode node).introductions = node.introductions := rfl

private theorem zipIdx_membership {items : List α} {i : Nat} {item : α} :
    (item, i) ∈ items.zipIdx ↔ items[i]? = some item := by
  exact List.mk_mem_zipIdx_iff_getElem?

theorem call_entries_exact (nodes : CallNodes) (phase : Phase) (child : Nat) :
    (phase, child) ∈ nodes.entries ↔ nodes.at phase = some child := by
  cases phase <;> simp [CallNodes.entries, CallNodes.at, List.mem_map, zipIdx_membership,
    Prod.exists, eq_comm]
  constructor
  · rintro ⟨a, b, found, rfl, rfl⟩
    exact found
  · intro found
    exact ⟨child, _, found, rfl, rfl⟩

theorem source_edge_exact {node : Node Joint} {step : Step} {child : Nat} :
    SourceEdge node step child ↔ (step, child) ∈ (compileNode node).edges := by
  constructor
  · intro edge
    cases edge <;> simp_all [compileNode, Node.edges, List.mem_map, zipIdx_membership,
      call_entries_exact]
    exact ⟨child, _, by assumption, rfl, rfl⟩
  · cases node <;> simp only [compileNode, Node.edges, List.mem_cons, List.not_mem_nil,
      or_false, List.mem_map] <;> intro edge
    · contradiction
    · rcases edge with same | same <;> cases same
      · exact .alternativeLeft
      · exact .alternativeRight
    · rcases edge with same | same <;> cases same
      · exact .conjunctionLeft
      · exact .conjunctionRight
    · rcases edge with ⟨⟨target, i⟩, member, same⟩
      cases same
      exact .operand (zipIdx_membership.mp member)
    · rcases edge with ⟨⟨phase, target⟩, member, same⟩
      cases same
      exact .call ((call_entries_exact _ _ _).mp member)
    · cases edge
      exact .reference
    · cases edge
      exact .scope
    · cases edge
      exact .rename
    · cases edge
      exact .insertion
    · cases edge
      exact .annotation

/-- Independently specified finite original provenance developments. Its leaf
is a genuine introducing record; merely following a cycle gives no leaf. -/
inductive PortProv (graph : Graph Joint) : Nat → Introduction Joint → List Step → Prop where
  | introduction (found : graph.node index = some node)
      (introduced : intro ∈ node.introductions) : PortProv graph index intro []
  | contextual (found : graph.node index = some node) (edge : SourceEdge node step child)
      (antecedent : PortProv graph child intro route) :
      PortProv graph index intro (step :: route)

/-- Finite developments in the built certificate graph. The semantic fiber
is not enumerated; source routes and original introducing objects are indices. -/
inductive Developed (compiled : List (CompiledNode Joint)) :
    Nat → Introduction Joint → List Step → Prop where
  | introduction (found : compiled[index]? = some node)
      (introduced : intro ∈ node.introductions) : Developed compiled index intro []
  | contextual (found : compiled[index]? = some node) (edge : (step, child) ∈ node.edges)
      (antecedent : Developed compiled child intro route) :
      Developed compiled index intro (step :: route)

theorem compile_provenance {graph : Graph Joint} {index : Nat} {intro : Introduction Joint}
    {route : List Step} (proof : PortProv graph index intro route) :
    Developed (build graph) index intro route := by
  induction proof with
  | introduction found introduced =>
      apply Developed.introduction
      · rw [build_lookup, found]
        rfl
      · exact introduced
  | contextual found edge antecedent ih =>
      apply Developed.contextual
      · rw [build_lookup, found]
        rfl
      · exact source_edge_exact.mp edge
      · exact ih

theorem read_provenance {graph : Graph Joint} {index : Nat} {intro : Introduction Joint}
    {route : List Step} (proof : Developed (build graph) index intro route) :
    PortProv graph index intro route := by
  induction proof with
  | introduction found introduced =>
      rw [build_lookup] at found
      simp only [Option.map_eq_some_iff] at found
      rcases found with ⟨node, original, same⟩
      cases same
      exact .introduction original introduced
  | contextual found edge antecedent ih =>
      rw [build_lookup] at found
      simp only [Option.map_eq_some_iff] at found
      rcases found with ⟨node, original, same⟩
      cases same
      exact .contextual original (source_edge_exact.mpr edge) ih

theorem provenance_iff (graph : Graph Joint) (index : Nat) (intro : Introduction Joint)
    (route : List Step) :
    Developed (build graph) index intro route ↔ PortProv graph index intro route :=
  ⟨read_provenance, compile_provenance⟩

/-- A full origin partition is an occurrence family. Two equal owners or two
routes to the same introduction are not merged. Every schema is retained
before any contribution license or selected branch is supplied. -/
structure Occurrence (graph : Graph Joint) (index : Nat) where
  intro : Introduction Joint
  route : List Step
  provenance : PortProv graph index intro route

def Occurrence.owner (occurrence : Occurrence graph index) : Site := occurrence.intro.owner

def Occurrence.inherited (occurrence : Occurrence graph index) : Bool :=
  occurrence.route.any Step.imports

/-- Every occurrence's entire arbitrary dependent packet stays at the same
joint witness. Providers, future fields and licenses are never reselected. -/
abbrev Fields (graph : Graph Joint) (index : Nat) (whole : Joint) :=
  (occurrence : Occurrence graph index) →
    (port : occurrence.intro.catalogue.Port) →
      occurrence.intro.catalogue.Packet (routeAction graph occurrence.route whole) port

structure Placement (Joint : Type) where
  receiver : Site
  intro : Introduction Joint
  route : List Step

/-- Actual root insertion sets only the receiver and extends the route. -/
def insert (graph : Graph Joint) (root clause : Nat) (occurrence : Occurrence graph index) :
    Placement Joint :=
  ⟨graph.registration root, occurrence.intro, .insertion root clause :: occurrence.route⟩

def Placement.owner (placement : Placement Joint) : Site := placement.intro.owner

def Placement.inherited (placement : Placement Joint) : Bool := placement.route.any Step.imports

theorem insert_owner (graph : Graph Joint) (root clause : Nat)
    (occurrence : Occurrence graph index) :
    (insert graph root clause occurrence).owner = occurrence.owner := rfl

theorem insert_receiver (graph : Graph Joint) (root clause : Nat)
    (occurrence : Occurrence graph index) :
    (insert graph root clause occurrence).receiver = graph.registration root := rfl

theorem insert_classification (graph : Graph Joint) (root clause : Nat)
    (occurrence : Occurrence graph index) :
    (insert graph root clause occurrence).inherited = occurrence.inherited := rfl

/-- Pull an antecedent occurrence through an actual source edge. -/
def contextual {graph : Graph Joint} {index child : Nat} {node : Node Joint} {step : Step}
    (found : graph.node index = some node) (edge : SourceEdge node step child)
    (occurrence : Occurrence graph child) : Occurrence graph index :=
  ⟨occurrence.intro, step :: occurrence.route, .contextual found edge occurrence.provenance⟩

theorem contextual_owner {graph : Graph Joint} {index child : Nat} {node : Node Joint}
    {step : Step} (found : graph.node index = some node) (edge : SourceEdge node step child)
    (occurrence : Occurrence graph child) :
    (contextual found edge occurrence).owner = occurrence.owner := rfl

theorem contextual_imported {graph : Graph Joint} {index child : Nat} {node : Node Joint}
    {step : Step} (found : graph.node index = some node) (edge : SourceEdge node step child)
    (occurrence : Occurrence graph child) (imports : step.imports = true) :
    (contextual found edge occurrence).inherited = true := by
  simp [contextual, Occurrence.inherited, imports]

/-- Even literal owner/receiver equality cannot make an actual Ref into a
fresh local origin. This is the repaired declared-Ref indexing case. -/
theorem reference_stays_inherited_at_equal_owner (graph : Graph Joint)
    (index target receiver clause : Nat) (site : Site) (substitution : Nat)
    (result : Catalogue Joint)
    (found : graph.node index = some (.reference site target substitution result))
    (occurrence : Occurrence graph target)
    (sameOwner : occurrence.owner = graph.registration receiver) :
    let moved := contextual found (SourceEdge.reference) occurrence
    (insert graph receiver clause moved).owner =
      (insert graph receiver clause moved).receiver ∧
    (insert graph receiver clause moved).inherited = true := by
  refine ⟨sameOwner, ?_⟩
  exact contextual_imported found SourceEdge.reference occurrence rfl

/-- Both conjunction constituents survive as different occurrences even if
their original introductions, owners and semantic coordinate happen to agree. -/
theorem conjunction_occurrences_distinct (graph : Graph Joint) (index left right : Nat)
    (site : Site) (result : Catalogue Joint)
    (found : graph.node index = some (.conjunction site left right result))
    (first : Occurrence graph left) (second : Occurrence graph right) :
    contextual found SourceEdge.conjunctionLeft first ≠
      contextual found SourceEdge.conjunctionRight second := by
  intro same
  have routes := congrArg Occurrence.route same
  have heads := (List.cons.inj routes).1
  cases heads

/-- Empty source provenance cannot acquire an origin through compilation. -/
theorem no_new_origin {graph : Graph Joint} {index : Nat}
    (empty : ∀ intro route, ¬ PortProv graph index intro route) :
    ∀ intro route, ¬ Developed (build graph) index intro route := by
  intro intro route proof
  exact empty intro route (read_provenance proof)

/-- A graph with no genuine introductions has no finite origin development,
including when its reference edges are cyclic. Support remains independent. -/
theorem no_introductions_no_provenance (graph : Graph Joint)
    (empty : ∀ index node, graph.node index = some node → node.introductions = []) :
    ∀ index intro route, ¬ PortProv graph index intro route := by
  intro index intro route proof
  induction proof with
  | introduction found member =>
      rw [empty _ _ found] at member
      contradiction
  | contextual found edge antecedent ih => exact ih

/-- Original support includes all catalogue ports, without a license premise. -/
structure Support (graph : Graph Joint) (index : Nat) where
  node : Node Joint
  found : graph.node index = some node
  port : node.catalogue.Port

structure BuiltSupport (graph : Graph Joint) (index : Nat) where
  node : CompiledNode Joint
  found : (build graph)[index]? = some node
  port : node.catalogue.Port

def compileSupport (support : Support graph index) : BuiltSupport graph index :=
  ⟨compileNode support.node, by rw [build_lookup, support.found]; rfl, support.port⟩

theorem compile_support_packet (support : Support graph index) (whole : Joint) :
    (compileSupport support).node.catalogue.Packet whole (compileSupport support).port =
      support.node.catalogue.Packet whole support.port := rfl

theorem compile_support_sharing (support : Support graph index) :
    (compileSupport support).node.catalogue.sharedSlot (compileSupport support).port =
      support.node.catalogue.sharedSlot support.port := rfl

/-- Finite contextual support paths have no origin or license requirement.
The entire declared schema of an empty/unselected region remains addressable. -/
inductive SupportPath (graph : Graph Joint) : Nat → Nat → List Step → Prop where
  | here : SupportPath graph index index []
  | contextual (found : graph.node index = some node) (edge : SourceEdge node step child)
      (rest : SupportPath graph child target route) :
      SupportPath graph index target (step :: route)

inductive BuiltPath (compiled : List (CompiledNode Joint)) : Nat → Nat → List Step → Prop where
  | here : BuiltPath compiled index index []
  | contextual (found : compiled[index]? = some node) (edge : (step, child) ∈ node.edges)
      (rest : BuiltPath compiled child target route) :
      BuiltPath compiled index target (step :: route)

theorem compile_support_path {graph : Graph Joint} {index target : Nat} {route : List Step}
    (path : SupportPath graph index target route) : BuiltPath (build graph) index target route := by
  induction path with
  | here => exact .here
  | contextual found edge rest ih =>
      refine .contextual ?_ (source_edge_exact.mp edge) ih
      rw [build_lookup, found]
      rfl

theorem read_support_path {graph : Graph Joint} {index target : Nat} {route : List Step}
    (path : BuiltPath (build graph) index target route) : SupportPath graph index target route := by
  induction path with
  | here => exact .here
  | contextual found edge rest ih =>
      rw [build_lookup] at found
      simp only [Option.map_eq_some_iff] at found
      rcases found with ⟨node, original, same⟩
      cases same
      exact .contextual original (source_edge_exact.mpr edge) ih

theorem support_path_iff (graph : Graph Joint) (index target : Nat) (route : List Step) :
    BuiltPath (build graph) index target route ↔ SupportPath graph index target route :=
  ⟨read_support_path, compile_support_path⟩

structure ContextualSupport (graph : Graph Joint) (index : Nat) where
  target : Nat
  route : List Step
  path : SupportPath graph index target route
  support : Support graph target

structure BuiltContextualSupport (graph : Graph Joint) (index : Nat) where
  target : Nat
  route : List Step
  path : BuiltPath (build graph) index target route
  support : BuiltSupport graph target

def compileContextualSupport (support : ContextualSupport graph index) :
    BuiltContextualSupport graph index :=
  ⟨support.target, support.route, compile_support_path support.path, compileSupport support.support⟩

/-- All original substitutions act once, in their actual route order, on one
complete row. The output port has literally the same dependent packet type. -/
theorem compile_contextual_packet (support : ContextualSupport graph index) (whole : Joint) :
    (compileContextualSupport support).support.node.catalogue.Packet
      (routeAction graph (compileContextualSupport support).route whole)
      (compileContextualSupport support).support.port =
    support.support.node.catalogue.Packet (routeAction graph support.route whole)
      support.support.port := rfl

/-- This is a primitive/local leaf license at its retained origin, with its
complete original packet. It is NOT composite DeclContribution applicability:
selection/guarded-field evidence for each enclosing alternative/operator is
separately required before a leaf license is a licensed projection of a whole
contribution. Static support manufactures none of that evidence. -/
structure LeafLicensedField (graph : Graph Joint) (index : Nat) (whole : Joint) where
  occurrence : Occurrence graph index
  port : occurrence.intro.catalogue.Port
  packet : occurrence.intro.catalogue.Packet (routeAction graph occurrence.route whole) port
  license : occurrence.intro.License (routeAction graph occurrence.route whole) port packet

structure InsertedField (graph : Graph Joint) (root clause index : Nat) (whole : Joint) where
  original : LeafLicensedField graph index whole
  placement : Placement Joint
  constructed : placement = insert graph root clause original.occurrence

def insertField (graph : Graph Joint) (root clause : Nat) (field : LeafLicensedField graph index whole) :
    InsertedField graph root clause index whole :=
  ⟨field, insert graph root clause field.occurrence, rfl⟩

theorem inserted_field_readback (graph : Graph Joint) (root clause : Nat)
    (field : LeafLicensedField graph index whole) :
    (insertField graph root clause field).original = field := rfl

theorem insert_field_injective (graph : Graph Joint) (root clause : Nat)
    (first second : LeafLicensedField graph index whole)
    (same : insertField graph root clause first = insertField graph root clause second) :
    first = second := congrArg InsertedField.original same

theorem inserted_field_owner (graph : Graph Joint) (root clause : Nat)
    (field : LeafLicensedField graph index whole) :
    (insertField graph root clause field).placement.owner = field.occurrence.owner := rfl

theorem inserted_field_packet (graph : Graph Joint) (root clause : Nat)
    (field : LeafLicensedField graph index whole) :
    (insertField graph root clause field).original.packet = field.packet := rfl

theorem inserted_field_license (graph : Graph Joint) (root clause : Nat)
    (field : LeafLicensedField graph index whole) :
    (insertField graph root clause field).original.license = field.license := rfl

/-- Any port remains supported even when its entire original license fiber is
empty. This asserts no existence of such a license or of a semantic packet. -/
theorem primitive_support_without_license (graph : Graph Joint) (index : Nat)
    (intro : Introduction Joint) (found : graph.node index = some (.primitive intro))
    (port : intro.catalogue.Port) :
    ∃ support : BuiltSupport graph index, support.node = compileNode (.primitive intro) := by
  exact ⟨compileSupport ⟨.primitive intro, found, port⟩, rfl⟩

/-- Exact clause syntax emitted by the original App inventory. -/
def callAtom (context : Context) (mark : Mark) (callee argument : Source .expression) : Atom :=
  atom .sourceCallIncidence mark.site context [callee.site, argument.site]

/-- The static source-frame component of the original Call-incidence atom.
The six ordered regions and every arm are the constructor's fields; no
supplied global incidence relation is used. Identifying the original typed
field telescopes, authentic source registration and semantic C0 is separate. -/
inductive StaticCallIncidence (graph : Graph Joint) : Atom → Prop where
  | source (index : Nat) (context : Context) (mark : Mark)
      (callee argument : Source .expression) (nodes : CallNodes)
      (localFields : List (Introduction Joint)) (result : Catalogue Joint)
      (found : graph.node index = some (.call context mark callee argument nodes localFields result)) :
      StaticCallIncidence graph (callAtom context mark callee argument)

/-- The actual Call constructor supplies this local source atom; no solver
success, source typing derivation or complete Call certificate is assumed. -/
theorem call_incidence_constructed (graph : Graph Joint) (index : Nat) (context : Context)
    (mark : Mark) (callee argument : Source .expression) (nodes : CallNodes)
    (locals : List (Introduction Joint)) (result : Catalogue Joint)
    (found : graph.node index = some (.call context mark callee argument nodes locals result)) :
    StaticCallIncidence graph (callAtom context mark callee argument) :=
  .source index context mark callee argument nodes locals result found

/-- Every phase field, including arbitrary original arm indices, has the exact
constructed edge. The semantic packet is not required to be inhabited. -/
theorem call_phase_incidence (graph : Graph Joint) (index : Nat) (context : Context)
    (mark : Mark) (callee argument : Source .expression) (nodes : CallNodes)
    (locals : List (Introduction Joint)) (result : Catalogue Joint)
    (found : graph.node index = some (.call context mark callee argument nodes locals result))
    (phase : Phase) (child : Nat) (atPhase : nodes.at phase = some child) :
    ∃ compiled, (build graph)[index]? = some compiled ∧
      (.call mark.site phase, child) ∈ compiled.edges := by
  refine ⟨compileNode (.call context mark callee argument nodes locals result), ?_, ?_⟩
  · rw [build_lookup, found]
    rfl
  · exact source_edge_exact.mp (.call atPhase)

/-- Actual child interfaces retained by the Call builder. Each schema can
contain arbitrary dependent future/provider families; arms are the finite
registered clause family, not an enumeration of its semantic witnesses. -/
structure CallRegions (Joint : Type) where
  callee : Node Joint
  wholeArgument : Node Joint
  calleeReturn : Node Joint
  receiver : Node Joint
  returned : Node Joint
  future : Node Joint
  arms : List (Node Joint)

def CallRegions.nodes (regions : CallRegions Joint) : List (Node Joint) :=
  [regions.callee, regions.wholeArgument, regions.calleeReturn,
   regions.receiver, regions.returned, regions.future] ++ regions.arms

def CallRegions.addresses (regions : CallRegions Joint) (base : Nat) : CallNodes :=
  ⟨base, base + 1, base + 2, base + 3, base + 4, base + 5,
    regions.arms.zipIdx.map (fun (_, i) => base + 6 + i)⟩

/-- Construct all child slots before the Call node. No matching-label search,
license inhabitation test or source execution is used to select an arm. -/
def installCall (graph : Graph Joint) (context : Context) (mark : Mark)
    (callee argument : Source .expression) (regions : CallRegions Joint)
    (locals : List (Introduction Joint)) (result : Catalogue Joint) : Graph Joint :=
  { graph with
    nodes := graph.nodes ++ regions.nodes ++
      [.call context mark callee argument (regions.addresses graph.nodes.length) locals result] }

def callIndex (graph : Graph Joint) (regions : CallRegions Joint) : Nat :=
  graph.nodes.length + regions.nodes.length

theorem installed_call_node (graph : Graph Joint) (context : Context) (mark : Mark)
    (callee argument : Source .expression) (regions : CallRegions Joint)
    (locals : List (Introduction Joint)) (result : Catalogue Joint) :
    (installCall graph context mark callee argument regions locals result).node
      (callIndex graph regions) =
      some (.call context mark callee argument (regions.addresses graph.nodes.length) locals result) := by
  simp [installCall, callIndex, Graph.node, Nat.le_add_right, Nat.add_sub_cancel_left]

/-- The builder retains the exact complete child object, including every
unselected/empty arm schema and its entire dependent catalogue. -/
theorem installed_region_node (graph : Graph Joint) (context : Context) (mark : Mark)
    (callee argument : Source .expression) (regions : CallRegions Joint)
    (locals : List (Introduction Joint)) (result : Catalogue Joint)
    (offset : Nat) (region : Node Joint) (found : regions.nodes[offset]? = some region) :
    (installCall graph context mark callee argument regions locals result).node
      (graph.nodes.length + offset) = some region := by
  have bound := (List.getElem?_eq_some_iff.mp found).1
  change ((graph.nodes ++ regions.nodes) ++ [_])[graph.nodes.length + offset]? = some region
  rw [List.getElem?_append_left (by simp only [List.length_append]; omega)]
  rw [List.getElem?_append_right (by omega)]
  simpa only [Nat.add_sub_cancel_left] using found

theorem installed_old_node (graph : Graph Joint) (context : Context) (mark : Mark)
    (callee argument : Source .expression) (regions : CallRegions Joint)
    (locals : List (Introduction Joint)) (result : Catalogue Joint)
    (index : Nat) (bound : index < graph.nodes.length) :
    (installCall graph context mark callee argument regions locals result).node index =
      graph.node index := by
  change ((graph.nodes ++ regions.nodes) ++ [_])[index]? = graph.nodes[index]?
  rw [List.getElem?_append_left (by simp only [List.length_append]; omega)]
  exact List.getElem?_append_left bound

theorem installed_call_arm (graph : Graph Joint) (context : Context) (mark : Mark)
    (callee argument : Source .expression) (regions : CallRegions Joint)
    (locals : List (Introduction Joint)) (result : Catalogue Joint)
    (index : Nat) (arm : Node Joint) (found : regions.arms[index]? = some arm) :
    (installCall graph context mark callee argument regions locals result).node
      (graph.nodes.length + 6 + index) = some arm := by
  have regionFound : regions.nodes[6 + index]? = some arm := by
    change ([regions.callee, regions.wholeArgument, regions.calleeReturn,
      regions.receiver, regions.returned, regions.future] ++ regions.arms)[6 + index]? = some arm
    rw [List.getElem?_append_right (by simp)]
    simpa using found
  simpa only [Nat.add_assoc] using
    installed_region_node graph context mark callee argument regions locals result
      (6 + index) arm regionFound

/-- Every original catalogue port in every arm is available after actual
construction; this conclusion has no applicable-license premise. -/
theorem installed_arm_support (graph : Graph Joint) (context : Context) (mark : Mark)
    (callee argument : Source .expression) (regions : CallRegions Joint)
    (locals : List (Introduction Joint)) (result : Catalogue Joint)
    (index : Nat) (arm : Node Joint) (found : regions.arms[index]? = some arm)
    (port : arm.catalogue.Port) :
    ∃ support : BuiltSupport (installCall graph context mark callee argument regions locals result)
      (graph.nodes.length + 6 + index), support.node = compileNode arm := by
  exact ⟨compileSupport ⟨arm,
    installed_call_arm graph context mark callee argument regions locals result index arm found,
    port⟩, rfl⟩

/-- This application no longer asks for a pre-registered Call node. The
constructor itself supplies the static Kernel-clause component for raw App. -/
theorem raw_call_static_incidence (graph : Graph Joint) (context : Context) (mark : Mark)
    (callee argument : Source .expression) (regions : CallRegions Joint)
    (locals : List (Introduction Joint)) (result : Catalogue Joint) :
    StaticCallIncidence (installCall graph context mark callee argument regions locals result)
      (callAtom context mark callee argument) :=
  call_incidence_constructed _ _ _ _ _ _ _ _ _
    (installed_call_node graph context mark callee argument regions locals result)

theorem installed_call_registration (graph : Graph Joint) (context : Context) (mark : Mark)
    (callee argument : Source .expression) (regions : CallRegions Joint)
    (locals : List (Introduction Joint)) (result : Catalogue Joint) :
    (installCall graph context mark callee argument regions locals result).registration =
      graph.registration := rfl

theorem installed_call_substitution (graph : Graph Joint) (context : Context) (mark : Mark)
    (callee argument : Source .expression) (regions : CallRegions Joint)
    (locals : List (Introduction Joint)) (result : Catalogue Joint) :
    (installCall graph context mark callee argument regions locals result).substitution =
      graph.substitution := rfl

end YulangClosure.SourceSignatureConstruction

