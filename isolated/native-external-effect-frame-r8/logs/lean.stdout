theorem YulangClosure.NativeExternalEffectFrameR8.effect_frame : ∀ (s : State) (e : Effect), pi (e.apply s) = pi s :=
fun s e =>
  Effect.casesOn (motive := fun t => e = t → pi (e.apply s) = pi s) e (fun h => Eq.symm h ▸ sorry)
    (fun h => Eq.symm h ▸ sorry) (fun n h => Eq.symm h ▸ sorry) (fun capacity h => Eq.symm h ▸ sorry)
    (fun image h => Eq.symm h ▸ sorry) (fun image h => Eq.symm h ▸ sorry) (fun n h => Eq.symm h ▸ sorry)
    (fun image h => Eq.symm h ▸ sorry) (fun image h => Eq.symm h ▸ sorry) (fun image h => Eq.symm h ▸ sorry)
    (fun h => Eq.symm h ▸ sorry) (fun image h => Eq.symm h ▸ sorry) (fun h => Eq.symm h ▸ sorry)
    (fun image h => Eq.symm h ▸ sorry) (fun tag h => Eq.symm h ▸ sorry) (Eq.refl e)
'YulangClosure.NativeExternalEffectFrameR8.effect_frame' depends on axioms: [sorryAx]
theorem YulangClosure.NativeExternalEffectFrameR8.effect_keeps_replay_undo : ∀ (s : State) (e : Effect),
  (e.apply s).observed.replayUndoCapacity = s.observed.replayUndoCapacity :=
fun s e =>
  Effect.casesOn (motive := fun t => e = t → (e.apply s).observed.replayUndoCapacity = s.observed.replayUndoCapacity) e
    (fun h => Eq.symm h ▸ sorry) (fun h => Eq.symm h ▸ sorry) (fun n h => Eq.symm h ▸ sorry)
    (fun capacity h => Eq.symm h ▸ sorry) (fun image h => Eq.symm h ▸ sorry) (fun image h => Eq.symm h ▸ sorry)
    (fun n h => Eq.symm h ▸ sorry) (fun image h => Eq.symm h ▸ sorry) (fun image h => Eq.symm h ▸ sorry)
    (fun image h => Eq.symm h ▸ sorry) (fun h => Eq.symm h ▸ sorry) (fun image h => Eq.symm h ▸ sorry)
    (fun h => Eq.symm h ▸ sorry) (fun image h => Eq.symm h ▸ sorry) (fun tag h => Eq.symm h ▸ sorry) (Eq.refl e)
'YulangClosure.NativeExternalEffectFrameR8.effect_keeps_replay_undo' depends on axioms: [sorryAx]
theorem YulangClosure.NativeExternalEffectFrameR8.effects_frame : ∀ (s : State) (es : List Effect),
  pi (applyEffects s es) = pi s :=
fun s es =>
  List.rec (motive := fun es => ∀ (s : State), pi (applyEffects s es) = pi s)
    (fun s => Eq.refl (pi (applyEffects s []))) (fun e es ih s => Eq.trans (ih (e.apply s)) (effect_frame s e)) es s
'YulangClosure.NativeExternalEffectFrameR8.effects_frame' depends on axioms: [sorryAx]
theorem YulangClosure.NativeExternalEffectFrameR8.every_prefix_frame : ∀ (s : State) (es : List Effect) (n : Nat),
  pi (applyEffects s (List.take n es)) = pi s :=
fun s es n => effects_frame s (List.take n es)
'YulangClosure.NativeExternalEffectFrameR8.every_prefix_frame' depends on axioms: [sorryAx]
theorem YulangClosure.NativeExternalEffectFrameR8.callback_frame : ∀ (s : State) (io : WriteAll) (p : CallbackPlan),
  pi (applyEffects s (callback io p).effects) = pi s :=
fun s io p => effects_frame s (callback io p).effects
'YulangClosure.NativeExternalEffectFrameR8.callback_frame' depends on axioms: [propext, sorryAx]
theorem YulangClosure.NativeExternalEffectFrameR8.observed_capacity_frame : ∀ (s : State) (io : WriteAll)
  (changed active : Bool) (p : CallbackPlan),
  pi (applyEffects s (observeCapacity io changed active p).effects) = pi s :=
fun s io changed active p => effects_frame s (observeCapacity io changed active p).effects
'YulangClosure.NativeExternalEffectFrameR8.observed_capacity_frame' depends on axioms: [propext, sorryAx]
theorem YulangClosure.NativeExternalEffectFrameR8.native_frame_conditional : ∀ {Native : Type} (view : Native → State)
  (reaches : Native → Native → Prop) (start : Native) (io : WriteAll) (changed active : Bool) (p : CallbackPlan),
  (∀ (stop : Native),
      reaches start stop →
        ∃ n, view stop = applyEffects (view start) (List.take n (observeCapacity io changed active p).effects)) →
    ∀ (stop : Native), reaches start stop → pi (view stop) = pi (view start) :=
fun {Native} view reaches start io changed active p extract stop h =>
  Exists.casesOn (extract stop h) fun n represented =>
    Eq.mpr (id (congrArg (fun _a => pi _a = pi (view start)) represented))
      (every_prefix_frame (view start) (observeCapacity io changed active p).effects n)
'YulangClosure.NativeExternalEffectFrameR8.native_frame_conditional' depends on axioms: [propext, sorryAx]
