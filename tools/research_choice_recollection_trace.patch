 #[cfg(test)]
 use std::cell::Cell;
 
+// Provisional, passive evidence for the pinned choice fixture; never production metadata.
+#[cfg(test)]
+pub(crate) fn research_choice_trace(args: std::fmt::Arguments<'_>) {
+    use std::fmt::Write;
+    use std::sync::atomic::{AtomicUsize, Ordering};
+    static EVENTS: AtomicUsize = AtomicUsize::new(0);
+    if std::env::var_os("YULANG_RESEARCH_CHOICE_TRACE").is_none() {
+        return;
+    }
+    let event = EVENTS.fetch_add(1, Ordering::Relaxed);
+    if event >= 12000 {
+        if event == 12000 {
+            eprintln!("[choice-research] TRUNCATED event cap; evidence incomplete");
+        }
+        return;
+    }
+    struct BoundedLine {
+        bytes: [u8; 8192],
+        len: usize,
+    }
+    impl Write for BoundedLine {
+        fn write_str(&mut self, text: &str) -> std::fmt::Result {
+            if text.len() > self.bytes.len() - self.len {
+                return Err(std::fmt::Error);
+            }
+            self.bytes[self.len..self.len + text.len()].copy_from_slice(text.as_bytes());
+            self.len += text.len();
+            Ok(())
+        }
+    }
+    let mut line = BoundedLine { bytes: [0; 8192], len: 0 };
+    let truncated = line.write_fmt(args).is_err();
+    // write_str accepts complete UTF-8 strings only.
+    let text = std::str::from_utf8(&line.bytes[..line.len]).expect("trace UTF-8");
+    eprintln!("[choice-research] event={event} {text}{}",
+        if truncated { " TRUNCATED line cap; evidence incomplete" } else { "" });
+}
