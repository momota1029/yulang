YULANG_AUDIT_BEGIN YulangClosure.NativeContextExpansion.scanStep.eq_1
YulangClosure.NativeContextExpansion.scanStep.eq_1 : ∀ (t : YulangClosure.NativeContextExpansion.Tables)
  (s : YulangClosure.NativeContextExpansion.Scan),
  YulangClosure.NativeContextExpansion.scanStep t s =
    match s.pending with
    | (id, mode) :: rest =>
      if id = 0 ∨ (id, mode) ∈ s.visited then
        Pure.pure
          { pending := rest, visited := s.visited, filters := s.filters, residual := s.residual,
            replayFilters := s.replayFilters, directed := s.directed, replayResidual := s.replayResidual }
      else
        have s :=
          { pending := rest, visited := (id, mode) :: s.visited, filters := s.filters, residual := s.residual,
            replayFilters := s.replayFilters, directed := s.directed, replayResidual := s.replayResidual };
        do
        let node ← t.contexts id
        match node with
          | YulangClosure.NativeContextExpansion.Expr.prefix w input =>
            if
                (mode = YulangClosure.NativeContextExpansion.Mode.outer ∨
                    mode = YulangClosure.NativeContextExpansion.Mode.replay ∧ input = 0) ∧
                  input < id ∧ YulangClosure.NativeContextExpansion.weightValid t w = Bool.true then
              Pure.pure
                { pending := (input, mode) :: rest, visited := s.visited,
                  filters := YulangClosure.NativeMergeExpansion.attach w s.filters,
                  residual := if mode = YulangClosure.NativeContextExpansion.Mode.outer then input else s.residual,
                  replayFilters :=
                    s.replayFilters || Decidable.decide (mode = YulangClosure.NativeContextExpansion.Mode.replay),
                  directed := s.directed, replayResidual := s.replayResidual }
            else Option.none
          | YulangClosure.NativeContextExpansion.Expr.replay lower upper =>
            if lower < id ∧ upper < id then
              have childMode :=
                if mode = YulangClosure.NativeContextExpansion.Mode.directed then
                  YulangClosure.NativeContextExpansion.Mode.directed
                else YulangClosure.NativeContextExpansion.Mode.replay;
              Pure.pure
                { pending := (lower, childMode) :: (upper, childMode) :: rest, visited := s.visited,
                  filters := s.filters, residual := s.residual, replayFilters := s.replayFilters,
                  directed := s.directed,
                  replayResidual :=
                    s.replayResidual || Decidable.decide (mode = YulangClosure.NativeContextExpansion.Mode.outer) }
            else Option.none
          | YulangClosure.NativeContextExpansion.Expr.swap input =>
            if input < id then
              Pure.pure
                { pending := (input, YulangClosure.NativeContextExpansion.Mode.directed) :: rest, visited := s.visited,
                  filters := s.filters, residual := s.residual, replayFilters := s.replayFilters, directed := Bool.true,
                  replayResidual := s.replayResidual }
            else Option.none
          | YulangClosure.NativeContextExpansion.Expr.without input =>
            if input < id then
              Pure.pure
                { pending := (input, YulangClosure.NativeContextExpansion.Mode.directed) :: rest, visited := s.visited,
                  filters := s.filters, residual := s.residual, replayFilters := s.replayFilters, directed := Bool.true,
                  replayResidual := s.replayResidual }
            else Option.none
          | YulangClosure.NativeContextExpansion.Expr.suffix input weight => Option.none
          | YulangClosure.NativeContextExpansion.Expr.both input certificate => Option.none
    | x => Option.none
'YulangClosure.NativeContextExpansion.scanStep.eq_1' depends on axioms: [propext, Quot.sound]
YULANG_AUDIT_END YulangClosure.NativeContextExpansion.scanStep.eq_1
