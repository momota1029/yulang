  {environment : YulangClosure.OriginalSource.Environment Value} {site : YulangClosure.OriginalSource.Site}
  {identity : YulangClosure.OriginalSource.PublicationId Value}
  {record : YulangClosure.OriginalSource.PublicationRecord Value},
  environment.publicationCandidate site = Option.some (identity, record) →
    record.identity = identity ∧
      record.captures = environment.names ∧
        record.fixedFrames = List.filter (fun frame => frame.binder.isFixed) (environment.prefixAtShared site) ∧
          (∀ (frame : YulangClosure.OriginalSource.Frame Value),
              frame ∈ record.fixedFrames → frame.binder.isFixed = Bool.true) ∧
            ∃ entry,
              (List.dropWhile (fun entry => entry.site != site) environment.initializers).head? = Option.some entry ∧
                record.entryPath = entry.path ∧
                  record.entryNames = entry.names ∧
                    record.entryFrames = entry.frames ∧
                      record.initializers = List.dropWhile (fun entry => entry.site != site) environment.initializers
