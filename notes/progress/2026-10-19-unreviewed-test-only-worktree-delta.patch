+#[test]
+fn active_outer_root_two_helper_uses() {
+    let hir = module("my outer = { my loop x = { my direct = loop x; my helper y = loop y; my first = helper x; my second = helper x; helper x }; loop }");
+    let source = hir.local_source(root(&hir, "outer")).unwrap().unwrap();
+    let local = |name: &str| source.bindings().iter()
+        .find(|binding| binding.spelling.as_ref() == name).unwrap().id.clone();
+    let loop_local = local("loop");
+    let helper_local = local("helper");
+    let recursive_apply_names: Vec<_> = source.expressions().iter().filter(|expression| matches!(&expression.form,
+        LocalSourceForm::Name { resolution: LocalSourceResolution::Local(id), .. } if id == &loop_local))
+        .filter(|name| source.expressions().iter().any(|expression| matches!(&expression.form,
+            LocalSourceForm::Apply { callee, .. } if *callee == name.id))).collect();
+    assert_eq!(recursive_apply_names.len(), 2, "direct loop x and nested loop y remain distinct recursive calls");
+    let helper_names: Vec<_> = source.expressions().iter().filter(|expression| matches!(&expression.form,
+        LocalSourceForm::Name { resolution: LocalSourceResolution::Local(id), .. } if id == &helper_local)).collect();
+    assert_eq!(helper_names.len(), 3, "the fixture has three literal helper uses");
+
+    let candidate = CandidateInference::solve(hir.clone()).unwrap();
+    assert!(candidate.candidate_conflicts().is_empty());
+    assert!(recursive_apply_names.iter().all(|name| candidate.fresh_use(&name.occurrence).is_none()),
+        "both direct and nested active-root loop calls stay on the monomorphic root");
+    let helper_routes: Vec<_> = helper_names.iter().take(2)
+        .filter_map(|expression| candidate.fresh_use(&expression.occurrence)).collect();
+    assert_eq!(helper_routes.len(), 2, "two selected helper source uses execute through FreshUse reconstruction");
+    assert!(helper_routes.iter().all(|route| route.rows().all(|row|
+        row.kind() == row.source_row().kind())));
+    assert!(candidate.export(root(&hir, "outer")).is_ok());
+}
