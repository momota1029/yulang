     #[test]
+    fn ordinary_call_result_projects_from_its_source_apply_to_native_result() {
+        let hir = crate::candidate_lifecycle_retirement::hir(
+            "my loop y = loop y; my id x = x; my result = id 1",
+        );
+        let mut session = InferenceSession::try_new_candidate(
+            ConstraintBatch::collect_candidate_mode(hir.clone(), true, true).unwrap(),
+        )
+        .unwrap();
+        session.execute().unwrap();
+
+        let state = &session.batch.candidate_calls;
+        assert_eq!(state.calls.len(), 2);
+        let call = &state.calls[0];
+        let native = call.native.expect("Apply admission retains NativeInterface");
+        let source = hir.local_source_for(&call.owner).unwrap().unwrap();
+        let expression = source.expressions().get(call.expression).unwrap();
+        assert!(matches!(&expression.form, LocalSourceForm::Apply { callee, argument, .. }
+            if callee == &call.callee && argument == &call.argument));
+        assert_eq!(call.checking.occurrence(), &expression.occurrence);
+        assert_eq!(
+            hir.occurrence_source_key(&call.checking.occurrence()).unwrap(),
+            Some(&expression.source),
+        );
+        let observed = crate::candidate_call::observe(&hir, &session.store, state, 0).unwrap();
+        assert!(observed.pending_construction().suppliers().any(|supplier|
+            supplier == crate::candidate_call::PendingCallSupplier::OriginalGenCall0));
+        assert_eq!(observed.unresolved(), UNRESOLVED);
+
+        let result_component = session.live_components[call.result].ordinal;
+        assert_eq!(
+            session.value_endpoint(native.result, Polarity::Negative),
+            session.canonical_value(ValueEndpointKey::ValueRow(result_component)),
+            "NativeInterface.result is the original ApplySourceInput.result endpoint",
+        );
+        let demand = InferenceSession::negative_function_children(
+            &session.store,
+            session.value_endpoint(native.demand, Polarity::Negative),
+        )
+        .expect("Apply demand has four native function ports");
+        assert_eq!(
+            demand,
+            (
+                native.argument,
+                native.argument_effect,
+                native.invocation_effect,
+                native.result,
+            ),
+        );
+
+        let mut wrong_occurrence = state.clone();
+        assert_ne!(wrong_occurrence.calls[0].checking, wrong_occurrence.calls[1].checking);
+        wrong_occurrence.calls[0].checking = wrong_occurrence.calls[1].checking.clone();
+        assert!(crate::candidate_call::observe(
+            &hir, &session.store, &wrong_occurrence, 0,
+        ).is_err());
+
+        let mut invocation_substitution = state.clone();
+        assert_ne!(native.invocation_effect, native.application_effect);
+        invocation_substitution.calls[0].native.as_mut().unwrap().invocation_effect =
+            native.application_effect;
+        assert!(crate::candidate_call::observe(
+            &hir, &session.store, &invocation_substitution, 0,
+        ).is_err());
+
+        let mut result_substitution = state.clone();
+        let other_result = result_substitution.calls[1].native.unwrap().result;
+        assert_ne!(native.result, other_result, "fixture keeps the two Apply result ports distinct");
+        result_substitution.calls[0].native.as_mut().unwrap().result = other_result;
+        assert!(crate::candidate_call::observe(
+            &hir, &session.store, &result_substitution, 0,
+        ).is_err());
+
+        let mut provider_substitution = state.clone();
+        assert_ne!(native.result, native.callee);
+        provider_substitution.calls[0].native.as_mut().unwrap().result = native.callee;
+        assert!(crate::candidate_call::observe(
+            &hir, &session.store, &provider_substitution, 0,
+        ).is_err());
+    }
