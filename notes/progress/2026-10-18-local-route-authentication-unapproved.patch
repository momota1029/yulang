+#[test]
+fn scoped_local_callee_route_survives_a_later_local_argument_use() {
+    let hir = candidate_call_hir(
+        "my id x = x\nmy outer = { my f = id; my a = 1; f a }",
+    );
+    let source = hir.local_source(candidate_call_root(&hir, "outer")).unwrap().unwrap();
+    let f = &source.bindings().iter().find(|binding| binding.spelling.as_ref() == "f").unwrap().id;
+    let a = &source.bindings().iter().find(|binding| binding.spelling.as_ref() == "a").unwrap().id;
+    let local_occurrence = |id: &yu_hir::HirLocalId| source.expressions().iter().find_map(|expression| {
+        matches!(&expression.form, LocalSourceForm::Name {
+            resolution: LocalSourceResolution::Local(found), ..
+        } if found == id).then(|| expression.occurrence.clone())
+    }).unwrap();
+    let callee = local_occurrence(f);
+    let later_argument = local_occurrence(a);
+
+    let candidate = CandidateInference::solve_scoped_experiment(hir).unwrap();
+    assert!(candidate.candidate_conflicts().is_empty());
+    let callee_route = candidate.fresh_use(&callee).expect("exact callee local-use route");
+    let argument_route = candidate.fresh_use(&later_argument).expect("later argument local-use route");
+    assert_eq!(callee_route.occurrence(), &callee);
+    assert_eq!(argument_route.occurrence(), &later_argument);
+}
+
+#[test]
+fn scoped_annotated_local_callee_remains_refused_without_annotation_validation() {
+    let hir = candidate_call_hir(
+        "my id x = x\nmy outer = { my f: int = 1; my a = 1; f a }",
+    );
+    let source = hir.local_source(candidate_call_root(&hir, "outer")).unwrap().unwrap();
+    let f = source.bindings().iter().find(|binding| binding.spelling.as_ref() == "f").unwrap();
+    assert!(f.annotation.is_some(), "regression source retains the local annotation");
+    let callee_is_the_annotated_local = source.expressions().iter().any(|expression| {
+        let LocalSourceForm::Apply { callee, .. } = &expression.form else { return false };
+        let Some(callee) = source.expression(callee) else { return false };
+        matches!(&callee.form, LocalSourceForm::Name {
+            resolution: LocalSourceResolution::Local(local), ..
+        } if local == &f.id)
+    });
+    assert!(callee_is_the_annotated_local, "Apply source retains the exact annotated local callee");
+    assert!(CandidateInference::solve_scoped_experiment(hir).is_err());
+}
