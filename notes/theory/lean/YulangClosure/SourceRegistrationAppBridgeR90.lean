import YulangClosure.OriginalSourceGeneration
import YulangClosure.SourceSignatureConstruction

/-!
R90: annotation-aware inversion and constructor-derived static registration.

The original intrusion parent (2026-10-13) §§1, 3, 5, 7 remains open under the
immutable-birth correction (2026-10-24) §§2–6. Selected Source-Generalize
(2026-10-08) §§2–3 / construction §§3–5 and Call interface §§2–3 /
construction §§3–6 fix the original source scope and complete Call telescope.

All four R89 App theorem statements are preserved. `app_rule` eliminates the
complete Mark before annotation cases, so the private annotation wrapper and
its projected field reduce together. R89's failed file is not imported.

The two registration applications consume only actual graph constructors.
They retain the same raw App, every region/arm, original reference route,
origin and whole substitution. They do not turn static support into a license,
provide a concrete Kernel, or assume complete interface adequacy/joint lift.
A registered whole interface, authentic complete Gen-Call-0 and its original
App witness remain required from their actual source constructors. No source
case, effect field, fixed dependency or lawful independent use is discarded.

The primary owns pinned direct execution and independent review. The audit
commands below request complete types and axioms; their presence is not an
execution receipt. No A/B, native correspondence or production closure follows.
-/
namespace YulangClosure.SourceRegistrationAppBridgeR90

open OriginalSource

/-- Exactly the local premise list generated by the original App equation. -/
def appPremises (site : Site) (context : Context)
    (callee argument : Source .expression) : List Premise :=
  (List.map (fun kind => Premise.atom (atom kind site context [callee.site, argument.site]))
    ([AtomKind.descriptorFormation, .wholeArgumentCompatibility,
      .completeCallCertificate, .sourceCallIncidence, .callableImage] ++
      (if singletonFormalCall context callee argument then [AtomKind.roleAndInitialCallOrigin] else []))) ++
    [.checking ⟨.value, site, context, ⟨callee.site, .returnedValue⟩, ⟨site, .descriptor⟩⟩,
     .checking ⟨.computation, site, context, ⟨site, .callableImage⟩, ⟨site, .synthesis⟩⟩]

/-- All Call clauses and both children are below this one original witness. -/
def appCore (site : Site) (context : Context)
    (callee argument : Source .expression) : RuleTree :=
  .existsE ⟨site, .viewLogic, 0⟩
    (.rule .app site context (appPremises site context callee argument)
      (.two (sourceRules context callee) (sourceRules context argument)))

/-- An actual written target retains its outer formation and boundary. -/
def annotationPremises (site : Site) (context : Context) (target : Annotation) :
    List Premise :=
  [.atom {(atom .finalAnnotationFormation site context) with annotation := some target},
   .boundary site context ⟨site, .synthesis⟩ ⟨site, .writtenTarget⟩]

/-- The original builder equation, for arbitrary operands and annotations. -/
theorem app_rule (mark : Mark) (context : Context)
    (callee argument : Source .expression) :
    sourceRules context (.app mark callee argument) =
      match mark.annotation with
      | none => appCore mark.site context callee argument
      | some target =>
          .rule .annotation mark.site context
            (annotationPremises mark.site context target)
            (.one (appCore mark.site context callee argument)) := by
  rcases mark with ⟨site, annotation⟩
  cases annotation <;> simp only [sourceRules] <;> rfl

/-- This logical App binder extends exactly the incoming telescope. The
original root, Shared strategy, publication graph, actual event path and
replay stay fixed; the candidate payload is retained without replacement. -/
theorem app_witness_scope_fields {Value : Type} (environment : Environment Value)
    (site : Site) (witness : ScopedValue Value) :
    let next := environment.extend ⟨site, .viewLogic, 0⟩ witness
    next.root = environment.root ∧
    next.anchors = environment.anchors ∧
    next.publications = environment.publications ∧
    next.origin = environment.origin ∧
    next.eventPath = environment.eventPath ∧
    next.names = environment.names ∧
    next.frames = environment.frames ++ [⟨⟨site, .viewLogic, 0⟩, witness, environment.eventPath⟩] ∧
    next.replay = environment.replay ∧
    next.initializers = environment.initializers := by
  exact ⟨rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl⟩

/-- Exact simultaneous inversion/reconstruction of the original App core.
The existential is outside the entire conjunction. No local clause, child,
checking derivation or effect certificate gets an independent witness. -/
theorem app_core_iff {Value : Type} (kernel : Kernel Value)
    (environment : Environment Value) (site : Site) (context : Context)
    (callee argument : Source .expression) :
    Judgment kernel environment (appCore site context callee argument) ↔
      ∃ witness : ScopedValue Value,
        kernel.admitted environment ⟨site, .viewLogic, 0⟩ witness ∧
        (∀ premise ∈ appPremises site context callee argument,
          Local kernel (environment.extend ⟨site, .viewLogic, 0⟩ witness) premise) ∧
        SourceJudgment kernel (environment.extend ⟨site, .viewLogic, 0⟩ witness)
          context callee ∧
        SourceJudgment kernel (environment.extend ⟨site, .viewLogic, 0⟩ witness)
          context argument := by
  constructor
  · intro derivation
    cases derivation with
    | existsE witness admitted body =>
      cases body with
      | rule locals children =>
        cases children with
        | cons first rest =>
          cases rest with
          | cons second tail =>
            exact ⟨witness, admitted, locals, first, second⟩
  · rintro ⟨witness, admitted, locals, first, second⟩
    exact .existsE witness admitted (.rule locals (.cons first (.cons second .nil)))

/-- Full original App inversion, including an arbitrary written annotation.
The incoming environment is never replaced; every child retains the actual
source syntax, contexts and internal binder trees computed by sourceRules. -/
theorem app_derivation_iff {Value : Type} (kernel : Kernel Value)
    (environment : Environment Value) (mark : Mark) (context : Context)
    (callee argument : Source .expression) :
    SourceJudgment kernel environment context (.app mark callee argument) ↔
      (match mark.annotation with
       | none => True
       | some target => ∀ premise ∈ annotationPremises mark.site context target,
           Local kernel environment premise) ∧
      ∃ witness : ScopedValue Value,
        kernel.admitted environment ⟨mark.site, .viewLogic, 0⟩ witness ∧
        (∀ premise ∈ appPremises mark.site context callee argument,
          Local kernel (environment.extend ⟨mark.site, .viewLogic, 0⟩ witness) premise) ∧
        SourceJudgment kernel (environment.extend ⟨mark.site, .viewLogic, 0⟩ witness)
          context callee ∧
        SourceJudgment kernel (environment.extend ⟨mark.site, .viewLogic, 0⟩ witness)
          context argument := by
  unfold SourceJudgment
  rw [app_rule]
  cases mark.annotation with
  | none =>
    constructor
    · intro derivation
      exact ⟨True.intro, (app_core_iff kernel environment mark.site context callee argument).mp
        derivation⟩
    · intro evidence
      exact (app_core_iff kernel environment mark.site context callee argument).mpr evidence.2
  | some target =>
    constructor
    · intro derivation
      cases derivation with
      | rule locals children =>
        cases children with
        | cons body tail =>
          exact ⟨locals, (app_core_iff kernel environment mark.site context callee argument).mp body⟩
    · rintro ⟨locals, evidence⟩
      exact .rule locals
        (.cons ((app_core_iff kernel environment mark.site context callee argument).mpr evidence) .nil)

/-- Actual Call installation supplies the exact static incidence atom in the
original App premise list. This constructs neither the full semantic meaning
of `kernel.atom` nor the adjacent complete-Call certificate. Every original
region and arm is an input to the independent constructor, without selection. -/
theorem installed_call_app_atom {Joint : Type}
    (graph : SourceSignatureConstruction.Graph Joint) (context : Context) (mark : Mark)
    (callee argument : Source .expression)
    (regions : SourceSignatureConstruction.CallRegions Joint)
    (locals : List (SourceSignatureConstruction.Introduction Joint))
    (result : SourceSignatureConstruction.Catalogue Joint) :
    Premise.atom (SourceSignatureConstruction.callAtom context mark callee argument) ∈
        appPremises mark.site context callee argument ∧
      SourceSignatureConstruction.StaticCallIncidence
        (SourceSignatureConstruction.installCall graph context mark callee argument regions locals result)
        (SourceSignatureConstruction.callAtom context mark callee argument) := by
  constructor
  · simp [appPremises, SourceSignatureConstruction.callAtom]
  · exact SourceSignatureConstruction.raw_call_static_incidence
      graph context mark callee argument regions locals result

/-- IF-Use followed by IF-Insert retains this constructor-derived origin and
applies this reference's whole substitution once. Arbitrary recursive graphs
and the original whole dependent tuple are retained. Static provenance and
placement supply no primitive/operator/Call license or semantic membership. -/
theorem reference_insertion_whole_action {Joint : Type}
    (graph : SourceSignatureConstruction.Graph Joint)
    (index target receiver clause : Nat) (site : Site) (substitution : Nat)
    (result : SourceSignatureConstruction.Catalogue Joint)
    (found : graph.node index = some (.reference site target substitution result))
    (occurrence : SourceSignatureConstruction.Occurrence graph target) (whole : Joint) :
    let moved := SourceSignatureConstruction.contextual found
      SourceSignatureConstruction.SourceEdge.reference occurrence
    let placed := SourceSignatureConstruction.insert graph receiver clause moved
    placed.intro = occurrence.intro ∧
      placed.owner = occurrence.owner ∧
      placed.receiver = graph.registration receiver ∧
      placed.inherited = true ∧
      SourceSignatureConstruction.routeAction graph placed.route whole =
        SourceSignatureConstruction.routeAction graph occurrence.route
          (graph.substitution substitution whole) := by
  refine ⟨rfl, rfl, rfl, ?_, rfl⟩
  exact SourceSignatureConstruction.contextual_imported found
    SourceSignatureConstruction.SourceEdge.reference occurrence rfl

end YulangClosure.SourceRegistrationAppBridgeR90

