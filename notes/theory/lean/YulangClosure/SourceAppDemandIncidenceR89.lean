#print YulangClosure.SourceAppDemandIncidenceR89.appCore
#print YulangClosure.SourceAppDemandIncidenceR89.annotationPremises
#check @YulangClosure.SourceAppDemandIncidenceR89.app_rule
#print axioms YulangClosure.SourceAppDemandIncidenceR89.app_rule
#check @YulangClosure.SourceAppDemandIncidenceR89.app_witness_scope_fields
#print axioms YulangClosure.SourceAppDemandIncidenceR89.app_witness_scope_fields
#check @YulangClosure.SourceAppDemandIncidenceR89.app_core_iff
#print axioms YulangClosure.SourceAppDemandIncidenceR89.app_core_iff
#check @YulangClosure.SourceAppDemandIncidenceR89.app_derivation_iff
#print axioms YulangClosure.SourceAppDemandIncidenceR89.app_derivation_iff
