import YulangClosure.InternalPermissionIncidenceR45

/-!
R46 finite retained-path checker, conditional on exact live source extraction.
No complete arrival relation is an input. The checker constructs a path previousEndpoint
local provider records, bound admissions/emissions, explicit dependency edges,
source-occurrence/fact association and CURRENT physical slot reads. Missing
local cause/ancestry or owner reads fail closed; coverage flags alone do not
prove impossibility. The original provider/entry source bridge
must be independently established; this module supplies no new Rust producer.
It is Internal-specific, with no FreshRoute or FreshUse substitution.
-/
namespace YulangClosure.InternalEntryArrivalR46

open InternalPermissionIncidenceR45

inductive Endpoint (Id : Type) where
  | support (key : Id)
  | row (raw : Id)
  | other (key : Id)
  deriving DecidableEq

structure Provider (Id : Type) where
  occurrence : Id
  declaration : Id
  family : Id
  endpoint : Id
  deriving DecidableEq

inductive Gap where
  | missingRelation | missingGroup | missingEmission | missingAntecedent
  | processingAntecedents | ordinarySeed | replayAntecedents | missingOrigin
  deriving DecidableEq

inductive Cause where
  | ownerEmission (processing : Option Nat)
  | extrusion (processing : Option Nat)
  | freshUse (snapshot useOrigin : Nat)
  | transport (snapshot : Nat)
  deriving DecidableEq

structure Admission (Id : Type) where
  lower : Endpoint Id
  upper : Endpoint Id
  relation : Option Nat
  cause : Cause
  gaps : List Gap
  deriving DecidableEq

structure Slot (Id : Type) where
  owner : Id
  lane : Nat
  index : Nat
  deriving DecidableEq

structure Emission (Id : Type) where
  admission : Nat
  lower : Endpoint Id
  upper : Endpoint Id
  physical : Slot Id
  constructorRead : Endpoint Id × Endpoint Id
  deriving DecidableEq

structure Hop (Id : Type) where
  admissionIndex : Nat
  emissionIndex : Nat
  admission : Admission Id
  emission : Emission Id
  relation : Nat
  /-- Exact retained parent→child dependency path previousEndpoint the Internal root. -/
  ancestry : List Nat
  deriving DecidableEq

structure Query (Artifact Id Fact : Type) where
  use : UseId Artifact Id
  internalFact : Fact
  provider : Provider Id
  entry : Id
  deriving DecidableEq

structure Inputs (Artifact Id Fact : Type) where
  artifact : Artifact
  providers : List (Provider Id)
  admissions : List (Admission Id)
  emissions : List (Emission Id)
  liveRelations : List Nat
  /-- Projection of actual retained dependency constructors, not guessed edges. -/
  dependencies : List (Nat × Nat)
  /-- Unique actual source Origin occurrence/slot for this relation. -/
  rootSource : Nat → Option (Id × Nat)
  /-- Actual admitted store fact selected by complete source occurrence/slot. -/
  sourceFact : Id × Nat → Option Fact
  /-- Read NOW in the same borrowed live State; historical readback is insufficient. -/
  current : Slot Id → Option (Endpoint Id × Endpoint Id)
  /-- Source relation in an actual retained snapshot, when present. -/
  snapshotRelation : Nat → Option Nat

structure Certificate (Artifact Id Fact : Type) where
  query : Query Artifact Id Fact
  rootRelation : Nat
  path : List (Hop Id)
  deriving DecidableEq

variable {Artifact Id Fact : Type} [DecidableEq Artifact] [DecidableEq Id] [DecidableEq Fact]

def providersFor (e : Inputs Artifact Id Fact) (p : Provider Id) :=
  e.providers.filter (fun actual => actual.occurrence == p.occurrence &&
    actual.declaration == p.declaration)

/-- Root association is checked by actual source Origin and source fact; there
is no assumed transitive provider-arrival predicate or arbitrary eligibility bit. -/
def Common (e : Inputs Artifact Id Fact) (q : Query Artifact Id Fact) (root : Nat) : Prop :=
  q.use.artifact = e.artifact ∧ providersFor e q.provider = [q.provider] ∧
  e.rootSource root = some (q.use.occurrence, 0) ∧
  e.sourceFact (q.use.occurrence, 0) = some q.internalFact

instance (e : Inputs Artifact Id Fact) (q : Query Artifact Id Fact) (root : Nat) :
    Decidable (Common e q root) := by unfold Common; infer_instance

def ancestryCheck (e : Inputs Artifact Id Fact) : Nat → List Nat → Nat → Bool
  | current, [], target => decide (current = target ∧ current ∈ e.liveRelations)
  | current, next :: rest, target =>
      decide (current ∈ e.liveRelations ∧ (current, next) ∈ e.dependencies) &&
        ancestryCheck e next rest target

/-- Independent finite reachability relation generated by retained edges only. -/
inductive RelationPath (e : Inputs Artifact Id Fact) : Nat → Nat → Prop where
  | refl {r} : r ∈ e.liveRelations → RelationPath e r r
  | step {r next target} : r ∈ e.liveRelations → (r, next) ∈ e.dependencies →
      RelationPath e next target → RelationPath e r target

omit [DecidableEq Artifact] [DecidableEq Id] [DecidableEq Fact] in
theorem ancestry_sound (e : Inputs Artifact Id Fact) (root target : Nat) (path : List Nat)
    (checked : ancestryCheck e root path target = true) : RelationPath e root target := by
  induction path generalizing root with
  | nil =>
    have h : root = target ∧ root ∈ e.liveRelations := by simpa [ancestryCheck] using checked
    cases h.1
    exact .refl h.2
  | cons next rest ih =>
    have h : (root ∈ e.liveRelations ∧ (root, next) ∈ e.dependencies) ∧
        ancestryCheck e next rest target = true := by simpa [ancestryCheck] using checked
    exact .step h.1.1 h.1.2 (ih next h.2)

/-- Reconstruct the local cause edge from actual processing/snapshot records.
Legacy coverage bits neither establish this edge nor refute its reconstruction. -/
def causeCheck (e : Inputs Artifact Id Fact) (h : Hop Id) : Bool :=
  let parent := match h.admission.cause with
    | .ownerEmission processing | .extrusion processing => processing
    | .freshUse snapshot _ | .transport snapshot => e.snapshotRelation snapshot
  match parent with
  | none => false
  | some parent => decide (parent ∈ e.liveRelations ∧
      (parent, h.relation) ∈ e.dependencies)

/-- Every edge reads the CURRENT owning records, checks the reconstructed cause edge,
physical slot association, constructor and current readback, and ancestry. -/
def HopValid (e : Inputs Artifact Id Fact) (root : Nat) (previousEndpoint : Endpoint Id)
    (h : Hop Id) : Prop :=
  e.admissions[h.admissionIndex]? = some h.admission ∧
  e.emissions[h.emissionIndex]? = some h.emission ∧
  h.emission.admission = h.admissionIndex ∧ h.admission.relation = some h.relation ∧
  h.admission.lower = previousEndpoint ∧ h.emission.lower = h.admission.lower ∧
  h.emission.upper = h.admission.upper ∧ causeCheck e h = true ∧
  h.emission.constructorRead = (h.admission.lower, h.admission.upper) ∧
  e.current h.emission.physical = some (h.admission.lower, h.admission.upper) ∧
  ancestryCheck e root h.ancestry h.relation = true

instance (e : Inputs Artifact Id Fact) (root : Nat) (previousEndpoint : Endpoint Id) (h : Hop Id) :
    Decidable (HopValid e root previousEndpoint h) := by unfold HopValid; infer_instance

def walk (e : Inputs Artifact Id Fact) (root : Nat) :
    Endpoint Id → List (Hop Id) → Id → Bool
  | previousEndpoint, [], entry => decide (previousEndpoint = .row entry)
  | previousEndpoint, h :: rest, entry => decide (HopValid e root previousEndpoint h) &&
      walk e root h.admission.upper rest entry

inductive RecordedPath (e : Inputs Artifact Id Fact) (root : Nat) :
    Endpoint Id → Endpoint Id → Prop where
  | refl {endpoint} : RecordedPath e root endpoint endpoint
  | step {previousEndpoint target} (h : Hop Id) : HopValid e root previousEndpoint h →
      RecordedPath e root h.admission.upper target → RecordedPath e root previousEndpoint target

omit [DecidableEq Artifact] [DecidableEq Fact] in
theorem walk_sound (e : Inputs Artifact Id Fact) (root : Nat)
    (previousEndpoint : Endpoint Id) (path : List (Hop Id)) (entry : Id)
    (checked : walk e root previousEndpoint path entry = true) : RecordedPath e root previousEndpoint (.row entry) := by
  induction path generalizing previousEndpoint with
  | nil =>
    have h : previousEndpoint = .row entry := by simpa [walk] using checked
    cases h
    exact .refl
  | cons h rest ih =>
    have hs : HopValid e root previousEndpoint h ∧ walk e root h.admission.upper rest entry = true := by
      simpa [walk] using checked
    exact .step h hs.1 (ih h.admission.upper hs.2)

omit [DecidableEq Artifact] [DecidableEq Fact] in
theorem walk_hops (e : Inputs Artifact Id Fact) (root : Nat)
    (previousEndpoint : Endpoint Id) (path : List (Hop Id)) (entry : Id)
    (checked : walk e root previousEndpoint path entry = true) :
    ∀ h ∈ path, ∃ previous, HopValid e root previous h := by
  induction path generalizing previousEndpoint with
  | nil => simp
  | cons h rest ih =>
    have hs : HopValid e root previousEndpoint h ∧ walk e root h.admission.upper rest entry = true := by
      simpa [walk] using checked
    intro item member
    rcases List.mem_cons.mp member with equal | member
    · subst item; exact ⟨previousEndpoint, hs.1⟩
    · exact ih h.admission.upper hs.2 item member

def extract (e : Inputs Artifact Id Fact) (q : Query Artifact Id Fact)
    (root : Nat) (path : List (Hop Id)) : Option (Certificate Artifact Id Fact) :=
  if Common e q root ∧ walk e root (.support q.provider.endpoint) path q.entry = true
  then some ⟨q, root, path⟩ else none

theorem accepted_iff (e : Inputs Artifact Id Fact) (q : Query Artifact Id Fact)
    (root : Nat) (path : List (Hop Id)) (out : Certificate Artifact Id Fact) :
    extract e q root path = some out ↔ Common e q root ∧
      walk e root (.support q.provider.endpoint) path q.entry = true ∧ out = ⟨q, root, path⟩ := by
  by_cases valid : Common e q root ∧ walk e root (.support q.provider.endpoint) path q.entry = true
  · rw [extract, ite_eq_left valid]
    constructor
    · intro equal
      exact ⟨valid.1, valid.2, (Option.some.inj equal).symm⟩
    · rintro ⟨_, _, rfl⟩
      rfl
  · rw [extract, ite_eq_right valid]
    constructor
    · intro impossible
      cases impossible
    · rintro ⟨common, checked, _⟩
      exact False.elim (valid ⟨common, checked⟩)

theorem accepted_path (e : Inputs Artifact Id Fact) (q : Query Artifact Id Fact)
    (root : Nat) (path : List (Hop Id)) (out : Certificate Artifact Id Fact)
    (accepted : extract e q root path = some out) :
    out.query = q ∧ out.rootRelation = root ∧ out.path = path ∧ path ≠ [] ∧
      RecordedPath e root (.support q.provider.endpoint) (.row q.entry) := by
  obtain ⟨_, checked, rfl⟩ := (accepted_iff e q root path out).mp accepted
  refine ⟨rfl, rfl, rfl, ?_, walk_sound e root _ path q.entry checked⟩
  intro empty
  simp [walk, empty] at checked

theorem accepted_current_ancestry (e : Inputs Artifact Id Fact) (q : Query Artifact Id Fact)
    (root : Nat) (path : List (Hop Id)) (out : Certificate Artifact Id Fact)
    (accepted : extract e q root path = some out) :
    ∀ h ∈ path,
      e.admissions[h.admissionIndex]? = some h.admission ∧
      e.emissions[h.emissionIndex]? = some h.emission ∧
      h.admission.relation = some h.relation ∧ causeCheck e h = true ∧
      e.current h.emission.physical = some (h.admission.lower, h.admission.upper) ∧
      RelationPath e root h.relation := by
  obtain ⟨_, checked, _⟩ := (accepted_iff e q root path out).mp accepted
  intro h member
  obtain ⟨previous, valid⟩ := walk_hops e root _ path q.entry checked h member
  rcases valid with ⟨admission, emission, _, relation, _, _, _, gaps, _, current, ancestry⟩
  exact ⟨admission, emission, relation, gaps, current, ancestry_sound e root _ h.ancestry ancestry⟩

theorem foreign_root_or_provider_rejected (e : Inputs Artifact Id Fact)
    (q : Query Artifact Id Fact) (root : Nat) (path : List (Hop Id))
    (foreign : q.use.artifact ≠ e.artifact ∨ providersFor e q.provider ≠ [q.provider] ∨
      e.rootSource root ≠ some (q.use.occurrence, 0) ∨
      e.sourceFact (q.use.occurrence, 0) ≠ some q.internalFact) : extract e q root path = none := by
  have invalid : ¬ Common e q root := by
    rintro ⟨ha, hp, hr, hf⟩
    rcases foreign with h | h | h | h <;> contradiction
  simp [extract, invalid]

theorem stale_or_incomplete_path_rejected (e : Inputs Artifact Id Fact)
    (q : Query Artifact Id Fact) (root : Nat) (path : List (Hop Id))
    (h : Hop Id) (member : h ∈ path)
    (stale : e.admissions[h.admissionIndex]? ≠ some h.admission ∨
      e.emissions[h.emissionIndex]? ≠ some h.emission ∨ causeCheck e h ≠ true ∨
      e.current h.emission.physical ≠ some (h.admission.lower, h.admission.upper) ∨
      ancestryCheck e root h.ancestry h.relation ≠ true) :
    extract e q root path = none := by
  have invalid : ¬ walk e root (.support q.provider.endpoint) path q.entry = true := by
    intro checked
    obtain ⟨previous, valid⟩ := walk_hops e root _ path q.entry checked h member
    rcases valid with ⟨ha, he, _, _, _, _, _, hg, _, hc, hr⟩
    rcases stale with h | h | h | h | h <;> contradiction
  simp [extract, invalid]

/-- The retained emission's admission has no relation link. A later relation
with equal endpoints does not supply this missing owner association. -/
theorem unlinked_emission_rejected (e : Inputs Artifact Id Fact)
    (q : Query Artifact Id Fact) (root : Nat) (path : List (Hop Id))
    (h : Hop Id) (member : h ∈ path) (unlinked : h.admission.relation = none) :
    extract e q root path = none := by
  have invalid : ¬ walk e root (.support q.provider.endpoint) path q.entry = true := by
    intro checked
    obtain ⟨previous, valid⟩ := walk_hops e root _ path q.entry checked h member
    have link := valid.2.2.2.1
    simp [unlinked] at link
  simp [extract, invalid]

/-- A historical emission plus constructor readback cannot replace a current
physical slot read; this statement makes no inference from coverage flags. -/
theorem historical_only_rejected (e : Inputs Artifact Id Fact)
    (q : Query Artifact Id Fact) (root : Nat) (path : List (Hop Id))
    (h : Hop Id) (member : h ∈ path) (missing : e.current h.emission.physical = none) :
    extract e q root path = none := by
  apply stale_or_incomplete_path_rejected e q root path h member
  apply Or.inr; apply Or.inr; apply Or.inr; apply Or.inl
  simp [missing]

/-- Conditional application to the SAME accepted Internal certificate and R39
permission. Local edge checks construct RecordedPath; complete arrival is NOT
assumed. The source owner must realize each observation in the two models. -/
theorem apply_to_internal {Term : Type} [DecidableEq Term]
    (internalInputs : InternalPermissionIncidenceR45.Inputs Artifact Id Term Fact)
    (internalQuery : InternalPermissionIncidenceR45.Query Artifact Id)
    (probe : InternalPermissionIncidenceR45.Probe Artifact Id Term Fact)
    (internal : InternalPermissionIncidenceR45.Certificate Artifact Id Term Fact)
    (internalAccepted : InternalPermissionIncidenceR45.extract internalInputs internalQuery probe = some internal)
    (e : Inputs Artifact Id Fact) (q : Query Artifact Id Fact)
    (root : Nat) (path : List (Hop Id)) (out : Certificate Artifact Id Fact)
    (pathAccepted : extract e q root path = some out)
    (sameUse : q.use = internal.use) (sameFact : q.internalFact = internal.fact)
    (sameRawEntry : q.entry = internal.permission.entry) :
    out.query.use = internal.use ∧ out.query.internalFact = internal.fact ∧
      internal.permission = probe.permission ∧
      internal.permission.concrete = probe.permission.concrete ∧
      RecordedPath e root (.support q.provider.endpoint) (.row internal.permission.entry) ∧
      internalInputs.positiveFunctionChild internal.function = some internal.argumentEffect ∧
      internalInputs.negativeEntry internal.argumentEffect = some internal.permission.entry := by
  obtain ⟨_, checked, rfl⟩ := (accepted_iff e q root path out).mp pathAccepted
  have payload := InternalPermissionIncidenceR45.accepted_payload internalInputs internalQuery probe internal internalAccepted
  have recorded := walk_sound e root (.support q.provider.endpoint) path q.entry checked
  rw [sameRawEntry] at recorded
  obtain ⟨_, child, entry, _, _⟩ :=
    InternalPermissionIncidenceR45.accepted_constructor_and_endpoints internalInputs internalQuery probe internal internalAccepted
  exact ⟨sameUse, sameFact, payload.1, payload.2.2.1, recorded, child, entry⟩

/-- The information retained by transport ancestry plus a raw bound does not
identify a specific earlier emission/physical slot. Both records below can
have that projection; this is a finite information-loss countermodel, not a
claim that the selected receiving route crosses a transport transition. -/
def transportProjection {Id : Type} (ancestry : List (Nat × Nat)) (emission : Emission Id) :=
  (ancestry, emission.admission, emission.lower, emission.upper)

theorem finite_transport_slot_ambiguity :
    let left : Emission Nat := ⟨0, .support 7, .row 11, ⟨11, 0, 0⟩, (.support 7, .row 11)⟩
    let right : Emission Nat := ⟨0, .support 7, .row 11, ⟨11, 0, 1⟩, (.support 7, .row 11)⟩
    transportProjection [(2, 3)] left = transportProjection [(2, 3)] right ∧
      left.constructorRead = right.constructorRead ∧ left.physical ≠ right.physical ∧ left ≠ right := by
  decide

end YulangClosure.InternalEntryArrivalR46
