+                &bound.direct_upper_rows[..bound.direct_upper_rows.len().min(6)], bound.direct_upper_rows.len(),
+                &bound.exact_non_variable_lowers[..bound.exact_non_variable_lowers.len().min(6)], bound.exact_non_variable_lowers.len(),
