+// Proof-only streaming observer in an isolated source snapshot.
+// It does not modify any solver field; its explicit bound aborts this private
+// observation attempt and must never be reported as native termination.
+#[cfg(not(test))]
+pub(super) fn r148_trace(event: impl Into<String>) {
+    use std::sync::OnceLock;
+    static LIMIT: OnceLock<usize> = OnceLock::new();
+    let limit = *LIMIT.get_or_init(|| std::env::var("YULANG_PROOF_TRACE_LIMIT")
+        .ok().and_then(|value| value.parse().ok()).unwrap_or(0));
+    if limit == 0 { return; }
+    std::thread_local! { static COUNT: std::cell::Cell<usize> = const { std::cell::Cell::new(0) }; }
+    COUNT.with(|count| {
+        let number = count.get() + 1;
+        count.set(number);
+        eprintln!("PROOF_TRACE[{number}] {}", event.into());
+        if number >= limit { panic!("PROOF_TRACE_PREFIX_LIMIT: observation stopped, not solver completion"); }
+    });
 }
