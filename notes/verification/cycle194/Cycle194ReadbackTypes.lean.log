Yulang.GeneralNominalOrdinaryJournal194.uniform_dictionary {roles : Yulang.Roles.RoleDecls}
  {registry : Yulang.GeneralDeclarations.Registry} {root : Yulang.GeneralSourceDictionaries.Occurrence roles}
  {context : Yulang.GeneralNominalCandidates.Context} {after : Yulang.GeneralNominalCenteredHeadStepEffects.State roles}
  (path :
    Yulang.B4Target.Steps (Yulang.GeneralNominalOrdinaryEvidence191.OrdinaryStep registry root)
      (Yulang.GeneralNominalCenteredHeadStepEffects.initial context root) after)
  (covered : Yulang.GeneralDictionaryJournalTree.Covered after.core.erased.current root)
  (accessible : Acc (Yulang.GeneralDictionaryJournalTree.Child after.core.erased.current) root) :
  ∃ tree,
    tree.root = root ∧
      Yulang.GeneralSourceDictionaries.Evidence (Yulang.GeneralDictionaryJournalTree.Recorded after.core.erased.current)
          tree ∧
        ∀ (model : Yulang.GeneralNominalCommonBridge.Assignment),
          Yulang.GeneralNominalCenteredHeadStepEffects.Models after model →
            (Yulang.GeneralNominalCenteredHeadWFBoundary.boundary roles).Evidence registry after model root
              (Yulang.GeneralSourceDictionaries.erase tree)
