'Yulang.GeneralDictionary170PathBound.vertices_le_rank_succ' depends on axioms: [propext, Quot.sound]
@Yulang.GeneralDictionary170PathBound.vertices_le_rank_succ : ∀ {registry : Yulang.GeneralDeclarations.Registry}
