'Yulang.GeneralDictionary170PathBound.length_le_ceiling' depends on axioms: [propext, Quot.sound]
@Yulang.GeneralDictionary170PathBound.length_le_ceiling : ∀ {registry : Yulang.GeneralDeclarations.Registry}
