'Yulang.GeneralDictionary170PathBound.rank_zero_terminal' depends on axioms: [propext, Classical.choice, Quot.sound]
@Yulang.GeneralDictionary170PathBound.rank_zero_terminal : ∀ {registry : Yulang.GeneralDeclarations.Registry}
