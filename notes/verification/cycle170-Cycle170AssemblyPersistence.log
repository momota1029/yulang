'Yulang.GeneralDictionary170AssemblyPersistence.collect_unique' depends on axioms: [propext, Quot.sound]
@Yulang.GeneralDictionary170AssemblyPersistence.collect_unique : ∀ {roles : Yulang.Roles.RoleDecls}
  {values others : List Yulang.GeneralDictionaryReadback.Payload}
  (sites : List (Yulang.GeneralSourceDictionaries.Occurrence roles))
  (first second :
    (child : Yulang.GeneralSourceDictionaries.Occurrence roles) →
      child ∈ sites → Option Yulang.GeneralDictionaryReadback.Payload),
  (∀ (child : Yulang.GeneralSourceDictionaries.Occurrence roles) (member : child ∈ sites)
      (value other : Yulang.GeneralDictionaryReadback.Payload),
      first child member = some value → second child member = some other → value = other) →
    Yulang.GeneralDictionary170BoundedAssembly.collect sites first = some values →
      Yulang.GeneralDictionary170BoundedAssembly.collect sites second = some others → values = others
'Yulang.GeneralDictionary170AssemblyPersistence.successful_fuel_unique' depends on axioms: [propext, Quot.sound]
@Yulang.GeneralDictionary170AssemblyPersistence.successful_fuel_unique : ∀
  {registry : Yulang.GeneralDeclarations.Registry} {roles : Yulang.Roles.RoleDecls}
  {state : Yulang.GeneralNominalSupport.Tracked roles}
  {domain : Yulang.GeneralSourceDictionaries.Occurrence roles → Prop}
  {value other : Yulang.GeneralDictionaryReadback.Payload}
  (coverage : Yulang.GeneralDictionary170NamedCoverage.Coverage registry state domain) (first second : Nat)
  (focus : Subtype domain),
  Yulang.GeneralDictionary170BoundedAssembly.assemble coverage first focus = some value →
    Yulang.GeneralDictionary170BoundedAssembly.assemble coverage second focus = some other → value = other
