'Yulang.GeneralDictionary170AssemblyPersistence.collect_congr' depends on axioms: [propext, Quot.sound]
@Yulang.GeneralDictionary170AssemblyPersistence.collect_congr : ∀ {roles : Yulang.Roles.RoleDecls}
  (left right : List (Yulang.GeneralSourceDictionaries.Occurrence roles)),
  left = right →
    ∀
      (first :
        (child : Yulang.GeneralSourceDictionaries.Occurrence roles) →
          child ∈ left → Option Yulang.GeneralDictionaryReadback.Payload)
      (second :
        (child : Yulang.GeneralSourceDictionaries.Occurrence roles) →
          child ∈ right → Option Yulang.GeneralDictionaryReadback.Payload),
      (∀ (child : Yulang.GeneralSourceDictionaries.Occurrence roles) (memberLeft : child ∈ left)
          (memberRight : child ∈ right), first child memberLeft = second child memberRight) →
        Yulang.GeneralDictionary170BoundedAssembly.collect left first =
          Yulang.GeneralDictionary170BoundedAssembly.collect right second
'Yulang.GeneralDictionary170AssemblyPersistence.assemble_congr' depends on axioms: [propext, Quot.sound]
@Yulang.GeneralDictionary170AssemblyPersistence.assemble_congr : ∀ {roles : Yulang.Roles.RoleDecls}
  {domain : Yulang.GeneralSourceDictionaries.Occurrence roles → Prop} {registry : Yulang.GeneralDeclarations.Registry}
  {before after : Yulang.GeneralNominalSupport.Tracked roles}
  (first : Yulang.GeneralDictionary170NamedCoverage.Coverage registry before domain)
  (second : Yulang.GeneralDictionary170NamedCoverage.Coverage registry after domain),
  (∀ (occurrence : Yulang.GeneralSourceDictionaries.Occurrence roles) (present : domain occurrence),
      (first.node occurrence present).children = (second.node occurrence present).children) →
    (∀ (occurrence : Yulang.GeneralSourceDictionaries.Occurrence roles) (present : domain occurrence),
        (first.node occurrence present).key = (second.node occurrence present).key) →
      ∀ (fuel : Nat) (focus : Subtype domain),
        Yulang.GeneralDictionary170BoundedAssembly.assemble first fuel focus =
          Yulang.GeneralDictionary170BoundedAssembly.assemble second fuel focus
'Yulang.GeneralDictionary170AssemblyPersistence.extension_assemble' depends on axioms: [propext,
