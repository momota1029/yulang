'Yulang.GeneralDictionary170NamedCoveragePersistence.ordinary_dictionary' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
@Yulang.GeneralDictionary170NamedCoveragePersistence.ordinary_dictionary : ∀ {roles : Yulang.Roles.RoleDecls}
  {domain : Yulang.GeneralSourceDictionaries.Occurrence roles → Prop} {registry : Yulang.GeneralDeclarations.Registry}
  {root : Yulang.GeneralSourceDictionaries.Occurrence roles}
  {before after : Yulang.GeneralNominalSupport.Tracked roles},
  Yulang.B4Target.Steps (Yulang.GeneralDictionarySharedEvidenceTrace.OrdinaryStep registry root) before after →
    ∀ (coverage : Yulang.GeneralDictionary170NamedCoverage.Coverage registry before domain) (focus : Subtype domain),
      Yulang.GeneralNominalSharedSteps.SourceFormed registry root after →
        ∃ payload,
          Yulang.GeneralDictionary169NamedTree.NamedTree registry after focus.val payload ∧
            ∀ (model : Yulang.GeneralNominalCommonBridge.Assignment),
              Yulang.GeneralNominalSaturationState.Models after.current model →
                Yulang.GeneralDictionaryRecursiveEvidence.Evidence registry after.current.context model focus.val
                  payload
