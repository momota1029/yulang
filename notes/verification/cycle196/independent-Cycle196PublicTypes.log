Yulang.GeneralNominalViewExample196.descriptor_changed :
  Yulang.GeneralNominalViewExample196.before.state.nominals 0 = none ∧
    Yulang.GeneralNominalViewExample196.after.state.nominals ⟨0, ⋯⟩ = some Yulang.GeneralNominalExamples.listDescriptor
Yulang.GeneralNominalViewExample196.before_models :
  Yulang.GeneralNominalState.Models Yulang.GeneralNominalViewExample196.before.state Yulang.GeneralNominalExamples.model
Yulang.GeneralNominalViewExample196.after_models :
  Yulang.GeneralNominalState.Models Yulang.GeneralNominalViewExample196.after.state Yulang.GeneralNominalExamples.model
Yulang.GeneralNominalViewExample196.variable_query :
  Yulang.GeneralNominalInspection.queries Yulang.GeneralNominalViewExample196.before.state
      Yulang.GeneralNominalViewExample196.before.interpretation Yulang.GeneralNominalViewExample196.declaration =
    [Yulang.GeneralNominalInspection.Query.variables [0]]
Yulang.GeneralNominalViewExample196.rechecked
  (bounds : List (Yulang.GeneralNominalInspection.Bounds Yulang.GeneralNominalViewExample196.before.state)) :
  Yulang.GeneralNominalViewTransport196.Rechecked Yulang.GeneralNominalViewExample196.before
    Yulang.GeneralNominalViewExample196.next Yulang.GeneralNominalViewExample196.declaration bounds
Yulang.GeneralNominalViewExample196.not_ordinary_extension :
  ¬Yulang.GeneralDictionaryOrdinaryTrace.Extension Yulang.GeneralNominalViewExample196.before
      Yulang.GeneralNominalViewExample196.after
Yulang.GeneralNominalViewExample196.inhabited_change :
  Yulang.GeneralNominalViewExample196.before.state.nominals 0 ≠
      Yulang.GeneralNominalViewExample196.after.state.nominals ⟨0, ⋯⟩ ∧
    Yulang.GeneralNominalState.Models Yulang.GeneralNominalViewExample196.before.state
        Yulang.GeneralNominalExamples.model ∧
      Yulang.GeneralNominalState.Models Yulang.GeneralNominalViewExample196.after.state
          Yulang.GeneralNominalExamples.model ∧
        Yulang.GeneralNominalViewTransport196.Rechecked Yulang.GeneralNominalViewExample196.before
            Yulang.GeneralNominalViewExample196.next Yulang.GeneralNominalViewExample196.declaration [(0, 0), (1, 1)] ∧
          ¬Yulang.GeneralDictionaryOrdinaryTrace.Extension Yulang.GeneralNominalViewExample196.before
              Yulang.GeneralNominalViewExample196.after
