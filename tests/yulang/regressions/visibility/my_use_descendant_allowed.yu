pub mod owner:
  my hidden = 1
  my mod source:
    pub visible = 2
  use hidden as same_named
  use source::*
  pub same = same_named
  pub from_same_glob = visible
  pub mod child:
    use hidden as child_named
    use source::*
    pub named = child_named
    pub globbed = visible
    pub mod grandchild:
      use hidden as grandchild_named
      use source::*
      pub named = grandchild_named
      pub globbed = visible

owner::same
