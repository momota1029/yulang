pub mod owner:
  my struct hidden { raw: int }

  pub make (value: int) = hidden { raw: value }
  pub same (value: hidden): hidden = value
  pub mod child:
    pub value (value: hidden): hidden = value
    pub mod grandchild:
      pub value (value: hidden): hidden = value

(
  owner::same (owner::make 1),
  owner::child::value (owner::make 2),
  owner::child::grandchild::value (owner::make 3),
)
