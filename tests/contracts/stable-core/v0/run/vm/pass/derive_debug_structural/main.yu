struct point { x: int, y: str } derives Debug
struct marker {} derives Debug
struct meters(float) derives Debug
enum choice derives Debug:
    unit
    tuple int str
    named { x: int, y: str }
error failure derives Debug:
    unit
    tuple int str
    named { x: int, y: str }
struct keyed { key: str, ignored: int } derives Debug via key
struct inner { value: str } derives Debug
struct outer { nested: inner } derives Debug

(
    (point { x: 1, y: "two" }).debug,
    marker.debug,
    (meters 1.5).debug,
    choice::unit.debug,
    (choice::tuple 2 "three").debug,
    (choice::named { x: 3, y: "four" }).debug,
    failure::unit.debug,
    (failure::tuple 4 "five").debug,
    (failure::named { x: 5, y: "six" }).debug,
    (keyed { key: "bare", ignored: 9 }).debug,
    (outer { nested: inner { value: "deep" } }).debug
)
