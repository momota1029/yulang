import Yulang.PresenceNormalForm
import Yulang.RowFlowSchemes

/-!
# Row syntax generated by every presence-aware source expression

The invariant concerns row syntax, independently of type consistency. It
allows exact/width records, required fields, arbitrary record tails, whole
strict defaults, and every original source constructor. No `RecordFree`,
solver-success, type-model law, or fuel hypothesis is required.

All explicit row upper bounds are variable/empty rows. Both rows of every
nested arrow have the same shape, so an inspector that only copies arrow
components can use the existing row-flow solver. The theorem about rows
introduced by the future common presence inspector remains a separate bridge.
-/

namespace Yulang.PresenceSourceConstraintSupport

open Core.PresenceGeneration PresenceNormalForm
open Inference (Expr)

def simpleRow : RowTerm α → Bool
  | .var _ | .empty => true
  | .join _ _ => false

/-- No restriction is imposed on record tails, presence constructors, or
unions. Only the two rows stored at every arrow must be variable/empty rows. -/
def simpleTyRows : TyTerm α → Bool
  | .var _ | .base _ | .bottom | .top | .emptyRecord | .exactEmpty => true
  | .union left right | .inter left right | .pair left right |
      .record _ left right | .recordDefault _ left right =>
      simpleTyRows left && simpleTyRows right
  | .variant _ payload | .required _ payload => simpleTyRows payload
  | .arrow input inputRow output outputRow =>
      simpleTyRows input && simpleRow inputRow && simpleTyRows output && simpleRow outputRow

def GoodComp (term : CompTerm α) : Prop := simpleTyRows term.ty = true ∧ simpleRow term.row = true

def GoodFormula : Formula α → Prop
  | .top | .bot => True
  | .and left right | .or left right => GoodFormula left ∧ GoodFormula right
  | .tyLe left right => simpleTyRows left = true ∧ simpleTyRows right = true
  | .rowLe _ right => simpleRow right = true
  | .existsSlot formula => GoodFormula formula

def GoodEnv (schemes : SchemeEnv α) : Prop := ∀ scheme ∈ schemes, GoodFormula scheme

@[simp] theorem simpleRow_rename (rename : α → β) (term : RowTerm α) :
    simpleRow (term.rename rename) = simpleRow term := by cases term <;> rfl

@[simp] theorem simpleTyRows_rename (rename : α → β) (term : TyTerm α) :
    simpleTyRows (term.rename rename) = simpleTyRows term := by
  induction term <;> simp_all [TyTerm.rename, simpleTyRows]

theorem GoodComp.rename {term : CompTerm α} (good : GoodComp term) (rename : α → β) :
    GoodComp (term.rename rename) := by simpa [GoodComp, CompTerm.rename] using good

theorem good_var (index : α) : GoodComp (CompTerm.var index) := ⟨rfl, rfl⟩

theorem simpleRow_subst (subst : α → CompTerm β) (assignment : ∀ index, GoodComp (subst index))
    (term : RowTerm α) (good : simpleRow term = true) : simpleRow (term.subst subst) = true := by
  cases term with
  | var index => exact (assignment index).2
  | empty => rfl
  | join => cases good

theorem simpleTyRows_subst (subst : α → CompTerm β) (assignment : ∀ index, GoodComp (subst index))
    (term : TyTerm α) (good : simpleTyRows term = true) : simpleTyRows (term.subst subst) = true := by
  induction term with
  | var index => exact (assignment index).1
  | base | bottom | top | emptyRecord | exactEmpty => rfl
  | union left right ihl ihr | inter left right ihl ihr | pair left right ihl ihr =>
      have checks := Bool.and_eq_true_iff.mp good
      exact Bool.and_eq_true_iff.mpr ⟨ihl checks.1, ihr checks.2⟩
  | record label left right ihl ihr | recordDefault label left right ihl ihr =>
      have checks := Bool.and_eq_true_iff.mp good
      exact Bool.and_eq_true_iff.mpr ⟨ihl checks.1, ihr checks.2⟩
  | variant label payload ih | required label payload ih => exact ih good
  | arrow input inputRow output outputRow ihi iho =>
      have checks : ((simpleTyRows input = true ∧ simpleRow inputRow = true) ∧ simpleTyRows output = true) ∧
          simpleRow outputRow = true := by simpa only [simpleTyRows, Bool.and_eq_true] using good
      simp only [TyTerm.subst, simpleTyRows, Bool.and_eq_true]
      exact ⟨⟨⟨ihi checks.1.1.1, simpleRow_subst subst assignment inputRow checks.1.1.2⟩,
        iho checks.1.2⟩, simpleRow_subst subst assignment outputRow checks.2⟩

theorem GoodFormula.rename {formula : Formula α} (good : GoodFormula formula) (rename : α → β) :
    GoodFormula (formula.rename rename) := by
  induction formula generalizing β with
  | top | bot => trivial
  | and _ _ ihl ihr | or _ _ ihl ihr => exact ⟨ihl good.1 rename, ihr good.2 rename⟩
  | tyLe left right => simpa [GoodFormula, Formula.rename] using good
  | rowLe left right => simpa [GoodFormula, Formula.rename] using good
  | existsSlot formula ih => exact ih good (Option.map rename)

theorem GoodFormula.subst {formula : Formula α} (good : GoodFormula formula) (subst : α → CompTerm β)
    (assignment : ∀ index, GoodComp (subst index)) : GoodFormula (formula.subst subst) := by
  induction formula generalizing β with
  | top | bot => trivial
  | and _ _ ihl ihr | or _ _ ihl ihr =>
      exact ⟨ihl good.1 subst assignment, ihr good.2 subst assignment⟩
  | tyLe left right => exact ⟨simpleTyRows_subst subst assignment left good.1, simpleTyRows_subst subst assignment right good.2⟩
  | rowLe left right => exact simpleRow_subst subst assignment right good
  | existsSlot formula ih =>
      apply ih good (liftSubst subst)
      intro index
      cases index with
      | none => exact good_var _
      | some index => exact (assignment index).rename some

theorem GoodEnv.rename {schemes : SchemeEnv α} (good : GoodEnv schemes) (rename : α → β) :
    GoodEnv (schemes.rename rename) := by
  intro scheme member
  obtain ⟨original, present, rfl⟩ := List.mem_map.mp member
  exact (good original present).rename (Option.map rename)

theorem GoodEnv.lift {schemes : SchemeEnv α} (good : GoodEnv schemes) : GoodEnv schemes.lift :=
  good.rename some

theorem GoodEnv.cons {schemes : SchemeEnv α} (good : GoodEnv schemes) {scheme : Scheme α}
    (head : GoodFormula scheme) : GoodEnv (scheme :: schemes) := by
  intro actual member
  rcases List.mem_cons.mp member with rfl | member
  · exact head
  · exact good actual member

theorem good_compLe {source target : CompTerm α}
    (left : simpleTyRows source.ty = true) (right : GoodComp target) : GoodFormula (Formula.compLe source target) :=
  ⟨⟨left, right.1⟩, right.2⟩

theorem good_mono {term : CompTerm α} (good : GoodComp term) : GoodFormula (Scheme.mono term) :=
  good_compLe (good.rename some).1 (good_var none)

theorem GoodFormula.instantiate {scheme : Scheme α} (good : GoodFormula scheme)
    (output : CompTerm α) (accepted : GoodComp output) : GoodFormula (scheme.instantiate output) := by
  apply good.subst
  intro index
  cases index with
  | none => exact accepted
  | some index => exact good_var _

theorem good_lookup {schemes : SchemeEnv α} (good : GoodEnv schemes) (index : Nat)
    (output : CompTerm α) (accepted : GoodComp output) : GoodFormula (Scheme.lookup schemes index output) := by
  unfold Scheme.lookup
  cases found : schemes[index]? with
  | none => trivial
  | some scheme => exact (good scheme (List.mem_of_getElem? found)).instantiate output accepted

/-- Every source constructor preserves the row-shape invariant. Record
construction and strict default insertion need no special source assumption;
both operands and their effect joins are retained. Captured environments and
both value-let alternatives are covered. -/
theorem good_generate (expression : Expr)
    (schemes : SchemeEnv α) (environment : GoodEnv schemes)
    (output : CompTerm α) (accepted : GoodComp output) : GoodFormula (generate schemes expression output) := by
  induction expression generalizing α with
  | var index => exact good_lookup environment index output accepted
  | lit scalar => exact good_compLe rfl accepted
  | lam body ih =>
      exact ⟨ih _ (environment.lift.lift.cons (good_mono (good_var _))) _ (good_var _),
        good_compLe rfl (accepted.rename _)⟩
  | app function argument ihf iha =>
      exact ⟨ihf _ environment.lift.lift.lift _ ⟨rfl, rfl⟩,
        iha _ environment.lift.lift.lift _ (good_var _), good_compLe rfl (accepted.rename _)⟩
  | letE definition body ihd ihb =>
      have generalized : GoodFormula (.and
          (generate schemes.lift definition (CompTerm.pure (.var none))) (.rowLe .empty (.var none))) :=
        ⟨ihd _ environment.lift _ ⟨rfl, rfl⟩, rfl⟩
      have monomorphic : GoodFormula (.existsSlot (.existsSlot (
          .and (generate (env₂ schemes) definition fresh₀)
            (.and (generate (Scheme.mono (CompTerm.pure fresh₀.ty) :: env₂ schemes) body fresh₁)
              (Formula.compLe ⟨fresh₁.ty, .join fresh₀.row fresh₁.row⟩ (lift₂ output)))))) :=
        ⟨ihd _ environment.lift.lift _ (good_var _),
          ihb _ (environment.lift.lift.cons (good_mono ⟨rfl, rfl⟩)) _ (good_var _),
          good_compLe rfl (accepted.rename _)⟩
      simp only [generate]
      split
      · exact ⟨⟨ihd _ environment.lift _ ⟨rfl, rfl⟩,
          ihb _ (environment.cons generalized) output accepted⟩,
          monomorphic⟩
      · exact monomorphic
  | branch condition yes no ihc ihy ihn =>
      exact ⟨ihc _ environment.lift.lift.lift _ ⟨rfl, rfl⟩,
        ihy _ environment.lift.lift.lift _ (good_var _),
        ihn _ environment.lift.lift.lift _ (good_var _), good_compLe rfl (accepted.rename _)⟩
  | pair left right ihl ihr =>
      exact ⟨ihl _ environment.lift.lift _ (good_var _),
        ihr _ environment.lift.lift _ (good_var _), good_compLe rfl (accepted.rename _)⟩
  | fst pair ih | snd pair ih =>
      exact ⟨ih _ environment.lift.lift _ ⟨rfl, rfl⟩, good_compLe rfl (accepted.rename _)⟩
  | emptyRecord => exact good_compLe rfl accepted
  | record label head rest ihh ihr | recordDefault label head rest ihh ihr =>
      exact ⟨ihh _ environment.lift.lift _ (good_var _),
        ihr _ environment.lift.lift _ (good_var _), ⟨rfl, rfl⟩,
        good_compLe rfl (accepted.rename _)⟩
  | field label record ih =>
      exact ⟨ih _ environment.lift _ ⟨rfl, rfl⟩, good_compLe rfl (accepted.rename _)⟩
  | variant label payload ih =>
      exact ⟨ih _ environment.lift _ (good_var _), good_compLe rfl (accepted.rename _)⟩

theorem good_principal (expression : Expr)
    (schemes : SchemeEnv α) (environment : GoodEnv schemes) : GoodFormula (principal schemes expression) :=
  good_generate expression schemes.lift environment.lift _ (good_var none)

def GoodAtom : Atom α → Prop
  | .tyLe left right => simpleTyRows left = true ∧ simpleTyRows right = true
  | .rowLe _ right => simpleRow right = true

def GoodAtoms (atoms : List (Atom α)) : Prop := ∀ atom ∈ atoms, GoodAtom atom

def GoodClause (clause : Clause α) : Prop := GoodAtoms clause.atoms

theorem GoodAtom.rename {atom : Atom α} (good : GoodAtom atom) (rename : α → β) :
    GoodAtom (atom.rename rename) := by cases atom <;> simpa [GoodAtom, Atom.rename] using good

theorem GoodAtoms.rename {atoms : List (Atom α)} (good : GoodAtoms atoms) (rename : α → β) :
    GoodAtoms (atoms.map (Atom.rename rename)) := by
  intro atom member
  obtain ⟨original, present, rfl⟩ := List.mem_map.mp member
  exact (good original present).rename rename

theorem GoodAtoms.append {left right : List (Atom α)} (first : GoodAtoms left) (last : GoodAtoms right) :
    GoodAtoms (left ++ right) := by
  intro atom member
  exact (List.mem_append.mp member).elim (first atom) (last atom)

theorem good_empty : GoodClause (Clause.empty : Clause α) := by intro atom impossible; cases impossible

theorem good_singleton {atom : Atom α} (good : GoodAtom atom) : GoodClause (Clause.singleton atom) := by
  intro actual member
  have same := List.mem_singleton.mp member
  subst actual
  exact good.rename Sum.inr

theorem GoodClause.combine {left right : Clause α} (first : GoodClause left) (last : GoodClause right) :
    GoodClause (left.combine right) :=
  (first.rename (leftName left.locals right.locals)).append (last.rename (rightName left.locals right.locals))

theorem GoodClause.close {clause : Clause (Option α)} (good : GoodClause clause) : GoodClause clause.close :=
  good.rename (closeName clause.locals)

theorem good_normalise {formula : Formula α} (good : GoodFormula formula) :
    ∀ clause ∈ normalise formula, GoodClause clause := by
  induction formula with
  | top =>
      intro clause member
      have same := List.mem_singleton.mp member
      subst clause
      exact good_empty
  | bot => intro clause impossible; cases impossible
  | tyLe | rowLe =>
      intro clause member
      have same := List.mem_singleton.mp member
      subst clause
      exact good_singleton good
  | and left right ihl ihr =>
      intro clause member
      obtain ⟨first, present, member⟩ := List.mem_flatMap.mp member
      obtain ⟨last, inLast, rfl⟩ := List.mem_map.mp member
      exact (ihl good.1 first present).combine (ihr good.2 last inLast)
  | or left right ihl ihr =>
      intro clause member
      exact (List.mem_append.mp member).elim (ihl good.1 clause) (ihr good.2 clause)
  | existsSlot formula ih =>
      intro clause member
      obtain ⟨original, present, rfl⟩ := List.mem_map.mp member
      exact (ih good original present).close

theorem good_pack {clause : Clause (Option Empty)} (good : GoodClause clause) : GoodAtoms clause.pack :=
  good.rename (resultName clause.locals)

/-- All clauses generated from every closed source expression retain only
simple explicit row upper bounds and simple rows inside arrow constructors. -/
theorem generated_row_shapes (expression : Expr)
    (clause : Clause (Option Empty))
    (member : clause ∈ normalise (principal ([] : SchemeEnv Empty) expression)) :
    GoodAtoms clause.pack :=
  good_pack (good_normalise (good_principal expression []
    (by intro _ impossible; cases impossible)) clause member)

/-- The presence and original row-term grammars are structurally identical;
this conversion changes neither the variable identities nor the joins. -/
def originalRow : RowTerm α → Inference.RowTerm α
  | .var index => .var index
  | .empty => .empty
  | .join left right => .join (originalRow left) (originalRow right)

@[simp] theorem originalRow_eval (model : Model) (assignment : α → Comp model)
    (term : RowTerm α) :
    (originalRow term).eval model.toModel assignment = term.eval model assignment := by
  induction term <;> simp_all [originalRow, Inference.RowTerm.eval, RowTerm.eval]

/-- Project only explicit row atoms. Value-constraint inspectors may later
add arrow-component comparisons; those are not silently counted here. -/
def explicitRows : List (Atom (Fin n)) → RowFlowSchemes.Problem n
  | [] => []
  | .tyLe _ _ :: rest => explicitRows rest
  | .rowLe left right :: rest => (originalRow left, originalRow right) :: explicitRows rest

@[simp] theorem originalRow_supported (left right : RowTerm (Fin n)) :
    RowFlowSchemes.supportedConstraint (originalRow left, originalRow right) = simpleRow right := by
  cases right <;> rfl

theorem explicit_rows_supported (atoms : List (Atom (Fin n))) (good : GoodAtoms atoms) :
    RowFlowSchemes.supported (explicitRows atoms) = true := by
  induction atoms with
  | nil => rfl
  | cons atom rest ih =>
      have first := good atom List.mem_cons_self
      have last := ih (fun actual member => good actual (List.mem_cons_of_mem _ member))
      cases atom with
      | tyLe => exact last
      | rowLe left right =>
          simpa only [explicitRows, RowFlowSchemes.supported, List.all_cons,
            originalRow_supported, Bool.and_eq_true, GoodAtom] using And.intro first last

/-- Every closed presence source, including record construction and strict
recordDefault, generates explicit row atoms accepted by the actual row-flow
solver. This does not claim support of the not-yet-connected type inspector. -/
theorem generated_explicit_rows_supported (expression : Expr)
    (clause : Clause (Option Empty))
    (member : clause ∈ normalise (principal ([] : SchemeEnv Empty) expression)) :
    RowFlowSchemes.supported (explicitRows clause.pack) = true :=
  explicit_rows_supported clause.pack (generated_row_shapes expression clause member)

/-- The concrete shared-parameter row scheme for the explicit atoms of a
packed source clause. No row parameter is defaulted after solving. -/
def explicitScheme (clause : Clause (Option Empty)) : RowFlowSchemes.Scheme (clause.locals + 1) :=
  RowFlowSchemes.coalesce (RowFlowSchemes.flatten (explicitRows clause.pack))

theorem generated_explicit_rows_solved (expression : Expr)
    (clause : Clause (Option Empty))
    (member : clause ∈ normalise (principal ([] : SchemeEnv Empty) expression)) :
    RowFlowSchemes.solve (explicitRows clause.pack) = .solved (explicitScheme clause) := by
  simp only [RowFlowSchemes.solve, generated_explicit_rows_supported expression clause member,
    ↓reduceIte, explicitScheme]

/-- Every unconstrained choice of the scheme's row parameters satisfies all
explicit row atoms. Arrow-component rows added by a type inspector are separate. -/
theorem generated_explicit_rows_instantiates (algebra : RowFlowSchemes.Algebra Row)
    (expression : Expr) (clause : Clause (Option Empty))
    (member : clause ∈ normalise (principal ([] : SchemeEnv Empty) expression))
    (parameters : Fin (clause.locals + 1) → Row) :
    RowFlowSchemes.Models algebra (explicitRows clause.pack)
      (RowFlowSchemes.instantiate algebra (explicitScheme clause) parameters) :=
  RowFlowSchemes.solve_instantiates_model algebra (explicitRows clause.pack) (explicitScheme clause)
    (generated_explicit_rows_solved expression clause member) parameters

/-- All original explicit-row solutions are recovered up to mutual inclusion,
without a solved-result hypothesis or residual constraints on the parameters. -/
theorem generated_explicit_rows_models_exact (algebra : RowFlowSchemes.Algebra Row)
    (expression : Expr) (clause : Clause (Option Empty))
    (member : clause ∈ normalise (principal ([] : SchemeEnv Empty) expression))
    (valuation : Fin (clause.locals + 1) → Row) :
    RowFlowSchemes.Models algebra (explicitRows clause.pack) valuation ↔
      ∃ parameters : Fin (clause.locals + 1) → Row,
        RowFlowSchemes.PointwiseEquivalent algebra
          (RowFlowSchemes.instantiate algebra (explicitScheme clause) parameters) valuation :=
  RowFlowSchemes.solve_models_exact algebra (explicitRows clause.pack) (explicitScheme clause)
    (generated_explicit_rows_solved expression clause member) valuation

end Yulang.PresenceSourceConstraintSupport
