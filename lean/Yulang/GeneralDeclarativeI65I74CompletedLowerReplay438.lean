/-- Only requests, addresses and finite raw-graph data. No selection,
typed plan, expected payload or dictionary is in the proposed wire. -/
structure Wire438 where
  producer : Request
  seedOrigin : Nat
  seedRetainedRow : Nat
  seedEscape : ExactEscapeWire
  upperOrigin : Nat
  centerOrigin : Nat
  consumeEscape : ExactEscapeWire

/-- The producer's one result is read from its original declaration,
where-free capture frame and B6 occurrence index. The proof is
generated by the reader, not passed in the wire. -/
structure SeedReplay438 (s : I72.State) (producer : Request) (outputRow : Nat) where
  row : Declaration
  basis : SeedBasis s producer row
  outputs : SeedOutputs basis
  read : OneOutput outputs
  exactRow : read.kept.payload.rowOrdinal = outputRow

private theorem index_is_sole438 {q : Request} (sole : q.demand.outputs.length = 1)
    (first : Fin q.demand.outputs.length) (atZero : first.val = 0)
    (j : Fin q.demand.outputs.length) : j = first := by
  have size : j.val < 1 := Nat.lt_of_lt_of_le j.isLt (Nat.le_of_eq sole)
  apply Fin.eq_of_val_eq
  omega

def replaySeed438 (s : I72.State) (w : Wire438) :
    Option (SeedReplay438 s w.producer w.seedRetainedRow) := do
  let leaf ← readSingleton438 s w.producer
  let source ← readSeedBasis438 leaf w.seedOrigin w.seedEscape
  let basis := source.basis
  if sole : w.producer.demand.outputs.length = 1 then
    let original : Fin w.producer.demand.outputs.length := ⟨0,by rw [sole]; decide⟩
    let checked := leaf.checked.2 basis.frame.decl (List.mem_of_getElem? basis.frame.authored)
    let result ← readOriginalOutput432 s basis.frame checked original w.seedRetainedRow
    let outputs : SeedOutputs basis :=
      fun j => (index_is_sole438 sole original rfl j).symm ▸ result.output
    match reread : readRow (outputs original) w.seedRetainedRow with
    | none => none
    | some kept =>
      let read : OneOutput outputs :=
        ⟨original,index_is_sole438 sole original rfl,kept⟩
      return ⟨leaf.row,basis,outputs,read,checked_row_has_exact_ordinal437 reread⟩
  else none

def SeedReplay438.need {s q row} (prior : SeedReplay438 s q row) : OutputNeed s :=
  exactNeed prior.basis prior.outputs prior.read.i

def SeedReplay438.forest {s q row} (prior : SeedReplay438 s q row) :
    SupportForest PriorSource406 s [prior.need] :=
  prior.read.support

structure Replay438 (s : I72.State) (q : Request) (w : Wire438) where
  selected : Selected18 s q
  noWhere : selected.invocation.row.requirements = []
  noOutputs : q.demand.outputs = []
  producer : selected.invocation.chosen.need.producer = w.producer
  keptAt : selected.head.retained.rowOrdinal = w.seedRetainedRow
  actualUpper : s.core.origins[w.upperOrigin]? = some selected.invocation.chosen.gate.upper
  actualCenter : s.core.origins[w.centerOrigin]? = some selected.invocation.actualPayload.source
  centerIssuer : selected.invocation.actualPayload.source.issuer = q.occurrence

/-- Raw safety is checked on the unfiltered graph before following the
lower output. Election uses the independently authored upper origin
and the actual closed producer. The original consumer center is read
only after this election. -/
def replay438 (s : I72.State) (q : Request) (w : Wire438) : Option (Replay438 s q w) := do
  let leaf ← readSingleton438 s q
  if rawSafe : checkExactEscape s.core.current.ordinary leaf.arg.lower w.consumeEscape = true then
    if different : w.producer.occurrence ≠ q.occurrence then
      if noWhere : leaf.row.requirements = [] then
        if noOutputs : q.demand.outputs = [] then
          let prior ← replaySeed438 s w
          let gate ← readGate438 leaf prior.need w.upperOrigin
          let choice : PreselectedUnary406 s q leaf.row prior.forest :=
            ⟨prior.need,0,rfl,gate.gate,leaf.rootSafe w.consumeEscape rawSafe,
              leaf.bookIndex,leaf.ordinal,leaf.book⟩
          let center ← readCenterAt choice w.centerOrigin
          let invocation := buildEmptyInvocation choice center noWhere noOutputs
          have target : (choice.producer.event.outputs choice.need.ordinal).receipt.original.target =
              choice.gate.arg.lower := gate.gate.lowerTarget
          let retained : CompletedLower437.Payload invocation.chosen.gate.arg.lower
              (invocation.chosen.producer.event.outputs invocation.chosen.need.ordinal).receipt :=
            ⟨target,prior.read.kept.payload.code,w.seedRetainedRow,
              (congrArg (fun idx => s.core.current.ordinary.equations[idx]?) prior.exactRow).symm.trans
                (prior.read.kept.payload.row.trans (congrArg
                  (fun n => some (GeneralDeclarativeHead320.Equation.mk n prior.read.kept.payload.code)) target))⟩
          let head : CompletedHead18 invocation := ⟨different,retained,prior.read.kept.code⟩
          return ⟨⟨invocation,head⟩,noWhere,noOutputs,rfl,rfl,gate.exactUpper,center.found,center.issuer⟩
        else none
      else none
    else none
  else none

theorem replay_completed_preserves_raw_safety438 {s q w} (a : Replay438 s q w) :
    ¬RootCycle s q :=
  a.selected.invocation.chosen.rootSafe

theorem replay_completed_keeps_exact_original_addresses438 {s q w} (a : Replay438 s q w) :
    a.selected.invocation.chosen.need.producer = w.producer ∧
    a.selected.head.retained.rowOrdinal = w.seedRetainedRow ∧
    s.core.origins[w.upperOrigin]? = some a.selected.invocation.chosen.gate.upper ∧
    s.core.origins[w.centerOrigin]? = some a.selected.invocation.actualPayload.source ∧
    a.selected.invocation.actualPayload.source.issuer = q.occurrence :=
  ⟨a.producer,a.keptAt,a.actualUpper,a.actualCenter,a.centerIssuer⟩

end Yulang.GeneralDeclarativeI65.I72.CompletedEntry438
