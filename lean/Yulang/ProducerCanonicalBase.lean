import Yulang.ProducerContextual

/-!
# Complete canonical codes for finite base/lattice producers

This module starts from the independent contextual demand interpretation.
For the fragment generated by the four base types, `never`, `any`, union and
intersection, all sixteen base-role profiles suffice to distinguish types.
The resulting Boolean table is an executable complete encoding, not a
definition of producer equivalence.

This is a fragment theorem. It does not canonicalize arrows, records,
nominal identities, role obligations or regular graphs, and does not replace
the sound constructor-grouping pass with an unproved full-interface claim.
-/

namespace Yulang.ProducerCanonicalBase

open Inference (Base)
open ProducerContextual

universe u

inductive Expr where
  | base : Base → Expr
  | bottom : Expr
  | top : Expr
  | union : Expr → Expr → Expr
  | inter : Expr → Expr → Expr
  deriving DecidableEq, Repr

def Expr.embed (Row : Type u) : Expr → StructuralBase.Ty Row
  | .base scalar => .base scalar
  | .bottom => .bottom
  | .top => .top
  | .union first last => .union (first.embed Row) (last.embed Row)
  | .inter first last => .inter (first.embed Row) (last.embed Row)

/-- Membership of the four primitive heads in one role profile. -/
structure Profile where
  bool : Bool
  int : Bool
  str : Bool
  unit : Bool
  deriving DecidableEq, Repr

def Profile.accepts (profile : Profile) : Base → Bool
  | .bool => profile.bool
  | .int => profile.int
  | .str => profile.str
  | .unit => profile.unit

def Profile.ofAssignment (assignment : Base → Bool) : Profile :=
  ⟨assignment .bool, assignment .int, assignment .str, assignment .unit⟩

@[simp] theorem Profile.accepts_ofAssignment (assignment : Base → Bool) (scalar : Base) :
    (Profile.ofAssignment assignment).accepts scalar = assignment scalar := by
  cases scalar <;> rfl

def baseName : Base → String
  | .bool => "bool"
  | .int => "int"
  | .str => "str"
  | .unit => "unit"

/-- The lexical order is part of the encoding, not the enum declaration order. -/
def baseOrder : List Base := [.bool, .int, .str, .unit]

@[simp] theorem mem_baseOrder (scalar : Base) : scalar ∈ baseOrder := by
  cases scalar <;> simp [baseOrder]

def Profile.members (profile : Profile) : List Base :=
  baseOrder.filter profile.accepts

@[simp] theorem Profile.mem_members (profile : Profile) (scalar : Base) :
    scalar ∈ profile.members ↔ profile.accepts scalar = true := by
  simp [Profile.members]

/-- Increasing lexical order of the member lists, including the empty list. -/
def profiles : List Profile :=
  [⟨false, false, false, false⟩,
   ⟨true, false, false, false⟩,
   ⟨true, true, false, false⟩,
   ⟨true, true, true, false⟩,
   ⟨true, true, true, true⟩,
   ⟨true, true, false, true⟩,
   ⟨true, false, true, false⟩,
   ⟨true, false, true, true⟩,
   ⟨true, false, false, true⟩,
   ⟨false, true, false, false⟩,
   ⟨false, true, true, false⟩,
   ⟨false, true, true, true⟩,
   ⟨false, true, false, true⟩,
   ⟨false, false, true, false⟩,
   ⟨false, false, true, true⟩,
   ⟨false, false, false, true⟩]

theorem mem_profiles (profile : Profile) : profile ∈ profiles := by
  obtain ⟨b, i, s, u⟩ := profile
  cases b <;> cases i <;> cases s <;> cases u <;> decide

theorem profiles_nodup : profiles.Nodup := by decide

theorem members_lexical (profile : Profile) :
    profile.members.Pairwise (fun a b => baseName a < baseName b) := by
  obtain ⟨b, i, s, u⟩ := profile
  cases b <;> cases i <;> cases s <;> cases u <;> decide

/-- Union requires both producers to pass a demand; intersection permits one. -/
def Expr.eval (profile : Profile) : Expr → Bool
  | .base scalar => profile.accepts scalar
  | .bottom => true
  | .top => false
  | .union first last => first.eval profile && last.eval profile
  | .inter first last => first.eval profile || last.eval profile

def roleEnvironment (Row : Type u) (profile : Profile) : Environment Row :=
  ⟨fun _ => .bottom, fun _ => profile.members.map Head.base⟩

theorem eval_role_exact (Row : Type u) (leRow : Row → Row → Prop)
    (rank : Nat) (profile : Profile) (expression : Expr) :
    ProbeAt leRow rank (roleEnvironment Row profile) (expression.embed Row) (.role 0) ↔
      expression.eval profile = true := by
  induction expression with
  | base scalar =>
      cases rank <;>
        simp [ProbeAt, ProbeStep, Expr.embed, Expr.eval, roleEnvironment]
  | bottom => simp [Expr.embed, Expr.eval]
  | top => cases rank <;> simp [ProbeAt, ProbeStep, Expr.embed, Expr.eval]
  | union first last ihf ihl => simp [Expr.embed, Expr.eval, ihf, ihl]
  | inter first last ihf ihl => simp [Expr.embed, Expr.eval, ihf, ihl]

/-- One primitive producer's response to a nontrivial observation is finite. -/
def baseResponse (env : Environment Row) (observation : Observation Row) (scalar : Base) : Bool :=
  match observation with
  | .base expected => decide (scalar = expected)
  | .role name => decide (Head.base scalar ∈ env.roles name)
  | _ => false

theorem eval_observation_exact (leRow : Row → Row → Prop)
    (rank : Nat) (env : Environment Row) (observation : Observation Row)
    (nontrivial : observation ≠ .trivial) (expression : Expr) :
    ProbeAt leRow rank env (expression.embed Row) observation ↔
      expression.eval (Profile.ofAssignment (baseResponse env observation)) = true := by
  induction expression with
  | base scalar =>
      cases rank <;> cases observation <;>
        simp_all [ProbeAt, ProbeStep, Expr.embed, Expr.eval, baseResponse]
  | bottom => simp [Expr.embed, Expr.eval]
  | top =>
      cases rank <;> cases observation <;> simp_all [ProbeAt, ProbeStep, Expr.embed, Expr.eval]
  | union first last ihf ihl => simp [Expr.embed, Expr.eval, ihf, ihl]
  | inter first last ihf ihl => simp [Expr.embed, Expr.eval, ihf, ihl]

/-- Equality of the sixteen finite evaluations characterizes the existing
contextual equivalence, for arbitrary rows and without row-law assumptions. -/
theorem equivalent_iff_evaluations (leRow : Row → Row → Prop) (first last : Expr) :
    ProducerEq leRow (first.embed Row) (last.embed Row) ↔
      ∀ profile, first.eval profile = last.eval profile := by
  constructor
  · intro same profile
    apply Bool.eq_iff_iff.mpr
    have observed := (producerEq_iff_probe _ _).mp same 0 (roleEnvironment Row profile) (.role 0)
    simpa only [eval_role_exact] using observed
  · intro same
    apply (producerEq_iff_probe _ _).mpr
    intro rank env observation
    by_cases trivial : observation = .trivial
    · subst observation
      simp
    · rw [eval_observation_exact leRow rank env observation trivial,
        eval_observation_exact leRow rank env observation trivial, same]

/-- A fixed sixteen-bit executable code. It contains no semantic proposition. -/
def truthTable (expression : Expr) : List Bool :=
  profiles.map expression.eval

private theorem map_same_iff {α β : Type} (list : List α) (first last : α → β) :
    list.map first = list.map last ↔ ∀ a ∈ list, first a = last a := by
  induction list with
  | nil => simp
  | cons head rest ih => simp [ih]

theorem truthTable_eq_iff (first last : Expr) :
    truthTable first = truthTable last ↔ ∀ profile, first.eval profile = last.eval profile := by
  rw [truthTable, truthTable, map_same_iff]
  exact ⟨fun same profile => same profile (mem_profiles profile), fun same profile _ => same profile⟩

theorem truthTable_exact (leRow : Row → Row → Prop) (first last : Expr) :
    ProducerEq leRow (first.embed Row) (last.embed Row) ↔
      truthTable first = truthTable last := by
  rw [equivalent_iff_evaluations, truthTable_eq_iff]

end Yulang.ProducerCanonicalBase
