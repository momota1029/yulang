import Yulang.GeneralDictionaryReadback

/-!
# Structural sibling equivalence of the actual key-only dictionary payload

This is the least equivalence congruence generated by sibling permutations.
It retains every implementation key, subtree and multiplicity. It does not
recover erased source identities. Evidence transports only under a proved
permutation-invariance condition on the independent local source relation.
This condition is distinct from exact ordered-child determinism in readback.
-/
namespace Yulang.GeneralDictionaryPayloadOrder
open GeneralSourceDictionaries GeneralDictionaryReadback
open CommonRoleOutermostResolver (All₂)

inductive Equivalent : Payload → Payload → Prop where
  | refl (tree) : Equivalent tree tree
  | reorder (key) {before after} (permuted : before.Perm after) :
      Equivalent (.node key before) (.node key after)
  | replace (key) (leading trailing) {before after} (same : Equivalent before after) :
      Equivalent (.node key (leading ++ before :: trailing))
        (.node key (leading ++ after :: trailing))
  | symm {before after} : Equivalent before after → Equivalent after before
  | trans {first middle last} : Equivalent first middle → Equivalent middle last → Equivalent first last

theorem equivalent_refl (tree : Payload) : Equivalent tree tree := .refl tree

theorem equivalent_symm (same : Equivalent first last) : Equivalent last first := .symm same

theorem equivalent_trans (first : Equivalent a b) (last : Equivalent b c) : Equivalent a c :=
  .trans first last

def rootKey : Payload → Nat
  | .node key _ => key

theorem equivalent_rootKey (same : Equivalent first last) : rootKey first = rootKey last := by
  induction same with
  | refl => rfl
  | reorder => rfl
  | replace => rfl
  | symm _ ih => exact ih.symm
  | trans _ _ first last => exact first.trans last

theorem eraseChildren_map (children : List (Dictionary roles)) :
    eraseChildren children = children.map erase := by
  induction children with
  | nil => rfl
  | cons first rest ih => simp only [eraseChildren, List.map_cons, ih]

/-- Every source-preserving sibling rearrangement is a payload rearrangement.
The reverse implication is intentionally false without source evidence. -/
theorem erase_equivalent (same : DictionaryEquivalent first last) :
    Equivalent (erase first) (erase last) := by
  induction same with
  | refl => exact .refl _
  | reorder occurrence key permuted =>
      change Equivalent (.node key _) (.node key _)
      apply Equivalent.reorder
      rw [eraseChildren_map, eraseChildren_map]
      exact permuted.map erase
  | replace occurrence key leading trailing same ih =>
      simp only [erase, eraseChildren_map, List.map_append, List.map_cons]
      exact .replace key (leading.map erase) (trailing.map erase) ih
  | symm _ ih => exact .symm ih
  | trans _ _ first last => exact .trans first last

/-- Simultaneous reordering of related lists preserves every corresponding pair. -/
theorem all₂_perm_right (relation : α → β → Prop) {left : List α} {right after : List β}
    (given : All₂ relation left right) (permuted : right.Perm after) :
    ∃ reordered, left.Perm reordered ∧ All₂ relation reordered after := by
  induction permuted generalizing left with
  | nil => cases given; exact ⟨[], .refl _, .nil⟩
  | cons head permuted ih =>
      cases given with
      | @cons first _ before _ pair rest =>
          obtain ⟨tail, order, related⟩ := ih rest
          exact ⟨first :: tail, .cons first order, .cons pair related⟩
  | swap first last tail =>
      cases given with
      | @cons a _ _ _ pairA rest =>
          cases rest with
          | @cons b _ before _ pairB rest =>
              exact ⟨b :: a :: before, .swap _ _ _, .cons pairB (.cons pairA rest)⟩
  | trans first last firstIH lastIH =>
      obtain ⟨middle, firstOrder, middleRelated⟩ := firstIH given
      obtain ⟨after, lastOrder, afterRelated⟩ := lastIH middleRelated
      exact ⟨after, firstOrder.trans lastOrder, afterRelated⟩

theorem all₂_replace_right (relation : α → β → Prop) (leading trailing : List β)
    (left : List α) (before after : β)
    (replace : ∀ a, relation a before → relation a after)
    (given : All₂ relation left (leading ++ before :: trailing)) :
    All₂ relation left (leading ++ after :: trailing) := by
  induction leading generalizing left with
  | nil =>
      cases given with
      | cons first rest => exact .cons (replace _ first) rest
  | cons head tail ih =>
      cases given with
      | cons first rest => exact .cons first (ih _ rest)

/-- Reordering payload children simultaneously reorders their source obligations.
This uses the local semantic conjunction law, never guesses identities from keys. -/
theorem evidence_reorder (localRule : LocalInstance roles)
    (invariant : PermutationInvariant localRule) (occurrence : Occurrence roles)
    (key : Nat) (before after : List Payload) (permuted : before.Perm after)
    (given : PayloadEvidence localRule occurrence (.node key before)) :
    PayloadEvidence localRule occurrence (.node key after) := by
  cases given with
  | node instanceRule allChildren =>
      obtain ⟨children, order, related⟩ := all₂_perm_right _ allChildren permuted
      exact .node ((invariant _ _ _ _ order).mp instanceRule) related

theorem evidence_replace (localRule : LocalInstance roles) (occurrence : Occurrence roles)
    (key : Nat) (leading trailing : List Payload) (before after : Payload)
    (replace : ∀ child, PayloadEvidence localRule child before → PayloadEvidence localRule child after)
    (given : PayloadEvidence localRule occurrence (.node key (leading ++ before :: trailing))) :
    PayloadEvidence localRule occurrence (.node key (leading ++ after :: trailing)) := by
  cases given with
  | node instanceRule allChildren =>
      exact .node instanceRule (all₂_replace_right _ leading trailing _ before after replace allChildren)

/-- Conditional evidence invariance for all finite payload trees and every source
root. Ordered deterministic emitters must establish an appropriate unordered
semantic view before this theorem applies. -/
theorem equivalent_evidence (localRule : LocalInstance roles)
    (invariant : PermutationInvariant localRule) (same : Equivalent before after) :
    ∀ occurrence, PayloadEvidence localRule occurrence before ↔ PayloadEvidence localRule occurrence after := by
  induction same with
  | refl => intro _; exact Iff.rfl
  | reorder key permuted =>
      intro occurrence
      exact ⟨evidence_reorder localRule invariant occurrence key _ _ permuted,
        evidence_reorder localRule invariant occurrence key _ _ permuted.symm⟩
  | replace key leading trailing same ih =>
      intro occurrence
      exact ⟨evidence_replace localRule occurrence key leading trailing _ _ (fun child => (ih child).mp),
        evidence_replace localRule occurrence key leading trailing _ _ (fun child => (ih child).mpr)⟩
  | symm _ ih => intro occurrence; exact (ih occurrence).symm
  | trans _ _ first last => intro occurrence; exact (first occurrence).trans (last occurrence)

theorem equivalent_erased_evidence (localRule : LocalInstance roles)
    (invariant : PermutationInvariant localRule) (same : Equivalent before after)
    (occurrence : Occurrence roles) :
    ErasedEvidence localRule occurrence before ↔ ErasedEvidence localRule occurrence after := by
  rw [← payload_iff_erased, ← payload_iff_erased]
  exact equivalent_evidence localRule invariant same occurrence

/-- Payload equivalence cannot establish provenance equality, even with identical
demands and leaf keys. The source identity was actually erased. -/
theorem erase_does_not_reflect (demand : GeneralSourceState.Demand roles) (first last key : Nat)
    (distinct : first ≠ last) :
    let a : Dictionary roles := .node ⟨first, demand⟩ key []
    let b : Dictionary roles := .node ⟨last, demand⟩ key []
    Equivalent (erase a) (erase b) ∧ ¬ DictionaryEquivalent a b := by
  dsimp
  exact ⟨.refl _, (erase_forgets_occurrence demand first last key distinct).2⟩

end Yulang.GeneralDictionaryPayloadOrder
