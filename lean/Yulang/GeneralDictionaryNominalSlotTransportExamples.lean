import Yulang.GeneralDictionaryNominalSlotTransport
import Yulang.GeneralDictionaryTypeCoverageExamples

/-! A concrete strict slot enlargement, certified from stored syntax. The old
row coordinate remains 42, independently of type coordinate 10. Reserved type
77 gains a slot without changing the global model set or persistent identity
metadata. The target snapshot is supplied, not generated by an allocator. -/
namespace Yulang.GeneralDictionaryNominalSlotTransportExamples
open GeneralDictionaryTypeCoverageExamples (before beforeBase afterBase demand afterInputs)
open GeneralDictionaryNominalSlotTransport
open GeneralNominalCommonBridge (Assignment)

private def afterView : GeneralNormalizedObservation.Snapshot afterBase where
  kinds := 0
  shapes := Fin.elim0
  shapes_injective := by intro first; exact Fin.elim0 first
  canonical := by intro kind; exact Fin.elim0 kind
  heads := fun _ => .deferred .unresolved
  checked := by intro _ _ impossible; cases impossible

abbrev after : GeneralNominalState.State :=
  { GeneralNominalState.embed afterBase afterView before.constructors with
    seed := before.seed
    allocated := before.allocated
    reserved := before.reserved
    ordinary := before.ordinary }

/-- The new source snapshot retains both old coordinates separately. -/
def transport : Transport before after where
  embed := fun _ => 0
  source := by intro _; rfl
  rowSource := by intro _; rfl
  atoms := rfl
  heads := by
    intro slot term
    constructor
    · intro impossible; cases impossible
    · rintro ⟨old, original, impossible, _, _⟩; cases impossible
  intervals := rfl
  nominals := by
    intro slot value
    constructor
    · intro impossible; cases impossible
    · rintro ⟨old, original, impossible, _, _⟩; cases impossible
  constructors := rfl
  seed := rfl
  allocated := rfl
  reserved := rfl
  ordinary := rfl

theorem models_exact (model : Assignment) :
    GeneralNominalState.Models after model ↔ GeneralNominalState.Models before model :=
  models transport model

/-- Even arbitrary full nominal assignments satisfy this unconstrained example. -/
theorem every_assignment_models (model : Assignment) :
    GeneralNominalState.Models before model ∧ GeneralNominalState.Models after model := by
  have valid : GeneralNominalState.Models before model := by
    refine ⟨⟨?_, ?_, ?_⟩, ?_, ?_⟩
    · intro atom impossible; cases impossible
    · intro slot term impossible; cases impossible
    · intro pair impossible; cases impossible
    · intro slot value impossible; cases impossible
    · intro atom impossible; cases impossible
  exact ⟨valid, (models_exact model).mpr valid⟩

/-- The witness may have a genuine nominal value at the newly represented ID. -/
def nominalAssignment : Assignment := fun _ =>
  (CommonNominalFullCarrier.nominal 9 [], Common.rowEmpty)

theorem nominal_nonvacuous :
    GeneralNominalState.Models before nominalAssignment ∧
      GeneralNominalState.Models after nominalAssignment :=
  every_assignment_models nominalAssignment

theorem old_coordinates_preserved :
    after.base.source (transport.embed 0) = 10 ∧
      after.base.rowSource (transport.embed 0) = 42 := ⟨rfl, rfl⟩

/-- Strict growth and fresh type-slot availability compose with exact Models. -/
theorem strict_extension_localizes (model : Assignment) :
    before.base.slots < after.base.slots ∧
      (∀ old, transport.embed old ≠ 1) ∧
      GeneralDictionaryHeadlessLocations.locate before.base demand = none ∧
      GeneralDictionaryHeadlessLocations.locate after.base demand = some afterInputs ∧
      (GeneralNominalState.Models after model ↔ GeneralNominalState.Models before model) :=
  ⟨by decide, by intro old; change (0 : Fin 2) ≠ 1; decide,
    GeneralDictionaryTypeCoverageExamples.reserved_unavailable,
    GeneralDictionaryTypeCoverageExamples.after_located, models_exact model⟩

/-! A second fixture transports a recorded nominal with independent type and
row parameter bounds. Its root and parameter inhabit different old slots. -/
private abbrev largerBase : GeneralSourceState.State where
  slots := 3
  source := fun slot => if slot.val = 0 then 10 else if slot.val = 1 then 77 else 88
  source_injective := by
    intro first last same
    apply Fin.ext
    have firstBound := first.isLt
    have lastBound := last.isLt
    dsimp at same
    split at same <;> (try split at same) <;> (try split at same) <;> (try split at same) <;> omega
  rowSource := fun slot => 42 + slot.val
  ordinary := []
  kinds := 0
  shapes := Fin.elim0
  shapes_injective := by intro first; exact Fin.elim0 first
  heads := fun _ => .unresolved
  intervals := []
  heads_sound := by intro _ _ _ _ impossible; cases impossible
  intervals_sound := by intro _ _ _ impossible; cases impossible

private def unknownView (base : GeneralSourceState.State) :
    GeneralNormalizedObservation.Snapshot base where
  kinds := 0
  shapes := Fin.elim0
  shapes_injective := by intro first; exact Fin.elim0 first
  canonical := by intro kind; exact Fin.elim0 kind
  heads := fun _ => .deferred .unresolved
  checked := by intro _ _ impossible; cases impossible

abbrev mixedConstructor : GeneralDeclarationPatterns.Constructor := ⟨[.type, .row], 9⟩
abbrev mixedDescriptor : GeneralNominalState.Descriptor afterBase.slots where
  constructor := 9
  declaration := mixedConstructor
  arguments := [.type (1, 1), .row (1, 1)]
  layout := rfl

def mixedEmbed (slot : Fin afterBase.slots) : Fin largerBase.slots :=
  ⟨slot.val, by have bound := slot.isLt; change slot.val < 2 at bound; change slot.val < 3; omega⟩

abbrev mixedBefore : GeneralNominalState.State where
  base := afterBase
  view := unknownView afterBase
  constructors := fun _ => some mixedConstructor
  nominals := fun slot => if slot.val = 0 then some mixedDescriptor else none
  catalogue := by
    intro slot value found
    split at found
    · cases found; rfl
    · cases found
  bodies_opaque := by intro _ _ _; rfl
  reserved := [88]

abbrev mixedAfter : GeneralNominalState.State where
  base := largerBase
  view := unknownView largerBase
  constructors := mixedBefore.constructors
  nominals := fun slot => if slot.val = 0 then some (descriptor mixedEmbed mixedDescriptor) else none
  catalogue := by
    intro slot value found
    split at found
    · cases found; rfl
    · cases found
  bodies_opaque := by intro _ _ _; rfl
  seed := mixedBefore.seed
  allocated := mixedBefore.allocated
  reserved := mixedBefore.reserved
  ordinary := mixedBefore.ordinary

def mixedTransport : Transport mixedBefore mixedAfter where
  embed := mixedEmbed
  source := by
    intro slot
    obtain ⟨index, bound⟩ := slot
    change index < 2 at bound
    have cases : index = 0 ∨ index = 1 := by omega
    rcases cases with rfl | rfl <;> rfl
  rowSource := by intro _; rfl
  atoms := rfl
  heads := by
    intro slot term
    constructor
    · intro impossible; cases impossible
    · rintro ⟨old, original, impossible, _, _⟩; cases impossible
  intervals := rfl
  nominals := by
    intro slot value
    constructor
    · intro found
      change (if slot.val = 0 then some (descriptor mixedEmbed mixedDescriptor) else none) = some value at found
      split at found
      next zero =>
        cases found
        exact ⟨0, mixedDescriptor, rfl, Fin.ext zero, rfl⟩
      next => cases found
    · rintro ⟨old, original, found, rfl, rfl⟩
      change (if old.val = 0 then some mixedDescriptor else none) = some original at found
      split at found
      next zero =>
        cases found
        change (if old.val = 0 then _ else _) = _
        rw [ite_eq_left zero]
      next => cases found
  constructors := rfl
  seed := rfl
  allocated := rfl
  reserved := rfl
  ordinary := rfl

theorem mixed_models_exact (model : Assignment) :
    GeneralNominalState.Models mixedAfter model ↔ GeneralNominalState.Models mixedBefore model :=
  models mixedTransport model

/-- Type bound 77 and row bound 43 are separately preserved, not conflated. -/
theorem mixed_bounds_preserved :
    (descriptor mixedEmbed mixedDescriptor).arguments = [.type (1, 1), .row (1, 1)] ∧
      mixedAfter.base.source (mixedEmbed 1) = 77 ∧
      mixedAfter.base.rowSource (mixedEmbed 1) = 43 := ⟨rfl, rfl, rfl⟩

def mixedAssignment : Assignment := fun source =>
  (if source = 10 then CommonNominalFullCarrier.nominal 9
    [.inl (CommonNominalFullCarrier.nominal 8 []), .inr Common.rowEmpty]
   else CommonNominalFullCarrier.nominal 8 [], Common.rowEmpty)

theorem mixed_nominal_nonvacuous :
    GeneralNominalState.Models mixedBefore mixedAssignment ∧
      GeneralNominalState.Models mixedAfter mixedAssignment := by
  have valid : GeneralNominalState.Models mixedBefore mixedAssignment := by
    refine ⟨⟨?_, ?_, ?_⟩, ?_, ?_⟩
    · intro atom impossible; cases impossible
    · intro slot term impossible; cases impossible
    · intro pair impossible; cases impossible
    · intro slot value found
      change (if slot.val = 0 then some mixedDescriptor else none) = some value at found
      split at found
      next zero =>
        cases found
        refine ⟨[.inl (CommonNominalFullCarrier.nominal 8 []), .inr Common.rowEmpty], ?_, ?_⟩
        · exact .cons ⟨CommonNominalFullCarrier.subtype_refl _, CommonNominalFullCarrier.subtype_refl _⟩
            (.cons ⟨Common.rowLe_refl _, Common.rowLe_refl _⟩ .nil)
        · change CommonNominalFullCarrier.Equivalent (mixedAssignment (if slot.val = 0 then 10 else 77)).1 _
          rw [ite_eq_left zero]
          exact ⟨CommonNominalFullCarrier.subtype_refl _, CommonNominalFullCarrier.subtype_refl _⟩
      next => cases found
    · intro atom impossible; cases impossible
  exact ⟨valid, (mixed_models_exact mixedAssignment).mpr valid⟩

end Yulang.GeneralDictionaryNominalSlotTransportExamples
