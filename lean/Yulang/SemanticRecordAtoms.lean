import Yulang.SemanticRecords
import Yulang.StructuralDecisions

/-!
# Atomic factorization of semantic structural subtyping

The outer lattice part of a subtype derivation can be separated from its
structural atoms. This is an independent proof reduction: the atom relation
below is generated by the declarative structural rules, not by a checker.
The existing finite lattice cut theorem is reused through an encoding in
arrow rows. It does not assert that the remaining atomic paths are already
an executable decision procedure.
-/

namespace Yulang.SemanticRecordAtoms

open Inference
open StructuralBase (Ty IsRecord)
open SemanticRecords (Subtype Equivalent)

universe u

variable {Row : Type u} {leRow : Row → Row → Prop}

def Atomic : Ty Row → Prop
  | .bottom | .top | .union _ _ | .inter _ _ => False
  | _ => True

theorem isRecord_atomic {type : Ty Row} (shape : IsRecord type) : Atomic type := by
  cases shape <;> trivial

/-- A single outer structural rule. Recursive premises refer to the
independently defined semantic subtype relation. -/
inductive Step (leRow : Row → Row → Prop) : Ty Row → Ty Row → Prop where
  | pair : Subtype leRow a a' → Subtype leRow b b' → Step leRow (.pair a b) (.pair a' b')
  | variant : Subtype leRow a b → Step leRow (.variant label a) (.variant label b)
  | arrow : Subtype leRow input' input → leRow inputRow' inputRow →
      Subtype leRow output output' → leRow outputRow outputRow' →
      Step leRow (.arrow input inputRow output outputRow)
        (.arrow input' inputRow' output' outputRow')
  | record : IsRecord source → IsRecord target →
      (∀ label value, target.lookup label = some value →
        ∃ actual, source.lookup label = some actual) →
      (∀ label actual expected, source.lookup label = some actual →
        target.lookup label = some expected → Subtype leRow actual expected) →
      Step leRow source target
  | recordCongr : Equivalent leRow value value' → Equivalent leRow rest rest' →
      Step leRow (.record label value rest) (.record label value' rest')

theorem Step.source_atomic {a b : Ty Row} (step : Step leRow a b) : Atomic a := by
  cases step with
  | record shape _ _ _ => exact isRecord_atomic shape
  | _ => trivial

theorem Step.target_atomic {a b : Ty Row} (step : Step leRow a b) : Atomic b := by
  cases step with
  | record _ shape _ _ => exact isRecord_atomic shape
  | _ => trivial

theorem Step.sound {a b : Ty Row} (step : Step leRow a b) : Subtype leRow a b := by
  cases step with
  | pair first last => exact .pair first last
  | variant payload => exact .variant payload
  | arrow input inputRow output outputRow => exact .arrow input inputRow output outputRow
  | record source target fields values => exact .record source target fields values
  | recordCongr head tail => exact .recordCongr head.1 head.2 tail.1 tail.2

inductive Chain (leRow : Row → Row → Prop) : Ty Row → Ty Row → Prop where
  | refl : Atomic a → Chain leRow a a
  | step : Step leRow a b → Chain leRow a b
  | trans : Chain leRow a b → Chain leRow b c → Chain leRow a c

theorem Chain.source_atomic {a b : Ty Row} (chain : Chain leRow a b) : Atomic a := by
  induction chain with
  | refl atom => exact atom
  | step one => exact one.source_atomic
  | trans _ _ first _ => exact first

theorem Chain.target_atomic {a b : Ty Row} (chain : Chain leRow a b) : Atomic b := by
  induction chain with
  | refl atom => exact atom
  | step one => exact one.target_atomic
  | trans _ _ _ last => exact last

theorem Chain.sound {a b : Ty Row} (chain : Chain leRow a b) : Subtype leRow a b := by
  induction chain with
  | refl => exact .refl _
  | step one => exact one.sound
  | trans _ _ first last => exact .trans first last

def encode : Ty Row → StructuralBase.Ty (Option (Ty Row))
  | .bottom => .bottom
  | .top => .top
  | .union left right => .union (encode left) (encode right)
  | .inter left right => .inter (encode left) (encode right)
  | atom => .arrow .bottom none .bottom (some atom)

theorem encode_atomic {type : Ty Row} (atom : Atomic type) :
    encode type = .arrow .bottom none .bottom (some type) := by
  cases type <;> simp_all [Atomic, encode]

def rows (leRow : Row → Row → Prop) : Option (Ty Row) → Option (Ty Row) → Prop
  | none, none => True
  | some a, some b => Chain leRow a b
  | _, _ => False

theorem rows_trans {a b c : Option (Ty Row)}
    (first : rows leRow a b) (last : rows leRow b c) : rows leRow a c := by
  cases a <;> cases b <;> cases c <;> simp_all [rows]
  exact .trans first last

theorem Chain.encoded {a b : Ty Row} (chain : Chain leRow a b) :
    StructuralBase.Subtype (rows leRow) (encode a) (encode b) := by
  rw [encode_atomic chain.source_atomic, encode_atomic chain.target_atomic]
  exact .arrow (.refl _) trivial (.refl _) chain

/-- Every semantic derivation factors through a free outer lattice whose
atomic order consists of declarative structural paths. -/
theorem encoded {a b : Ty Row} (subtype : Subtype leRow a b) :
    StructuralBase.Subtype (rows leRow) (encode a) (encode b) := by
  induction subtype with
  | refl => exact .refl _
  | trans _ _ first last => exact .trans first last
  | bottom => exact .bottom _
  | top => exact .top _
  | unionLeft => exact .unionLeft _ _
  | unionRight => exact .unionRight _ _
  | unionElim _ _ first last => exact .unionElim first last
  | interLeft => exact .interLeft _ _
  | interRight => exact .interRight _ _
  | interIntro _ _ first last => exact .interIntro first last
  | pair first last => exact (Chain.step (Step.pair first last)).encoded
  | variant payload => exact (Chain.step (Step.variant payload)).encoded
  | arrow input inputRow output outputRow =>
      exact (Chain.step (Step.arrow input inputRow output outputRow)).encoded
  | record source target fields values =>
      exact (Chain.step (Step.record source target fields values)).encoded
  | recordCongr head backHead tail backTail =>
      exact (Chain.step (Step.recordCongr ⟨head, backHead⟩ ⟨tail, backTail⟩)).encoded

def decode : StructuralBase.Ty (Option (Ty Row)) → Ty Row
  | .bottom => .bottom
  | .top => .top
  | .union a b => .union (decode a) (decode b)
  | .inter a b => .inter (decode a) (decode b)
  | .arrow _ _ _ output => output.getD .bottom
  | _ => .bottom

@[simp] theorem decode_encode (type : Ty Row) : decode (encode type) = type := by
  induction type <;> simp [encode, decode, *]

theorem decode_record {type : StructuralBase.Ty (Option (Ty Row))}
    (shape : IsRecord type) : decode type = .bottom := by
  cases shape <;> rfl

theorem decoded {a b : StructuralBase.Ty (Option (Ty Row))}
    (subtype : StructuralBase.Subtype (rows leRow) a b) : Subtype leRow (decode a) (decode b) := by
  induction subtype with
  | refl => exact .refl _
  | trans _ _ first last => exact .trans first last
  | bottom => exact .bottom _
  | top => exact .top _
  | unionLeft => exact .unionLeft _ _
  | unionRight => exact .unionRight _ _
  | unionElim _ _ first last => exact .unionElim first last
  | interLeft => exact .interLeft _ _
  | interRight => exact .interRight _ _
  | interIntro _ _ first last => exact .interIntro first last
  | pair => exact .refl _
  | variant => exact .refl _
  | @arrow input input' inputRow inputRow' output output' outputRow outputRow' _ _ _ outputRows =>
      cases outputRow <;> cases outputRow' <;> simp_all [rows, decode]
      · exact .refl _
      · exact Chain.sound (by assumption)
  | record source target => rw [decode_record source, decode_record target]; exact .refl _

theorem encoded_iff (a b : Ty Row) :
    StructuralBase.Subtype (rows leRow) (encode a) (encode b) ↔ Subtype leRow a b :=
  ⟨fun h => by simpa using decoded h, encoded⟩

/-- Cut elimination for the outer lattice. The structural atom paths remain
explicit, to be eliminated by the record-view comparison layer. -/
theorem outer_cut_exact (a b : Ty Row) :
    StructuralDecisions.Comparison (rows leRow) (encode a) (encode b) ↔ Subtype leRow a b :=
  (StructuralDecisions.comparison_iff_subtype rows_trans _ _).trans (encoded_iff a b)

theorem atomic_iff_chain {a b : Ty Row} (first : Atomic a) (last : Atomic b) :
    Subtype leRow a b ↔ Chain leRow a b := by
  constructor
  · intro subtype
    have comparison := (outer_cut_exact a b).mpr subtype
    rw [encode_atomic first, encode_atomic last] at comparison
    cases comparison with
    | refl => exact .refl first
    | arrow _ _ _ output => exact output
    | record shape => cases shape
  · exact Chain.sound

end Yulang.SemanticRecordAtoms
