import Yulang.CommonRoleStructuralHornClosure
import Yulang.CommonRoleFiniteAssociatedDeclaration

/-! Actual associated declarations and structural ordinary implications share
one computed finite carrier. Finite occurrences and their receiver templates
remain explicit; dynamic source generation, K2 and non-scalar associated RHS
are outside this adapter. A scalar is learned only from both ordinary bounds. -/
namespace Yulang.CommonRoleStructuralAssociatedClosure
open PresenceNormalForm (Atom All)
open Core.PresenceGeneration (Comp)
open CommonRoleFiniteAssociatedClosure (Occurrence request bases)
open CommonRoleAssociatedDeclarationExact (DeclarativeComputed)
open CommonRoleCandidateStateFrontier (equality)
open CommonRoleStructuralHornClosure (Clause)
open CommonRoleFiniteStructuralClosure (compose)

/-- Both equations are generated by the actual declaration adapter; they are
not initial seeds. Their two receiver premises must first become derivable. -/
def occurrenceClauses (env : Roles.AssocEnv) (roles : Roles.RoleDecls)
    (wf : Roles.WellFormed env.cores) (q : Occurrence n) : List (Clause n) :=
  bases.flatMap fun head =>
    match CommonRoleAssociatedStateFlow.value env roles wf (request q head) with
    | none => []
    | some output => (equality q.output output).map fun atom => ⟨equality q.receiver head,atom⟩

def clauses (env : Roles.AssocEnv) (roles : Roles.RoleDecls)
    (wf : Roles.WellFormed env.cores) (occurrences : List (Occurrence n)) :=
  occurrences.flatMap (occurrenceClauses env roles wf)

/-- Neither executable value calculation nor saturation occurs in this judgment.
The existing declaration judgment includes independent receiver resolution. -/
inductive Derives (env : Roles.AssocEnv) (roles : Roles.RoleDecls)
    (occurrences : List (Occurrence n)) (seeds : List (Atom (Fin n))) : Atom (Fin n) → Prop
  | seed (a) : a ∈ seeds → Derives env roles occurrences seeds a
  | split (a b) : Derives env roles occurrences seeds a →
      b ∈ CommonRoleStructuralDecomposition.atom a → Derives env roles occurrences seeds b
  | trans (a b c) : Derives env roles occurrences seeds a → Derives env roles occurrences seeds b →
      c ∈ compose a b → Derives env roles occurrences seeds c
  | associated (q head output a) : q ∈ occurrences →
      (∀ premise ∈ equality q.receiver head, Derives env roles occurrences seeds premise) →
      DeclarativeComputed env roles (request q head) output → a ∈ equality q.output output →
      Derives env roles occurrences seeds a

theorem clauses_exact (env : Roles.AssocEnv) (roles : Roles.RoleDecls)
    (wf : Roles.WellFormed env.cores) (awf : Roles.AssocWellFormed env roles)
    (occurrences : List (Occurrence n)) (r : Clause n) :
    r ∈ clauses env roles wf occurrences ↔ ∃ q ∈ occurrences, ∃ head output a,
      DeclarativeComputed env roles (request q head) output ∧ a ∈ equality q.output output ∧
      r = ⟨equality q.receiver head,a⟩ := by
  constructor
  · intro member
    obtain ⟨q,qmember,present⟩ := List.mem_flatMap.mp member
    obtain ⟨head,_,present⟩ := List.mem_flatMap.mp present
    cases found : CommonRoleAssociatedStateFlow.value env roles wf (request q head) with
    | none => simp [found] at present
    | some output =>
      simp only [found] at present
      obtain ⟨a,eqs,rfl⟩ := List.mem_map.mp present
      exact ⟨q,qmember,head,output,a,
        (CommonRoleAssociatedDeclarationExact.computed_iff_declarative env roles wf awf ..).mp
          ((CommonRoleAssociatedStateFlow.value_exact ..).mp found),eqs,rfl⟩
  · rintro ⟨q,member,head,output,a,computed,eqs,rfl⟩
    apply List.mem_flatMap.mpr
    refine ⟨q,member,List.mem_flatMap.mpr ⟨head,?_,?_⟩⟩
    · cases head <;> simp [bases]
    · rw [(CommonRoleAssociatedStateFlow.value_exact ..).mpr
        ((CommonRoleAssociatedDeclarationExact.computed_iff_declarative env roles wf awf ..).mpr computed)]
      exact List.mem_map.mpr ⟨a,eqs,rfl⟩

/-- Both directions expose every actual declaration premise; no successful
resolver result or complete finite carrier is assumed by the caller. -/
theorem derives_exact (env : Roles.AssocEnv) (roles : Roles.RoleDecls)
    (wf : Roles.WellFormed env.cores) (awf : Roles.AssocWellFormed env roles)
    (occurrences : List (Occurrence n)) (seeds : List (Atom (Fin n))) (a) :
    CommonRoleStructuralHornClosure.Derives seeds (clauses env roles wf occurrences) a ↔
      Derives env roles occurrences seeds a := by
  constructor
  · intro h
    induction h with
    | seed a member => exact .seed a member
    | split a b _ member ih => exact .split a b ih member
    | trans a b c _ _ member iha ihb => exact .trans a b c iha ihb member
    | clause r member _ ih =>
      obtain ⟨q,qmember,head,output,a,computed,eqs,rfl⟩ := (clauses_exact env roles wf awf ..).mp member
      exact .associated q head output a qmember ih computed eqs
  · intro h
    induction h with
    | seed a member => exact .seed a member
    | split a b _ member ih => exact .split a b ih member
    | trans a b c _ _ member iha ihb => exact .trans a b c iha ihb member
    | associated q head output a member _ computed eqs ih =>
      exact .clause ⟨equality q.receiver head,a⟩
        ((clauses_exact env roles wf awf ..).mpr ⟨q,member,head,output,a,computed,eqs,rfl⟩) ih

def saturate (env : Roles.AssocEnv) (roles : Roles.RoleDecls)
    (wf : Roles.WellFormed env.cores) (occurrences : List (Occurrence n))
    (seeds : List (Atom (Fin n))) :=
  CommonRoleStructuralHornClosure.saturate seeds (clauses env roles wf occurrences)

/-- General in initial structural atoms, declaration registry, and finite
occurrence graph. Ordinary and associated steps can alternate arbitrarily. -/
theorem saturate_exact (env : Roles.AssocEnv) (roles : Roles.RoleDecls)
    (wf : Roles.WellFormed env.cores) (awf : Roles.AssocWellFormed env roles)
    (occurrences : List (Occurrence n)) (seeds : List (Atom (Fin n))) (a) :
    a ∈ saturate env roles wf occurrences seeds ↔ Derives env roles occurrences seeds a :=
  (CommonRoleStructuralHornClosure.saturate_exact ..).trans (derives_exact env roles wf awf ..)

/-- Models of the actual final closure are exactly initial models plus every
independently activated declaration equation. No single chosen witness is used. -/
theorem models_exact (env : Roles.AssocEnv) (roles : Roles.RoleDecls)
    (wf : Roles.WellFormed env.cores) (awf : Roles.AssocWellFormed env roles)
    (occurrences : List (Occurrence n)) (seeds : List (Atom (Fin n)))
    (v : Fin n → Comp Common.model) :
    All Common.model v (saturate env roles wf occurrences seeds) ↔ All Common.model v seeds ∧
      ∀ q ∈ occurrences, ∀ head output,
        (∀ premise ∈ equality q.receiver head, Derives env roles occurrences seeds premise) →
        DeclarativeComputed env roles (request q head) output →
        All Common.model v (equality q.output output) := by
  rw [saturate,CommonRoleStructuralHornClosure.models_exact]
  apply and_congr_right
  intro _
  constructor
  · intro valid q member head output premises computed a eqs
    apply valid ⟨equality q.receiver head,a⟩
    · exact (clauses_exact env roles wf awf ..).mpr ⟨q,member,head,output,a,computed,eqs,rfl⟩
    · intro b hb; exact (derives_exact env roles wf awf ..).mpr (premises b hb)
  · intro valid r member premises
    obtain ⟨q,qmember,head,output,a,computed,eqs,rfl⟩ := (clauses_exact env roles wf awf ..).mp member
    exact valid q qmember head output
      (fun b hb => (derives_exact env roles wf awf ..).mp (premises b hb)) computed a eqs

/-- Source occurrence permutation/duplication changes no final atom membership.
This is not dictionary observational equivalence or candidate-order selection. -/
theorem derives_congr (env : Roles.AssocEnv) (roles : Roles.RoleDecls)
    (left right : List (Occurrence n)) (seeds more : List (Atom (Fin n)))
    (source : ∀ q, q ∈ left ↔ q ∈ right) (initial : ∀ a, a ∈ seeds ↔ a ∈ more) (a) :
    Derives env roles left seeds a ↔ Derives env roles right more a := by
  constructor
  · intro h
    induction h with
    | seed a member => exact .seed a ((initial a).mp member)
    | split a b _ member ih => exact .split a b ih member
    | trans a b c _ _ member iha ihb => exact .trans a b c iha ihb member
    | associated q head output a member _ computed eqs ih =>
      exact .associated q head output a ((source q).mp member) ih computed eqs
  · intro h
    induction h with
    | seed a member => exact .seed a ((initial a).mpr member)
    | split a b _ member ih => exact .split a b ih member
    | trans a b c _ _ member iha ihb => exact .trans a b c iha ihb member
    | associated q head output a member _ computed eqs ih =>
      exact .associated q head output a ((source q).mpr member) ih computed eqs

theorem saturate_congr (env : Roles.AssocEnv) (roles : Roles.RoleDecls)
    (wf : Roles.WellFormed env.cores) (awf : Roles.AssocWellFormed env roles)
    (left right : List (Occurrence n)) (seeds more : List (Atom (Fin n)))
    (source : ∀ q, q ∈ left ↔ q ∈ right) (initial : ∀ a, a ∈ seeds ↔ a ∈ more) (a) :
    a ∈ saturate env roles wf left seeds ↔ a ∈ saturate env roles wf right more := by
  rw [saturate_exact env roles wf awf,saturate_exact env roles wf awf]
  exact derives_congr env roles left right seeds more source initial a

end Yulang.CommonRoleStructuralAssociatedClosure
