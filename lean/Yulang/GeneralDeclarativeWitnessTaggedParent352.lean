import Yulang.GeneralDeclarativeWitnessMixedCompletion352
import Yulang.GeneralDeclarativeWitnessMixedFixture352

set_option backward.isDefEq.respectTransparency false
set_option maxRecDepth 35000
set_option maxHeartbeats 23000000
namespace Yulang.GeneralDeclarativeWitnessTaggedParent352
open GeneralDeclarativeHead320 (State Equation)
open GeneralDeclarativeDemand320 (Demand)
open GeneralDeclarativeWhere319 (Capture)
open GeneralDeclarations (Declaration)
open GeneralDeclarativeWitnessOrigins350 (Table attach)
open GeneralDeclarativeWitnessForest350 (Layout)
open GeneralDeclarativeWitnessMixedForest352 (Problem Code atNode)
open GeneralDeclarativeWitnessTree349 (Report)
open GeneralDeclarativeWitnessCompiler350 (Context Finished execute printDemand)
open GeneralDeclarativeWitnessTagBranch352 (Wire)
open GeneralDeclarativeWitnessTagElection352 (Ends reads)
open GeneralDeclarativeWitnessTagSources351 (Script)
open GeneralDeclarativeWitnessTagLocal351 (parse context)
open GeneralDeclarativeWitnessTagHeader352 (replay)
open GeneralDeclarativeWitnessBound349 (Range)
open GeneralSourceMetadataBareBundle291 (InputBundle)
open GeneralSourceMetadataBundle291 (registry)
open GeneralSourceMetadataRows291 (interpretation)
open GeneralDeclarativeWitnessOrderedFixture350 (clause0 clause1 literalPlan atomic)
open GeneralDeclarativeWitnessRecordLeafFixture350 (source fallback)
open GeneralDeclarativeWitnessMixedFixture352 (h child0 child1)
open GeneralDeclarativeTaggedFixture340 (eInt eBool)
open GeneralDeclarativeWitnessAllocation350 (names)

def outer : GeneralDeclarationPatterns.Pattern := .variant 11 (.var 0)
def parent : Declaration := ⟨92,1,[outer],[clause0,clause1],[⟨91,0,.var 0⟩],[]⟩
def sourceBundle : InputBundle :=
  ⟨source,source,⟨0,[⟨1,1,[(0,none)]⟩,⟨3,1,[]⟩,⟨4,1,[]⟩]⟩,[parent,child0,child1]⟩
def root : Demand := ⟨1,[⟨0,0,0⟩],[⟨0,5⟩]⟩

def roots : List Equation :=
  [⟨0,.join (.variable 3) (.variable 4)⟩,⟨3,.variant 11 (.variable 8)⟩,⟨4,.variant 11 (.variable 9)⟩,
   ⟨2,.join (.variable 8) (.variable 9)⟩,⟨8,.variant 7 eInt⟩,⟨9,.variant 7 eBool⟩]
def base : State := ⟨⟨[],[]⟩,roots⟩
def origin : Table := ⟨roots,[],[]⟩
def rootSpan : Range := ⟨.refl 0,.refl 0⟩
def rootRead : Script :=
  .named ⟨0,.same⟩ (.join (.named ⟨1,.same⟩ .tagged) (.named ⟨2,.same⟩ .tagged))
def rootEnds : Ends := .recursive rootRead rootRead

def preLayout : Layout := ⟨base,[19],fallback,fun _ _ => 0⟩
def problemAt (s : State) (layout : List Nat → Demand → Layout) : Problem :=
  ⟨sourceBundle,s,origin,root,layout⟩

def calibrated (s : State) (layout : List Nat → Demand → Layout) (path : List Nat) (d : Demand)
    (decl : Declaration) (arg : Capture) (tag : Nat) (pattern : GeneralDeclarationPatterns.Pattern)
    (bound : Range) (readsEnds : Ends) : Option Context := do
  let a := atNode (problemAt s layout) path d
  let t ← replay a.problem ⟨d.outputs⟩
  let attached ← attach a.before origin
  let selected ← reads attached arg tag bound readsEnds
  let p ← parse (registry t).constructors (interpretation t.snapshot) pattern tag
  pure (context (r := registry t) d decl selected p a.keep a.fallback a.targets)

def parentContext : Option Context :=
  calibrated base (fun _ _ => preLayout) [] root parent ⟨0,0,0⟩ 11 outer rootSpan rootEnds

def parentRun : Option Finished := parentContext.bind execute

def outputLeft : Option (List Nat) := parentRun.map (fun f => f.fixed.map Equation.left)
theorem genuine_fixed_target : outputLeft = some [5] := by decide +kernel


def childArg : Capture := ⟨27,26,28⟩
def demand0 : Demand := ⟨3,[childArg],[]⟩
def demand1 : Demand := ⟨4,[childArg],[]⟩
def out : Equation := ⟨5,.variable 26⟩

/-- Exact generated child slots and output address, before any consumer
proof is supplied. The identical capture does not coalesce positions. -/
theorem compiler_coordinates :
    (parentRun.map (fun f => decide (f.kids.map printDemand = [printDemand demand0,printDemand demand1] ∧ f.fixed = [out]))).getD false = true := by
  decide +kernel

/-- Alias facts are external checked current facts, not claimed to be
generated by the parent compiler. Its own underlying child bounds
are the real ordinary rows 8 and 9. -/
def beforeChild (f : Finished) : State :=
  GeneralDeclarativeCaptureClosure320.withOrdinary f.state
    ([(27,2),(2,27),(28,2),(2,28)].map fun (l,h) => atomic l h)

def layout (f : Finished) (path : List Nat) (_ : Demand) : Layout :=
  if path.isEmpty then preLayout
  else ⟨beforeChild f,if path = [0] then [49] else [79],fallback,fun _ _ => 0⟩

def childSpan : Range := ⟨.constraint 8,.constraint 9⟩
def certainArms : Script := .join (.named ⟨4,.same⟩ .tagged) (.named ⟨5,.same⟩ .tagged)
def childEnds : Ends := .recursive (.named ⟨3,.order ⟨.constraint 10,.constraint 11⟩⟩ certainArms)
  (.named ⟨3,.order ⟨.constraint 12,.constraint 13⟩⟩ certainArms)

def current (l r : Finished) : State :=
  ⟨⟨l.state.normal.ordinary ++ r.state.normal.ordinary,[]⟩,l.state.equations ++ r.state.equations⟩

def levels : List Nat := (List.range 100).map fun x =>
  if x = 0 then 3 else if x ∈ [3,4] then 2 else if x ∈ [2,5,20,21,22,23,24,25,26,27,28] then 1 else 0

def atBranch (s : State) (ctx : Context) (f : Finished) (range : Range) (ends : Ends) : Option Wire := do
  pure ⟨range,ends,range,ends,levels,names ctx.spans,⟨f.kids.map printDemand,f.fixed,← literalPlan f.state s⟩⟩

def candidate : Option (Problem × Code) := do
  let ctx ← parentContext
  let top ← execute ctx
  let l ← calibrated (beforeChild top) (layout top) [0] demand0 child0 childArg 7 h childSpan childEnds
  let r ← calibrated (beforeChild top) (layout top) [1] demand1 child1 childArg 7 h childSpan childEnds
  let lf ← execute l
  let rf ← execute r
  let now := current lf rf
  let w ← atBranch now ctx top rootSpan rootEnds
  let wl ← atBranch now l lf childSpan childEnds
  let wr ← atBranch now r rf childSpan childEnds
  pure (problemAt now (layout top),.node (.tagged w) (.cons (.node (.tagged wl) .nil)
    (.cons (.node (.tagged wr) .nil) .nil)))

def report : Report := ⟨.selected 92 [.selected 93 [],.selected 94 []],
  .selected (.node 92 [.node 93 [],.node 94 []]),root.outputs⟩

def check (edit : Code → Code := id) (answer : Report := report) : Bool :=
  (candidate.map fun (s,c) => GeneralDeclarativeWitnessMixedWhole352.check s root (edit c) answer).getD false

theorem independently_accepted : check = true := by decide +kernel

theorem wrong_earlier_output : check (fun
    | .node (.tagged w) cs => .node (.tagged {w with emitted := {w.emitted with outputRows := [⟨5,.variable 2⟩]}}) cs
    | any => any) = false := by decide +kernel

theorem different_physical_target : check id {report with outputs := [⟨0,26⟩]} = false := by decide +kernel

end Yulang.GeneralDeclarativeWitnessTaggedParent352
