import Yulang.CommonBoundCoalescing
import Yulang.DemandBoundPropagation

/-!
# Centre-less invariant intervals over the existing Common bounds model

An interval contains its lower and upper endpoints only. The actual argument
is an independent model assignment to an original shared slot, not a stored
centre. Reconciliation joins lowers, meets uppers and returns all cross
conditions to the existing bounds machine. No new type carrier or nominal
interpretation is introduced here.

These laws do not decide whether two distinct branch values share an actual
argument slot. That source rule is outside this module.
-/

namespace Yulang.CommonInvariantIntervals

open Common (Ty Subtype Equivalent)

/-- Description data, not a tuple value type or a new semantic carrier. -/
abbrev Interval := Ty × Ty

def Holds (bounds : Interval) (actual : Ty) : Prop :=
  Subtype bounds.1 actual ∧ Subtype actual bounds.2

def Consistent (bounds : Interval) : Prop := Subtype bounds.1 bounds.2

def point (type : Ty) : Interval := (type, type)

def merge (first last : Interval) : Interval :=
  (.union first.1 last.1, .inter first.2 last.2)

/-- Exactly the two comparisons generated by a same-actual-slot merge.
Each original interval additionally retains its own lower/upper condition. -/
def Cross (first last : Interval) : Prop :=
  Subtype first.1 last.2 ∧ Subtype last.1 first.2

theorem holds_merge_exact (first last : Interval) (actual : Ty) :
    Holds (merge first last) actual ↔ Holds first actual ∧ Holds last actual := by
  simp only [Holds, merge, Common.common_union_is_join, Common.common_inter_is_meet]
  constructor
  · rintro ⟨⟨firstLower, lastLower⟩, firstUpper, lastUpper⟩
    exact ⟨⟨firstLower, firstUpper⟩, lastLower, lastUpper⟩
  · rintro ⟨⟨firstLower, firstUpper⟩, lastLower, lastUpper⟩
    exact ⟨⟨firstLower, lastLower⟩, firstUpper, lastUpper⟩

theorem merge_consistent_exact (first last : Interval) :
    Consistent (merge first last) ↔ Consistent first ∧ Consistent last ∧ Cross first last := by
  simp only [Consistent, merge, Cross, Common.common_union_is_join, Common.common_inter_is_meet]
  constructor
  · rintro ⟨⟨ownFirst, crossFirst⟩, crossLast, ownLast⟩
    exact ⟨ownFirst, ownLast, crossLast, crossFirst⟩
  · rintro ⟨ownFirst, ownLast, crossFirst, crossLast⟩
    exact ⟨⟨ownFirst, crossLast⟩, crossFirst, ownLast⟩

/-- The lower endpoint is the existing bounds machine's canonical least
witness for a single interval. No arbitrary substitution oracle is used. -/
theorem consistent_iff_actual (bounds : Interval) :
    Consistent bounds ↔ ∃ actual, Holds bounds actual := by
  constructor
  · intro consistent
    exact ⟨bounds.1, Common.subtype_refl _, consistent⟩
  · rintro ⟨actual, lower, upper⟩
    exact Common.subtype_trans lower upper

theorem shared_actual_exact (first last : Interval) :
    (∃ actual, Holds first actual ∧ Holds last actual) ↔
      Consistent first ∧ Consistent last ∧ Cross first last := by
  rw [← merge_consistent_exact, consistent_iff_actual]
  exact exists_congr fun actual => holds_merge_exact first last actual |>.symm

/-- Ground/collapsed invariance is recovered as a special case. -/
theorem point_holds_exact (type actual : Ty) :
    Holds (point type) actual ↔ Equivalent type actual := Iff.rfl

theorem collapsed_merge_exact (first last : Ty) :
    Consistent (merge (point first) (point last)) ↔ Equivalent first last := by
  rw [merge_consistent_exact]
  simp only [Consistent, point, Cross, Common.subtype_refl, true_and]
  rfl

/-- A variable occurring in both bounds is equal to the actual argument.
The occurrence facts are inequalities supplied by the original bound syntax. -/
theorem shared_bound_variable (bounds : Interval) (actual shared : Ty)
    (variableLower : Subtype shared bounds.1) (variableUpper : Subtype bounds.2 shared)
    (model : Holds bounds actual) : Equivalent shared actual :=
  ⟨Common.subtype_trans variableLower model.1, Common.subtype_trans model.2 variableUpper⟩

theorem shared_bound_variables_equal (bounds : Interval) (actual first last : Ty)
    (firstLower : Subtype first bounds.1) (firstUpper : Subtype bounds.2 first)
    (lastLower : Subtype last bounds.1) (lastUpper : Subtype bounds.2 last)
    (model : Holds bounds actual) : Equivalent first last := by
  have firstSame := shared_bound_variable bounds actual first firstLower firstUpper model
  have lastSame := shared_bound_variable bounds actual last lastLower lastUpper model
  exact ⟨Common.subtype_trans firstSame.1 lastSame.2,
    Common.subtype_trans lastSame.1 firstSame.2⟩

abbrev Occurrence (slots : Nat) := Fin slots × Interval
abbrev Flow (slots : Nat) := Fin slots × Fin slots

/-- Independent meaning of all original interval occurrences and flows.
Repeated slot IDs denote the same actual argument throughout the problem. -/
def Models (occurrences : List (Occurrence slots)) (flows : List (Flow slots))
    (actual : Fin slots → Ty) : Prop :=
  (∀ occurrence ∈ occurrences, Holds occurrence.2 (actual occurrence.1)) ∧
    ∀ flow ∈ flows, Subtype (actual flow.1) (actual flow.2)

def intervalConstraints (occurrence : Occurrence slots) : LayerBoundTemplates.Problem slots Ty :=
  [.lower occurrence.2.1 occurrence.1, .upper occurrence.1 occurrence.2.2]

def compile (occurrences : List (Occurrence slots)) (flows : List (Flow slots)) :
    LayerBoundTemplates.Problem slots Ty :=
  occurrences.flatMap intervalConstraints ++ flows.map (fun edge => .flow edge.1 edge.2)

/-- No interval witness or original slot is dropped during generation. -/
theorem compile_models_exact (occurrences : List (Occurrence slots)) (flows : List (Flow slots))
    (actual : Fin slots → Ty) :
    CommonBoundCoalescing.Models id (compile occurrences flows) actual ↔ Models occurrences flows actual := by
  simp only [CommonBoundCoalescing.Models, compile, List.mem_append, or_imp, forall_and,
    List.mem_flatMap, forall_exists_index, and_imp, List.mem_map]
  constructor
  · rintro ⟨intervals, edges⟩
    refine ⟨?_, ?_⟩
    · intro occurrence member
      exact ⟨intervals (.lower occurrence.2.1 occurrence.1) occurrence member
          (by simp [intervalConstraints]),
        intervals (.upper occurrence.1 occurrence.2.2) occurrence member
          (by simp [intervalConstraints])⟩
    · intro edge member
      exact edges _ edge member rfl
  · rintro ⟨intervals, edges⟩
    refine ⟨?_, ?_⟩
    · intro constraint occurrence member included
      simp only [intervalConstraints, List.mem_cons, List.not_mem_nil, or_false] at included
      rcases included with rfl | rfl
      · exact (intervals occurrence member).1
      · exact (intervals occurrence member).2
    · intro constraint edge member same
      subst constraint
      exact edges edge member

/-- The existing solver expansion is reused verbatim. Original values are
its retraction parameters; no new centre is stored in interval descriptions. -/
theorem all_models_recovered (occurrences : List (Occurrence slots)) (flows : List (Flow slots))
    (actual : Fin slots → Ty) (model : Models occurrences flows actual) (index : Fin slots) :
    Equivalent (CommonBoundCoalescing.expand id (compile occurrences flows) actual index) (actual index) :=
  CommonBoundCoalescing.expand_retraction ((compile_models_exact occurrences flows actual).mpr model) index

/-- Consistency concerns only the finite fixed endpoint comparisons. This is
an algebraic bridge; an executable endpoint checker must discharge it before
an unrestricted family is returned by a concrete solver. -/
theorem all_parameters_models (occurrences : List (Occurrence slots)) (flows : List (Flow slots))
    (checked : CommonBoundCoalescing.Consistent id (compile occurrences flows))
    (parameters : Fin slots → Ty) :
    Models occurrences flows (CommonBoundCoalescing.expand id (compile occurrences flows) parameters) :=
  (compile_models_exact occurrences flows _).mp (CommonBoundCoalescing.expand_satisfies checked parameters)

theorem models_family_exact (occurrences : List (Occurrence slots)) (flows : List (Flow slots))
    (actual : Fin slots → Ty) :
    Models occurrences flows actual ↔
      CommonBoundCoalescing.Consistent id (compile occurrences flows) ∧
        ∃ parameters, ∀ index,
          Equivalent (CommonBoundCoalescing.expand id (compile occurrences flows) parameters index) (actual index) := by
  rw [← compile_models_exact]
  exact CommonBoundCoalescing.all_instances_exact id _ actual

end Yulang.CommonInvariantIntervals
