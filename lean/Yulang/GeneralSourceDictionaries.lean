import Yulang.GeneralSourceState
import Yulang.B4TargetV2

/-!
# Source-indexed dictionaries and their structural comparison

Partial I-18 item 5. An occurrence retains both stable source identity and the
actual multiargument demand. Reordering never reassigns those identities. This
module supplies concrete state linkage and erasure to the existing runtime
payload, not a general declaration model, candidate judgment, or executor.

`Evidence` is explicitly parameterized by a still-missing local declaration
instance judgment. It does not implement `SourceBoundary.Evidence`. In
particular, linkage alone is not role satisfaction. General registry `Reorders`
awaits the declaration carrier and is not replaced by opaque-key permutation.
-/
namespace Yulang.GeneralSourceDictionaries

open GeneralSourceState (State Demand Refines)

/-- Identity is independent of demand equality and of the current sibling order.
The source allocator must eventually supply it; this module does not choose one.
Freshness or uniqueness of IDs is not enforced by this carrier. -/
structure Occurrence (roles : Roles.RoleDecls) where
  identity : Nat
  demand : Demand roles

inductive Dictionary (roles : Roles.RoleDecls) where
  | node (occurrence : Occurrence roles) (key : Nat) (children : List (Dictionary roles))

def Dictionary.root : Dictionary roles → Occurrence roles
  | .node occurrence _ _ => occurrence

def Dictionary.key : Dictionary roles → Nat
  | .node _ key _ => key

mutual
  def erase : Dictionary roles → CommonRoleOutermostResolver.Dictionary
    | .node _ key children => .node key (eraseChildren children)
  def eraseChildren : List (Dictionary roles) → List CommonRoleOutermostResolver.Dictionary
    | [] => []
    | first :: rest => erase first :: eraseChildren rest
end

/-- The least equivalence congruence generated by sibling permutations. Complete
occurrences and selected declaration keys remain fixed. Repeated occurrences are
not deduplicated. This is structural observation, not method-body equivalence. -/
inductive DictionaryEquivalent : Dictionary roles → Dictionary roles → Prop where
  | refl (tree) : DictionaryEquivalent tree tree
  | reorder (occurrence) (key) {before after}
      (permuted : before.Perm after) :
      DictionaryEquivalent (.node occurrence key before) (.node occurrence key after)
  | replace (occurrence) (key) (leading trailing) {before after}
      (same : DictionaryEquivalent before after) :
      DictionaryEquivalent (.node occurrence key (leading ++ before :: trailing))
        (.node occurrence key (leading ++ after :: trailing))
  | symm {before after} : DictionaryEquivalent before after → DictionaryEquivalent after before
  | trans {first middle last} : DictionaryEquivalent first middle →
      DictionaryEquivalent middle last → DictionaryEquivalent first last

theorem equivalent_refl (tree : Dictionary roles) : DictionaryEquivalent tree tree := .refl tree

theorem equivalent_symm (same : DictionaryEquivalent before after) :
    DictionaryEquivalent after before := .symm same

theorem equivalent_trans (first : DictionaryEquivalent before middle)
    (last : DictionaryEquivalent middle after) : DictionaryEquivalent before after :=
  .trans first last

theorem equivalent_root (same : DictionaryEquivalent before after) :
    before.root = after.root := by
  induction same with
  | refl => rfl
  | reorder => rfl
  | replace => rfl
  | symm _ ih => exact ih.symm
  | trans _ _ first last => exact first.trans last

theorem equivalent_key (same : DictionaryEquivalent before after) :
    before.key = after.key := by
  induction same with
  | refl => rfl
  | reorder => rfl
  | replace => rfl
  | symm _ ih => exact ih.symm
  | trans _ _ first last => exact first.trans last

mutual
  def observations : Dictionary roles → List (Occurrence roles × Nat)
    | .node occurrence key children => (occurrence, key) :: childObservations children
  def childObservations : List (Dictionary roles) → List (Occurrence roles × Nat)
    | [] => []
    | first :: rest => observations first ++ childObservations rest
end

theorem childObservations_append (first last : List (Dictionary roles)) :
    childObservations (first ++ last) = childObservations first ++ childObservations last := by
  induction first with
  | nil => rfl
  | cons first rest ih => simp only [List.cons_append, childObservations, ih, List.append_assoc]

theorem childObservations_flatten (children : List (Dictionary roles)) :
    childObservations children = (children.map observations).flatten := by
  induction children with
  | nil => rfl
  | cons first rest ih => simp only [childObservations, List.map_cons, List.flatten_cons, ih]

/-- Every source obligation/declaration occurrence is retained, with multiplicity.
This is an invariant, not a converse characterization of tree equivalence. -/
theorem equivalent_observations (same : DictionaryEquivalent before after) :
    (observations before).Perm (observations after) := by
  induction same with
  | refl => exact .refl _
  | reorder occurrence key permuted =>
      apply List.Perm.cons
      rw [childObservations_flatten, childObservations_flatten]
      exact (permuted.map observations).flatten
  | replace occurrence key leading trailing same ih =>
      simp only [observations, childObservations_append, childObservations]
      exact .cons _ ((List.Perm.refl _).append (ih.append (List.Perm.refl _)))
  | symm _ ih => exact ih.symm
  | trans _ _ first last => exact first.trans last

def nodeCount (tree : Dictionary roles) : Nat := (observations tree).length

theorem equivalent_nodeCount (same : DictionaryEquivalent before after) :
    nodeCount before = nodeCount after := (equivalent_observations same).length_eq

/-- Tests may count any chosen source/declaration event, including repeated
identical demands. The event need not have a decidable equality instance. -/
theorem equivalent_eventCount (event : Occurrence roles × Nat → Bool)
    (same : DictionaryEquivalent before after) :
    (observations before).countP event = (observations after).countP event :=
  (equivalent_observations same).countP_eq event

/-- The independent instance relation must eventually check visibility, head
intervals, associated equations, and the exact multiset of generated children.
The parameter is intentionally visible, not a completed source implementation. -/
abbrev LocalInstance (roles : Roles.RoleDecls) :=
  Occurrence roles → Nat → List (Occurrence roles) → Prop

inductive Evidence (localRule : LocalInstance roles) : Dictionary roles → Prop where
  | node (nodeRule : localRule occurrence key (children.map Dictionary.root))
      (allChildren : ∀ child ∈ children, Evidence localRule child) :
      Evidence localRule (.node occurrence key children)

theorem evidence_node_iff (localRule : LocalInstance roles) (occurrence : Occurrence roles)
    (key : Nat) (children : List (Dictionary roles)) :
    Evidence localRule (.node occurrence key children) ↔
      localRule occurrence key (children.map Dictionary.root) ∧
        ∀ child ∈ children, Evidence localRule child := by
  constructor
  · intro h; cases h with | node nodeRule allChildren => exact ⟨nodeRule, allChildren⟩
  · rintro ⟨nodeRule, allChildren⟩; exact .node nodeRule allChildren

/-- Exactly the child-order premise needed for evidence transport. The source
semantics must prove it; the dictionary comparison does not assume a resolver. -/
def PermutationInvariant (localRule : LocalInstance roles) : Prop :=
  ∀ occurrence key first last, first.Perm last →
    (localRule occurrence key first ↔ localRule occurrence key last)

theorem evidence_replace (localRule : LocalInstance roles) (occurrence : Occurrence roles)
    (key : Nat) (leading trailing : List (Dictionary roles))
    (sameRoot : before.root = after.root)
    (child : Evidence localRule before → Evidence localRule after)
    (given : Evidence localRule (.node occurrence key (leading ++ before :: trailing))) :
    Evidence localRule (.node occurrence key (leading ++ after :: trailing)) := by
  rcases (evidence_node_iff ..).mp given with ⟨nodeRule, allChildren⟩
  apply Evidence.node
  · simpa only [List.map_append, List.map_cons, sameRoot] using nodeRule
  · intro tree member
    rcases List.mem_append.mp member with member | member
    · exact allChildren tree (List.mem_append_left _ member)
    · rcases List.mem_cons.mp member with rfl | member
      · exact child (allChildren before (List.mem_append_right _ (List.mem_cons_self)))
      · exact allChildren tree (List.mem_append_right _ (List.mem_cons_of_mem _ member))

theorem evidence_equivalent (localRule : LocalInstance roles)
    (order : PermutationInvariant localRule) (same : DictionaryEquivalent before after) :
    Evidence localRule before ↔ Evidence localRule after := by
  induction same with
  | refl => exact Iff.rfl
  | @reorder occurrence key before after permuted =>
      simp only [evidence_node_iff]
      constructor
      · rintro ⟨nodeRule, children⟩
        exact ⟨(order occurrence key _ _ (permuted.map Dictionary.root)).mp nodeRule,
          fun child member => children child (permuted.mem_iff.mpr member)⟩
      · rintro ⟨nodeRule, children⟩
        exact ⟨(order occurrence key _ _ (permuted.map Dictionary.root)).mpr nodeRule,
          fun child member => children child (permuted.mem_iff.mp member)⟩
  | @replace occurrence key leading trailing before after same ih =>
      exact ⟨evidence_replace localRule occurrence key leading trailing (equivalent_root same) ih.mp,
        evidence_replace localRule occurrence key leading trailing (equivalent_root same).symm ih.mpr⟩
  | symm _ ih => exact ih.symm
  | trans _ _ first last => exact first.trans last

/-- A concrete source-state property: every endpoint and associated-output target
of every retained demand has its required slot. It asserts no role applicability. -/
def Linked (state : State) (tree : Dictionary roles) : Prop :=
  Evidence (fun occurrence _ _ => GeneralSourceState.Linked state occurrence.demand) tree

theorem linked_equivalent (state : State) (same : DictionaryEquivalent before after) :
    Linked state before ↔ Linked state after :=
  evidence_equivalent _ (fun _ _ _ _ _ => Iff.rfl) same

theorem evidence_mono (first last : LocalInstance roles)
    (included : ∀ occurrence key children, first occurrence key children → last occurrence key children)
    (given : Evidence first tree) : Evidence last tree := by
  induction given with
  | node nodeRule children ih => exact .node (included _ _ _ nodeRule) ih

theorem linked_refines (refinement : Refines before after) (tree : Dictionary roles)
    (linked : Linked before tree) : Linked after tree :=
  evidence_mono _ _ (fun occurrence _ _ h =>
    GeneralSourceState.refinement_linked refinement occurrence.demand h) linked

/-- Source readback keeps the root occurrence and an entire indexed witness.
Equal erased key trees alone do not reconstruct this witness. -/
def Readback (occurrence : Occurrence roles)
    (payload : CommonRoleOutermostResolver.Dictionary) (tree : Dictionary roles) : Prop :=
  tree.root = occurrence ∧ erase tree = payload

def ErasedEvidence (localRule : LocalInstance roles) (occurrence : Occurrence roles)
    (payload : CommonRoleOutermostResolver.Dictionary) : Prop :=
  ∃ tree, Readback occurrence payload tree ∧ Evidence localRule tree

theorem erase_evidence (localRule : LocalInstance roles) (tree : Dictionary roles)
    (given : Evidence localRule tree) : ErasedEvidence localRule tree.root (erase tree) :=
  ⟨tree, ⟨rfl, rfl⟩, given⟩

/-- Distinct source obligations cannot be collapsed merely because their demands
or erased runtime payloads agree. This statement quantifies every source demand. -/
theorem erase_forgets_occurrence (demand : Demand roles) (first last key : Nat)
    (distinct : first ≠ last) :
    let left : Dictionary roles := .node ⟨first, demand⟩ key []
    let right : Dictionary roles := .node ⟨last, demand⟩ key []
    erase left = erase right ∧ ¬ DictionaryEquivalent left right := by
  dsimp
  refine ⟨rfl, ?_⟩
  intro same
  have roots := equivalent_root same
  exact distinct (congrArg Occurrence.identity roots)

end Yulang.GeneralSourceDictionaries
