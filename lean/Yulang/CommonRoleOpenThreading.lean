import Yulang.CommonRoleOpenState

/-! Stateful ordered child execution. This driver regenerates each child from
its predecessor's returned state, then regenerates all siblings and the parent
from the final state. It does not assert that the final frontiers equal their
initial snapshots. Source scheduling and fixed-point adequacy are separate. -/
namespace Yulang.CommonRoleOpenThreading
open CommonRoleSettledConstraints (State)
open CommonRoleCandidateConstraints (Bindings Compatible)
open Core.PresenceGeneration (Comp)
open PresenceNormalForm (All)

/-- A child's result includes its actual new state, not an update supplied
in advance by the caller of `thread`. -/
def thread (run : α → State n → β × State n) : List α → State n → List β × State n
  | [], s => ([], s)
  | child :: rest, s =>
      let (result, next) := run child s
      let (results, final) := thread run rest next
      (result :: results, final)

/-- A relational state-threading specification. Each child receives exactly
the state returned by its immediate predecessor, including all prior facts. -/
inductive Thread (Step : α → State n → β → State n → Prop) :
    List α → State n → List β → State n → Prop where
  | nil : Thread Step [] s [] s
  | cons : Step child s result next → Thread Step rest next results final →
      Thread Step (child :: rest) s (result :: results) final

theorem thread_exact (run : α → State n → β × State n)
    (Step : α → State n → β → State n → Prop)
    (exact : ∀ child s result next, run child s = (result, next) ↔ Step child s result next)
    (children : List α) (s : State n) (results : List β) (final : State n) :
    thread run children s = (results, final) ↔ Thread Step children s results final := by
  induction children generalizing s results final with
  | nil =>
      constructor
      · intro h; cases h; exact .nil
      · intro h; cases h; rfl
  | cons child rest ih =>
      cases first : run child s with
      | mk result next =>
          cases last : thread run rest next with
          | mk tail endState =>
              constructor
              · intro h
                simp only [thread, first, last, Prod.mk.injEq] at h
                obtain ⟨rfl, rfl⟩ := h
                exact .cons ((exact child s result next).mp first)
                  ((ih next tail endState).mp last)
              · intro h
                cases h with
                | cons one more =>
                    have oneEq := (exact ..).mpr one
                    rw [first] at oneEq
                    cases oneEq
                    have moreEq := (ih ..).mpr more
                    simp only [thread, first, moreEq]

structure Trace (α β γ : Type) (n : Nat) where
  children : List α
  outputs : List β
  state : State n
  refreshed : List γ
  parent : γ

/-- Children are discovered by the parent producer, each is regenerated by
`run` with its current state, then ALL siblings and the parent are produced
again with the final state. No fixed update list is an input. -/
def drive (children : α → State n → List α)
    (produce : α → State n → γ) (run : α → State n → β × State n)
    (parent : α) (s : State n) : Trace α β γ n :=
  let cs := children parent s
  let (outputs, final) := thread run cs s
  ⟨cs, outputs, final, cs.map (fun child => produce child final), produce parent final⟩

/-- Independent boundary: a source child rule and a child evaluation rule,
followed by final-state regeneration of every sibling and the parent. -/
structure Driven (Children : α → State n → List α → Prop)
    (Produce : α → State n → γ → Prop)
    (Step : α → State n → β → State n → Prop)
    (parent : α) (s : State n) (trace : Trace α β γ n) : Prop where
  children : Children parent s trace.children
  evaluated : Thread Step trace.children s trace.outputs trace.state
  refreshed : CommonRoleOutermostResolver.All₂ (fun child observation => Produce child trace.state observation)
    trace.children trace.refreshed
  parent : Produce parent trace.state trace.parent

theorem refresh_exact (produce : α → State n → γ)
    (Produce : α → State n → γ → Prop)
    (exact : ∀ child s result, produce child s = result ↔ Produce child s result)
    (children : List α) (s : State n) (observations : List γ) :
    children.map (fun child => produce child s) = observations ↔
      CommonRoleOutermostResolver.All₂ (fun child observation => Produce child s observation) children observations := by
  induction children generalizing observations with
  | nil =>
      constructor
      · intro h; cases h; exact .nil
      · intro h; cases h; rfl
  | cons child rest ih =>
      constructor
      · intro h
        subst observations
        exact .cons ((exact ..).mp rfl) ((ih _).mp rfl)
      · intro h
        cases h with
        | cons head tail =>
          simp only [List.map_cons, (exact ..).mpr head, (ih _).mpr tail]

/-- Conditional generic theorem, not a source resolve theorem. Concrete
instantiations must supply and prove the three named bridge theorems. -/
theorem drive_exact (children : α → State n → List α)
    (produce : α → State n → γ) (run : α → State n → β × State n)
    (Children : α → State n → List α → Prop)
    (Produce : α → State n → γ → Prop)
    (Step : α → State n → β → State n → Prop)
    (childrenExact : ∀ parent s cs, children parent s = cs ↔ Children parent s cs)
    (produceExact : ∀ child s result, produce child s = result ↔ Produce child s result)
    (runExact : ∀ child s result next, run child s = (result, next) ↔ Step child s result next)
    (parent : α) (s : State n) (trace : Trace α β γ n) :
    drive children produce run parent s = trace ↔ Driven Children Produce Step parent s trace := by
  constructor
  · rintro rfl
    simp only [drive]
    cases computed : thread run (children parent s) s with
    | mk outputs final =>
      exact ⟨(childrenExact ..).mp rfl, (thread_exact run Step runExact ..).mp computed,
        (refresh_exact produce Produce produceExact ..).mp rfl, (produceExact ..).mp rfl⟩
  · intro h
    cases trace with
    | mk cs outputs final refreshed parentResult =>
      obtain ⟨a, b, c, d⟩ := h
      have csEq := (childrenExact ..).mpr a
      have threadEq := (thread_exact run Step runExact ..).mpr b
      have refreshEq := (refresh_exact produce Produce produceExact ..).mpr c
      have parentEq := (produceExact ..).mpr d
      simp only [drive, csEq, threadEq, refreshEq, parentEq]

/-- Literal preservation follows from each actual child transition. -/
theorem thread_preserves (Step : α → State n → β → State n → Prop)
    (preserves : ∀ child s result next, Step child s result next →
      ∀ assignment, All Common.model assignment next.atoms → All Common.model assignment s.atoms)
    (derivation : Thread Step children s results final)
    (assignment : Fin n → Comp Common.model)
    (model : All Common.model assignment final.atoms) : All Common.model assignment s.atoms := by
  induction derivation with
  | nil => exact model
  | cons one _ ih => exact preserves _ _ _ _ one assignment (ih model)

/-- Reordering a fixed set of actual captures changes neither the original
models nor the added compatibility constraints. This is not a theorem that
an arbitrary state-dependent producer emits the same updates in any order. -/
theorem recollect_models_permutation (s : State n) (first last : List (Bindings n))
    (permutation : first.Perm last) (assignment : Fin n → Comp Common.model) :
    All Common.model assignment (CommonRoleOpenState.recollect s first).atoms ↔
      All Common.model assignment (CommonRoleOpenState.recollect s last).atoms := by
  simp only [CommonRoleOpenState.recollect_models]
  exact and_congr Iff.rfl (forall_congr' fun binding => imp_congr (permutation.mem_iff) Iff.rfl)

end Yulang.CommonRoleOpenThreading
