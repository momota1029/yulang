import Yulang.SolvedRecursiveRows
import Yulang.SemilinearRowQuotient
import Yulang.StructuralRowTraversal

/-!
# Ground type decisions from original recursive row constraints

Each row position in the finite type names a slot in the original recursive
row problem. Resolution traverses exactly these positions, summarizes their
least rows, and compares the resulting types modulo exact row meaning.
Successful Boolean answers characterize the existing structural subtype
relation over the original `RecursiveRows.Derives` sets in both directions.

This is a total adapter with an explicit unsupported result for guarded row
problems outside the current summary algorithm. Row-free types need no row
summaries at all. It does not solve unknown value-type bounds, recursive value
types, or existentially quantified constraints generated by an expression.
-/

namespace Yulang.SolvedRecursiveTypes

open StructuralBase StructuralRowResolution

variable {n : Nat} {Key Slot OtherSlot : Type}

def meaning (problem : RecursiveRows.Problem n Key Slot) (type : Ty Slot) :
    Ty (RecursiveRows.SetRow n Key) := mapRows (RecursiveRows.Derives problem) type

def resolveRow [DecidableEq Key] [DecidableEq Slot]
    (problem : RecursiveRows.Problem n Key Slot) (slot : Slot) :
    Option (SemilinearRowQuotient.Row n Key) :=
  (SolvedRecursiveRows.summarize problem slot).map SemilinearRowQuotient.encode

theorem resolveRow_exact [DecidableEq Key] [DecidableEq Slot]
    (problem : RecursiveRows.Problem n Key Slot) (slot : Slot)
    (resolved : SemilinearRowQuotient.Row n Key)
    (returned : resolveRow problem slot = some resolved) :
    SemilinearRowQuotient.decode resolved = RecursiveRows.Derives problem slot := by
  obtain ⟨code, summarized, rfl⟩ := Option.map_eq_some_iff.mp returned
  exact SolvedRecursiveRows.summarize_decode problem slot code summarized

def resolve [DecidableEq Key] [DecidableEq Slot]
    (problem : RecursiveRows.Problem n Key Slot) (type : Ty Slot) :
    Option (SemilinearRowQuotient.GroundType n Key) := traverseRows (resolveRow problem) type

theorem resolve_exact [DecidableEq Key] [DecidableEq Slot]
    (problem : RecursiveRows.Problem n Key Slot) (type : Ty Slot)
    (resolved : SemilinearRowQuotient.GroundType n Key)
    (returned : resolve problem type = some resolved) :
    SemilinearRowQuotient.decodeType resolved = meaning problem type :=
  traverseRows_exact (resolveRow problem) SemilinearRowQuotient.decode
    (RecursiveRows.Derives problem) (resolveRow_exact problem) type resolved returned

def Supported [DecidableEq Key] (problem : RecursiveRows.Problem n Key Slot) (type : Ty Slot) : Prop :=
  ∀ slot ∈ rows type, ∀ key ∈ SolvedRecursiveRows.keys problem,
    GuardedRowErasure.Harmless (CertifiedRowSummaries.normalizedProblem key problem) key

theorem resolve_supported_iff [DecidableEq Key] [DecidableEq Slot]
    (problem : RecursiveRows.Problem n Key Slot) (type : Ty Slot) :
    (∃ resolved, resolve problem type = some resolved) ↔ Supported problem type := by
  rw [resolve, traverseRows_supported_iff]
  apply forall_congr'
  intro slot
  apply forall_congr'
  intro _
  rw [← SolvedRecursiveRows.summarize_supported_iff problem slot]
  simp only [resolveRow, Option.map_eq_some_iff]
  constructor
  · rintro ⟨_, code, summarized, _⟩
    exact ⟨code, summarized⟩
  · rintro ⟨code, summarized⟩
    exact ⟨_, code, summarized, rfl⟩

theorem row_free_supported [DecidableEq Key] (problem : RecursiveRows.Problem n Key Slot)
    (type : Ty Slot) (rowFree : rows type = []) : Supported problem type := by
  intro slot member
  simp [rowFree] at member

def querySubtype [DecidableEq Key] [DecidableEq Slot] [DecidableEq OtherSlot]
    (left : RecursiveRows.Problem n Key Slot) (right : RecursiveRows.Problem n Key OtherSlot)
    (source : Ty Slot) (target : Ty OtherSlot) : Option Bool :=
  (resolve left source).bind fun resolvedSource =>
  (resolve right target).bind fun resolvedTarget =>
  some (SemilinearRowQuotient.checkType resolvedSource resolvedTarget)

theorem querySubtype_exact [DecidableEq Key] [DecidableEq Slot] [DecidableEq OtherSlot]
    (left : RecursiveRows.Problem n Key Slot) (right : RecursiveRows.Problem n Key OtherSlot)
    (source : Ty Slot) (target : Ty OtherSlot) (answer : Bool)
    (returned : querySubtype left right source target = some answer) :
    answer = true ↔ Subtype (RecursiveRows.algebra n Key).le
      (meaning left source) (meaning right target) := by
  simp only [querySubtype, Option.bind_eq_some_iff, Option.some.injEq] at returned
  obtain ⟨resolvedSource, first, resolvedTarget, second, rfl⟩ := returned
  rw [SemilinearRowQuotient.checkType_exact,
    resolve_exact left source resolvedSource first, resolve_exact right target resolvedTarget second]

theorem querySubtype_rejects [DecidableEq Key] [DecidableEq Slot] [DecidableEq OtherSlot]
    (left : RecursiveRows.Problem n Key Slot) (right : RecursiveRows.Problem n Key OtherSlot)
    (source : Ty Slot) (target : Ty OtherSlot) (answer : Bool)
    (returned : querySubtype left right source target = some answer) :
    answer = false ↔ ¬ Subtype (RecursiveRows.algebra n Key).le
      (meaning left source) (meaning right target) := by
  rw [← Bool.not_eq_true, querySubtype_exact left right source target answer returned]

theorem querySubtype_supported_iff [DecidableEq Key] [DecidableEq Slot] [DecidableEq OtherSlot]
    (left : RecursiveRows.Problem n Key Slot) (right : RecursiveRows.Problem n Key OtherSlot)
    (source : Ty Slot) (target : Ty OtherSlot) :
    (∃ answer, querySubtype left right source target = some answer) ↔
      Supported left source ∧ Supported right target := by
  simp only [querySubtype, Option.bind_eq_some_iff, Option.some.injEq,
    ← resolve_supported_iff]
  constructor
  · rintro ⟨_, resolvedSource, first, resolvedTarget, second, _⟩
    exact ⟨⟨resolvedSource, first⟩, ⟨resolvedTarget, second⟩⟩
  · rintro ⟨⟨resolvedSource, first⟩, ⟨resolvedTarget, second⟩⟩
    exact ⟨_, resolvedSource, first, resolvedTarget, second, rfl⟩

def queryEquivalent [DecidableEq Key] [DecidableEq Slot] [DecidableEq OtherSlot]
    (left : RecursiveRows.Problem n Key Slot) (right : RecursiveRows.Problem n Key OtherSlot)
    (source : Ty Slot) (target : Ty OtherSlot) : Option Bool :=
  (resolve left source).bind fun resolvedSource =>
  (resolve right target).bind fun resolvedTarget =>
  some (SemilinearRowQuotient.checkType resolvedSource resolvedTarget &&
    SemilinearRowQuotient.checkType resolvedTarget resolvedSource)

theorem queryEquivalent_exact [DecidableEq Key] [DecidableEq Slot] [DecidableEq OtherSlot]
    (left : RecursiveRows.Problem n Key Slot) (right : RecursiveRows.Problem n Key OtherSlot)
    (source : Ty Slot) (target : Ty OtherSlot) (answer : Bool)
    (returned : queryEquivalent left right source target = some answer) :
    answer = true ↔
      Subtype (RecursiveRows.algebra n Key).le (meaning left source) (meaning right target) ∧
      Subtype (RecursiveRows.algebra n Key).le (meaning right target) (meaning left source) := by
  simp only [queryEquivalent, Option.bind_eq_some_iff, Option.some.injEq] at returned
  obtain ⟨resolvedSource, first, resolvedTarget, second, rfl⟩ := returned
  rw [Bool.and_eq_true, SemilinearRowQuotient.checkType_exact,
    SemilinearRowQuotient.checkType_exact,
    resolve_exact left source resolvedSource first, resolve_exact right target resolvedTarget second]

end Yulang.SolvedRecursiveTypes
