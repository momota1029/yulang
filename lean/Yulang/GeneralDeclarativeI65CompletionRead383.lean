import Yulang.GeneralDeclarativeI65FiniteCompletion383
import Yulang.GeneralDeclarativeK2Alias321
import Yulang.GeneralDeclarativeGraphRows321

set_option backward.isDefEq.respectTransparency false
namespace Yulang.GeneralDeclarativeI65

open CommonRoleOutermostResolver (Dictionary)
open GeneralDeclarativeHead320 (Equation)
open GeneralSourceState (Output)
open GeneralDeclarativeK2Alias321 (AliasCycle)
open GeneralDeclarativeGraphRows321 (observed)

abbrev DirectEquation383 := State → Equation → Prop
abbrev LogicalOutputEquation383 := State → Request → Dictionary → Nat → Equation → Prop

/-- A request/output occurrence in the declarative source, not a
physical emitter address. The final field is the independent
source-equation relation; equality of targets alone does not
establish that an equation was generated by this declaration. -/
structure LogicalOutputLink383 (source : LogicalOutputEquation383) (s : State)
    (producer : Request) (d : Dictionary) (ordinal : Nat) (row : Equation) where
  requested : Output
  actual : producer.demand.outputs[ordinal]? = some requested
  target : row.left = requested.target
  equation : source s producer d ordinal row

/-- Read evidence asks for an actual source equation or a finite
selected proof of its exact logical producing request, in the very
same state. It has no stamp, version, physical slot or release flag.
The full graph is not restricted to rows with such evidence. -/
inductive SourceEquationRead383 (rules : SelectedSourceRule383)
    (direct : DirectEquation383) (generated : LogicalOutputEquation383) (s : State) :
    Equation → Type where
  | written {row : Equation} : direct s row → row ∈ s.current.ordinary.equations →
      SourceEquationRead383 rules direct generated s row
  | output {row : Equation} (producer : Request) (d : Dictionary) (ordinal : Nat) :
      SelectedSourceProof383 rules s producer d →
      LogicalOutputLink383 generated s producer d ordinal row →
      row ∈ s.current.ordinary.equations → SourceEquationRead383 rules direct generated s row

theorem source_read_output_needs_finite_selection383
    {rules : SelectedSourceRule383} {direct : DirectEquation383}
    {generated : LogicalOutputEquation383} {s : State} {row : Equation}
    (read : SourceEquationRead383 rules direct generated s row) (notWritten : ¬direct s row) :
    ∃ producer d ordinal, FiniteCompleted383 rules s producer ∧
      Nonempty (LogicalOutputLink383 generated s producer d ordinal row) := by
  cases read with
  | written yes _ => exact (notWritten yes).elim
  | output producer d ordinal proof equation _ =>
    exact ⟨producer,d,ordinal,⟨d,⟨proof⟩⟩,⟨equation⟩⟩

theorem circular_only_equation_is_not_a_read383
    {rules : SelectedSourceRule383} {direct : DirectEquation383}
    {generated : LogicalOutputEquation383} {s : State} {row : Equation}
    (closed : Request → Prop)
    (closedBy : ∀ q deps key kids, rules s q deps key kids → closed q →
      (∃ p ∈ deps,closed p) ∨ (∃ k ∈ kids,closed k))
    (notWritten : ¬direct s row)
    (noExternal : ∀ producer d ordinal, LogicalOutputLink383 generated s producer d ordinal row → closed producer) :
    ¬Nonempty (SourceEquationRead383 rules direct generated s row) := by
  rintro ⟨read⟩
  cases read with
  | written yes _ => exact notWritten yes
  | output producer d ordinal proof equation _ =>
    exact no_finite_circular_completion383 closed closedBy proof (noExternal producer d ordinal equation)

/-- Root K2 is tested against the original ordinary graph, not
against the set of equations with a completed producing request. -/
def RootCycle383 (s : State) (q : Request) : Prop :=
  ∃ a ∈ q.demand.arguments,
    AliasCycle s.current.ordinary (observed s.current.ordinary) a.lower

inductive EntryStep383 where
  | rootK2
  | pending
  | inspect

/-- Exact I-59 root precedence only. The proposition `inputReady`
is the actual lower-read readiness on the final snapshot; producing
that proposition and identifying candidate-local visited K2 sites
are separate source proof obligations. This is not Classifies. -/
inductive RootEntry383 (s : State) (q : Request) (inputReady : Prop) : EntryStep383 → Prop where
  | root (cycle : RootCycle383 s q) : RootEntry383 s q inputReady .rootK2
  | pending (safe : ¬RootCycle383 s q) (unsupported : ¬inputReady) : RootEntry383 s q inputReady .pending
  | inspect (safe : ¬RootCycle383 s q) (known : inputReady) : RootEntry383 s q inputReady .inspect

theorem root_k2_precedes_unready_input383 {s : State} {q : Request} {inputReady : Prop}
    (cycle : RootCycle383 s q) {result : EntryStep383} (entry : RootEntry383 s q inputReady result) :
    result = .rootK2 := by
  cases entry with
  | root _ => rfl
  | pending notCycle _ => exact (notCycle cycle).elim
  | inspect notCycle _ => exact (notCycle cycle).elim

theorem no_inspection_without_finite_supported_input383 {s : State} {q : Request} {inputReady : Prop}
    (unsupported : ¬inputReady) (inspect : RootEntry383 s q inputReady .inspect) :
    False := by
  cases inspect with
  | inspect _ ready => exact unsupported ready

end Yulang.GeneralDeclarativeI65
