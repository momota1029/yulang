YULANG_AUDIT_BEGIN YulangClosure.PaperTypes.PaperResumeExecution.resume_erasure
@YulangClosure.PaperTypes.PaperResumeExecution.resume_erasure : ∀ {d : YulangClosure.PaperTypes.DeclarationTable}
  {controlBinder binder : YulangClosure.PaperTypes.TermName} {body : YulangClosure.PaperTypes.Computation}
  {response : YulangClosure.PaperTypes.Value} {next : YulangClosure.PaperTypes.Computation}
  {stack : List YulangClosure.PaperTypes.Computation},
  YulangClosure.PaperTypes.PaperResumeExecution.resumeStep
        (YulangClosure.PaperTypes.Computation.resume (YulangClosure.PaperTypes.Value.continuation [] binder body)
          response) =
      Option.some next →
    YulangClosure.PaperTypes.PaperResumeExecution.ComputationStep d controlBinder
      (YulangClosure.PaperTypes.PaperCoreControl.erase
        {
          head :=
            YulangClosure.PaperTypes.Computation.resume (YulangClosure.PaperTypes.Value.continuation [] binder body)
              response,
          stack := stack })
      (YulangClosure.PaperTypes.PaperCoreControl.erase { head := next, stack := stack })
