@YulangClosure.PaperTypes.PaperResumeExecution.trace_erasure : ∀ {d : YulangClosure.PaperTypes.DeclarationTable}
  {controlBinder : YulangClosure.PaperTypes.TermName} {first last : YulangClosure.PaperTypes.PaperCoreControl.State},
  YulangClosure.PaperTypes.PaperPerformLetExecution.Trace d controlBinder first last →
    YulangClosure.PaperTypes.PaperResumeExecution.ErasureTrace d controlBinder
      (YulangClosure.PaperTypes.PaperCoreControl.erase first) (YulangClosure.PaperTypes.PaperCoreControl.erase last)
