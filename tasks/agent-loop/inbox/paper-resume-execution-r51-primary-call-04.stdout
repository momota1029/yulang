  (binder : YulangClosure.PaperTypes.TermName),
  YulangClosure.PaperTypes.PaperResumeExecution.resumeStep
      (YulangClosure.PaperTypes.Computation.resume
        (YulangClosure.PaperTypes.Value.continuation [] binder
          ((YulangClosure.PaperTypes.Computation.ret (YulangClosure.PaperTypes.Value.variable 0)).letE
