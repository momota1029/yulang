YULANG_AUDIT_BEGIN YulangClosure.PaperTypes.PaperResumeExecution.resume_prefix
@YulangClosure.PaperTypes.PaperResumeExecution.resume_prefix : ∀ {d : YulangClosure.PaperTypes.DeclarationTable}
  {g : YulangClosure.PaperTypes.GraphEnvironment} {e : YulangClosure.PaperTypes.TypeEnvironment}
  {binder : YulangClosure.PaperTypes.TermName} {body : YulangClosure.PaperTypes.Computation}
  {response : YulangClosure.PaperTypes.Value} {next : YulangClosure.PaperTypes.Computation}
  {q a : YulangClosure.PaperTypes.Ty} {stack : List YulangClosure.PaperTypes.Computation}
  {result : YulangClosure.PaperTypes.Ty} {controlBinder : YulangClosure.PaperTypes.TermName}
  {last : YulangClosure.PaperTypes.PaperCoreControl.State},
  YulangClosure.PaperTypes.PaperContinuationTyped d g e (YulangClosure.PaperTypes.Value.continuation [] binder body) q
      a →
    YulangClosure.PaperTypes.PaperValueTyped d g e response q →
      YulangClosure.PaperTypes.PaperCoreControl.StackTyped d g e stack a result →
        YulangClosure.PaperTypes.PaperResumeExecution.resumeStep
              (YulangClosure.PaperTypes.Computation.resume (YulangClosure.PaperTypes.Value.continuation [] binder body)
                response) =
            Option.some next →
          YulangClosure.PaperTypes.PaperPerformLetExecution.Trace d controlBinder { head := next, stack := stack }
              last →
            YulangClosure.PaperTypes.PaperCoreControl.StateTyped d g e last result ∧
              YulangClosure.PaperTypes.PaperComputationTyped d g e
                  (YulangClosure.PaperTypes.PaperCoreControl.erase last) result ∧
                YulangClosure.PaperTypes.PaperResumeExecution.ErasureTrace d controlBinder
                  (YulangClosure.PaperTypes.PaperCoreControl.erase
                    {
                      head :=
                        YulangClosure.PaperTypes.Computation.resume
                          (YulangClosure.PaperTypes.Value.continuation [] binder body) response,
                      stack := stack })
                  (YulangClosure.PaperTypes.PaperCoreControl.erase last)
