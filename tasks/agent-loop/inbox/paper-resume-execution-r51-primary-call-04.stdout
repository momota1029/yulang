YULANG_AUDIT_BEGIN YulangClosure.PaperTypes.PaperResumeExecution.perform_through_stack_resumable
@YulangClosure.PaperTypes.PaperResumeExecution.perform_through_stack_resumable : ∀
  {d : YulangClosure.PaperTypes.DeclarationTable} {g : YulangClosure.PaperTypes.GraphEnvironment}
  {e : YulangClosure.PaperTypes.TypeEnvironment} {declaration : YulangClosure.PaperTypes.OperationDeclaration}
  {operation : YulangClosure.PaperTypes.DeclarationId} {arguments : List YulangClosure.PaperTypes.Ty}
  {payload : YulangClosure.PaperTypes.Value} {binder : YulangClosure.PaperTypes.TermName}
  {stack : List YulangClosure.PaperTypes.Computation} {a : YulangClosure.PaperTypes.Ty},
  YulangClosure.PaperTypes.OperationDeclarationResolved d.operations operation declaration →
    arguments.length = declaration.typeArity →
      YulangClosure.PaperTypes.PaperValueTyped d g e payload (declaration.instantiate arguments).payloadType →
        YulangClosure.PaperTypes.PaperCoreControl.StackTyped d g e stack
            (declaration.instantiate arguments).responseType a →
          ∃ saved,
            YulangClosure.PaperTypes.PaperPerformLetExecution.performStep d binder
                  (YulangClosure.PaperTypes.Computation.perform operation arguments payload) =
                Option.some
                  (YulangClosure.PaperTypes.Computation.request (declaration.instantiate arguments) payload
                    (YulangClosure.PaperTypes.Value.continuation [] binder
                      (YulangClosure.PaperTypes.Computation.ret (YulangClosure.PaperTypes.Value.variable 0)))) ∧
              YulangClosure.PaperTypes.PaperPerformLetExecution.RequestTrace
                  {
                    head :=
                      YulangClosure.PaperTypes.Computation.request (declaration.instantiate arguments) payload
                        (YulangClosure.PaperTypes.Value.continuation [] binder
                          (YulangClosure.PaperTypes.Computation.ret (YulangClosure.PaperTypes.Value.variable 0))),
                    stack := stack }
                  {
                    head :=
                      YulangClosure.PaperTypes.Computation.request (declaration.instantiate arguments) payload
                        (YulangClosure.PaperTypes.Value.continuation [] binder saved),
                    stack := [] } ∧
                YulangClosure.PaperTypes.PaperComputationTyped d g e
                    (YulangClosure.PaperTypes.Computation.request (declaration.instantiate arguments) payload
                      (YulangClosure.PaperTypes.Value.continuation [] binder saved))
                    a ∧
                  YulangClosure.PaperTypes.PaperContinuationTyped d g e
                      (YulangClosure.PaperTypes.Value.continuation [] binder saved)
                      (declaration.instantiate arguments).responseType a ∧
                    ∀ (response : YulangClosure.PaperTypes.Value),
                      YulangClosure.PaperTypes.PaperValueTyped d g e response
                          (declaration.instantiate arguments).responseType →
                        ∃ next,
                          YulangClosure.PaperTypes.PaperResumeExecution.resumeStep
                                (YulangClosure.PaperTypes.Computation.resume
                                  (YulangClosure.PaperTypes.Value.continuation [] binder saved) response) =
                              Option.some next ∧
                            YulangClosure.PaperTypes.PaperComputationTyped d g e next a
'YulangClosure.PaperTypes.PaperResumeExecution.perform_through_stack_resumable' depends on axioms: [propext, Quot.sound]
YULANG_AUDIT_END YulangClosure.PaperTypes.PaperResumeExecution.perform_through_stack_resumable
