YulangClosure.PaperTypes.PaperResumeExecution.distinct_response_result : ∀
  (d : YulangClosure.PaperTypes.DeclarationTable) (g : YulangClosure.PaperTypes.GraphEnvironment)
  (e : YulangClosure.PaperTypes.TypeEnvironment) (binder : YulangClosure.PaperTypes.TermName),
  YulangClosure.PaperTypes.PaperContinuationTyped d g e
      (YulangClosure.PaperTypes.Value.continuation [] binder
        (YulangClosure.PaperTypes.Computation.ret
          (YulangClosure.PaperTypes.Value.literal (YulangClosure.PaperTypes.Literal.boolean Bool.true))))
      (YulangClosure.PaperTypes.Ty.base YulangClosure.PaperTypes.Base.int)
      (YulangClosure.PaperTypes.Ty.base YulangClosure.PaperTypes.Base.bool) ∧
    YulangClosure.PaperTypes.PaperValueTyped d g e
        (YulangClosure.PaperTypes.Value.literal (YulangClosure.PaperTypes.Literal.integer 7))
        (YulangClosure.PaperTypes.Ty.base YulangClosure.PaperTypes.Base.int) ∧
      YulangClosure.PaperTypes.PaperResumeExecution.resumeStep
            (YulangClosure.PaperTypes.Computation.resume
