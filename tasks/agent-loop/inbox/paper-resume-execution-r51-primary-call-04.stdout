  {controlBinder : YulangClosure.PaperTypes.TermName} {head next : YulangClosure.PaperTypes.Computation},
  YulangClosure.PaperTypes.PaperResumeExecution.ComputationStep d controlBinder head next →
    ∀ (stack : List YulangClosure.PaperTypes.Computation),
      YulangClosure.PaperTypes.PaperResumeExecution.ComputationStep d controlBinder
