+    fn expected_effect_port_visits(annotation: &SourceAnnotation) -> Vec<(Vec<FormalPortStep>, Option<SourceEffectRow>, Polarity)> {
+        fn visit(ty: &SourceAnnotationType, variance: Polarity, path: &mut Vec<FormalPortStep>, ports: &mut Vec<(Vec<FormalPortStep>, Option<SourceEffectRow>, Polarity)>) {
+            match &ty.value {
+                SourceAnnotationValue::Function { argument, result } => {
+                    let base = path.len();
+                    path.push(FormalPortStep::Argument);
+                    visit(argument, if variance == Polarity::Positive { Polarity::Negative } else { Polarity::Positive }, path, ports);
+                    path.truncate(base);
+                    path.push(FormalPortStep::Result);
+                    visit(result, variance, path, ports);
+                    path.truncate(base);
+                    path.push(FormalPortStep::Argument);
+                    ports.push((path.clone(), argument.effects.clone(), if variance == Polarity::Positive { Polarity::Negative } else { Polarity::Positive }));
+                    path.truncate(base);
+                    path.push(FormalPortStep::Result);
+                    ports.push((path.clone(), result.effects.clone(), variance));
+                    path.truncate(base);
+                }
+                SourceAnnotationValue::Tuple(elements) => {
+                    for (index, element) in elements.iter().enumerate() {
+                        let base = path.len();
+                        path.push(FormalPortStep::Element(index));
+                        visit(element, variance, path, ports);
+                        path.truncate(base);
+                    }
+                }
+                SourceAnnotationValue::Bool | SourceAnnotationValue::Str | SourceAnnotationValue::Int
+                | SourceAnnotationValue::Unit | SourceAnnotationValue::Variable(_) | SourceAnnotationValue::Hole(_) => {}
+            }
+        }
+        let mut ports = Vec::new();
+        visit(&annotation.ty, Polarity::Negative, &mut Vec::new(), &mut ports);
+        ports
+    }
