+    fn annotation_effect_tree(annotation: &SourceAnnotation) -> Vec<SourceEffectSite> {
+        fn visit(ty: &SourceAnnotationType, path: &mut Vec<FormalPortStep>, nodes: &mut Vec<SourceEffectSite>) {
+            nodes.push(SourceEffectSite { path: path.clone(), row: ty.effects.clone() });
+            match &ty.value {
+                SourceAnnotationValue::Function { argument, result } => {
+                    let base = path.len();
+                    path.push(FormalPortStep::Argument);
+                    visit(argument, path, nodes);
+                    path.truncate(base);
+                    path.push(FormalPortStep::Result);
+                    visit(result, path, nodes);
+                    path.truncate(base);
+                }
+                SourceAnnotationValue::Tuple(elements) => {
+                    for (index, element) in elements.iter().enumerate() {
+                        let base = path.len();
+                        path.push(FormalPortStep::Element(index));
+                        visit(element, path, nodes);
+                        path.truncate(base);
+                    }
+                }
+                SourceAnnotationValue::Bool
+                | SourceAnnotationValue::Str
