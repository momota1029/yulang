+    fn formal_permission_symbolic_effect_memo_trace_tolerates_missing_constructor_identity() {
+        // Two independently built sessions use distinct Term arenas. For this
+        // observer-isolation check, compare the same retained structure while
+        // erasing only the arena-brand digits; keep every term index so aliasing
+        // and row/domain shape remain part of the comparison.
+        fn without_term_arena_brands(debug: &str) -> String {
+            const PREFIX: &str = "TermArenaBrand(";
+            let mut normalized = String::with_capacity(debug.len());
+            let mut rest = debug;
+            while let Some(start) = rest.find(PREFIX) {
+                let (before, branded) = rest.split_at(start);
+                normalized.push_str(before);
+                normalized.push_str(PREFIX);
+                let digits_start = PREFIX.len();
+                let Some(close) = branded[digits_start..].find(')') else {
+                    normalized.push_str(&branded[digits_start..]);
+                    return normalized;
+                };
+                let digits = &branded[digits_start..digits_start + close];
+                if !digits.is_empty() && digits.bytes().all(|byte| byte.is_ascii_digit()) {
+                    normalized.push('_');
+                } else {
+                    normalized.push_str(digits);
+                }
+                normalized.push(')');
+                rest = &branded[digits_start + close + 1..];
+            }
+            normalized.push_str(rest);
+            normalized
+        }
+        fn observe(trace: bool) -> (String, Vec<FormalCaptureTypedEvent>) {
+            let text = "my f(pair:((int -> ['e] ()), (int -> ['e] ()))) = pair";
+            let mut session = make_session(text);
+            let action = session.batch.candidate_source.schedules.values().next().unwrap().iter()
+                .find(|action| matches!(action, candidate_source::Action::FormalAnnotation { .. })).unwrap().clone();
+            let candidate_source::Action::FormalAnnotation { annotation, parameter, occurrence, scope } = action else { unreachable!() };
+            if trace { formal_live_capture_trace_begin(); }
+
+            // Exercise the root/scoped memo route before any formal constructor
+            // guard is active, then visit both sibling source ports below.
+            let first = session.candidate_formal_effect_variable(&scope, "'e", 0).unwrap();
+            let second = session.candidate_formal_effect_variable(&scope, "'e", 0).unwrap();
+            assert_eq!(first, second);
+            session.with_route_transaction(|session| {
+                session.candidate_formal_annotation(&annotation, parameter, &occurrence, &scope)
+            }).unwrap();
+            let state = &session.candidate_graph.as_ref().unwrap().intrusion.effect_algebra;
+            let signature = format!("views={:?};memo={:?};domains={:?};permissions={:?};scratch={}",
+                state.views, state.annotation_effects, state.formal_domains, state.formal_permissions,
+                session.candidate_graph.as_ref().unwrap().scratch_bytes);
+            let events = if trace { formal_live_capture_trace_finish_all().1 } else { Vec::new() };
+            (signature, events)
+        }
+
+        let plain = observe(false);
+        let traced = observe(true);
+        assert_eq!(without_term_arena_brands(&plain.0), without_term_arena_brands(&traced.0),
+            "enabling the test observer leaves retained solver structure unchanged; only the independently allocated Term arena brand is ignored");
+        let root_events = traced.1.iter().filter(|event| matches!(event,
+            FormalCaptureTypedEvent::Memo { constructor: None, name, .. } if name.as_ref() == "'e")).count();
+        assert!(root_events >= 2, "the root memo miss and hit carry no fabricated constructor identity: {:#?}", traced.1);
+        let constructor_events = traced.1.iter().filter(|event| matches!(event,
+            FormalCaptureTypedEvent::Memo { constructor: Some(_), name, .. } if name.as_ref() == "'e")).count();
+        assert!(constructor_events >= 2, "the sibling formal visits remain attributed to their real constructor: {:#?}", traced.1);
+        let sibling_sites = traced.1.iter().filter_map(|event| match event {
+            FormalCaptureTypedEvent::FormalEffectSite { path, source_row: Some(_), .. } => Some(path),
+            _ => None,
+        }).collect::<Vec<_>>();
+        assert!(sibling_sites.iter().any(|path| path.ends_with(&[FormalPortStep::Element(0), FormalPortStep::Result])));
+        assert!(sibling_sites.iter().any(|path| path.ends_with(&[FormalPortStep::Element(1), FormalPortStep::Result])));
+    }
