YULANG_AUDIT_BEGIN YulangClosure.PaperTypes.PaperTupleSplitExecution.example_not_sequential
YulangClosure.PaperTypes.PaperTupleSplitExecution.example_not_sequential : have body :=
  YulangClosure.PaperTypes.Computation.ret (YulangClosure.PaperTypes.Value.variable 0);
have first := YulangClosure.PaperTypes.Value.literal (YulangClosure.PaperTypes.Literal.integer 7);
have last := YulangClosure.PaperTypes.Value.variable 0;
YulangClosure.PaperTypes.termSubstituteComputation
      (YulangClosure.PaperTypes.PaperTupleSplitExecution.tupleReplacement [first, last]
        YulangClosure.PaperTypes.Value.variable)
      body =
    Option.some (YulangClosure.PaperTypes.Computation.ret (YulangClosure.PaperTypes.Value.variable 0)) ∧
  (YulangClosure.PaperTypes.termSubstituteComputation (YulangClosure.PaperTypes.PaperCoreStep.singleReplacement last)
          body).bind
      (YulangClosure.PaperTypes.termSubstituteComputation
        (YulangClosure.PaperTypes.PaperCoreStep.singleReplacement first)) =
    Option.some
      (YulangClosure.PaperTypes.Computation.ret
        (YulangClosure.PaperTypes.Value.literal (YulangClosure.PaperTypes.Literal.integer 7)))
'YulangClosure.PaperTypes.PaperTupleSplitExecution.example_not_sequential' depends on axioms: [propext, Quot.sound]
YULANG_AUDIT_END YulangClosure.PaperTypes.PaperTupleSplitExecution.example_not_sequential
