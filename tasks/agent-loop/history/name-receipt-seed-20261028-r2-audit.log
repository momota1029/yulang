YULANG_AUDIT_BEGIN YulangClosure.OriginalNameReceiptSeed.receipt_constructor_fields
@YulangClosure.OriginalNameReceiptSeed.receipt_constructor_fields : ∀
  {s : YulangClosure.OriginalSourceInterpretation.Sorts} {View : Type}
  (readout : YulangClosure.OriginalSourceEnvironment.RuntimeReadout s View)
  (before : YulangClosure.OriginalSourceEnvironment.Decoded s View) (binder : YulangClosure.OriginalSource.Binder)
  (receipt : YulangClosure.OriginalSourceEnvironment.ReceiptData s View),
  (YulangClosure.OriginalSourceEnvironment.Decoded.runtime readout before binder
          (YulangClosure.OriginalSourceEnvironment.Runtime.receipt receipt)).active =
      before.active ∧
    (YulangClosure.OriginalSourceEnvironment.Decoded.runtime readout before binder
                (YulangClosure.OriginalSourceEnvironment.Runtime.receipt receipt)).assignment.event.fiber =
        before.assignment.event.fiber ∧
      (YulangClosure.OriginalSourceEnvironment.Decoded.runtime readout before binder
                  (YulangClosure.OriginalSourceEnvironment.Runtime.receipt receipt)).assignment.event.eta0 =
          before.assignment.event.eta0 ∧
        (YulangClosure.OriginalSourceEnvironment.Decoded.runtime readout before binder
                    (YulangClosure.OriginalSourceEnvironment.Runtime.receipt receipt)).assignment.event.current =
            receipt.after.configuration ∧
          (YulangClosure.OriginalSourceEnvironment.Decoded.runtime readout before binder
                      (YulangClosure.OriginalSourceEnvironment.Runtime.receipt receipt)).assignment.event.eta =
              readout.eta before.fixedFrames before.assignment.event binder
                (YulangClosure.OriginalSourceEnvironment.Runtime.receipt receipt) ∧
            (YulangClosure.OriginalSourceEnvironment.Decoded.runtime readout before binder
                      (YulangClosure.OriginalSourceEnvironment.Runtime.receipt receipt)).assignment.event.witness =
              readout.witness before.fixedFrames before.assignment.event binder
                (YulangClosure.OriginalSourceEnvironment.Runtime.receipt receipt)
