  {View : Type} (readout : YulangClosure.OriginalSourceEnvironment.RuntimeReadout s View)
  (before : YulangClosure.OriginalSourceEnvironment.Decoded s View) (binder : YulangClosure.OriginalSource.Binder)
  (invocation : YulangClosure.OriginalSourceEnvironment.Invocation s View),
