@YulangClosure.OriginalNameReceiptSeed.return_readback_iff : ∀ {b : YulangClosure.OriginalSourceInterpretation.Sorts}
  {D ViewData Rest Body View : Type}
  (readout :
    YulangClosure.OriginalSourceEnvironment.RuntimeReadout
      (YulangClosure.OriginalNameForceExtraction.S b D ViewData Rest Body View) View)
  (frames :
    List
      (YulangClosure.OriginalSource.Frame
        (YulangClosure.OriginalSourceEnvironment.Payload
          (YulangClosure.OriginalNameForceExtraction.S b D ViewData Rest Body View) View)))
  (before :
    YulangClosure.OriginalSourceInterpretation.Event
      (YulangClosure.OriginalNameForceExtraction.S b D ViewData Rest Body View))
  (parameter : YulangClosure.OriginalParameterWorld.Parameter)
  (views : YulangClosure.OriginalWorldReadout.ViewAssignment (YulangClosure.OriginalNameForceExtraction.Base b) Nat)
  (packet :
    YulangClosure.OriginalReturnWorld.Packet (YulangClosure.OriginalNameForceExtraction.Base b) D ViewData Rest Body
      View)
  (event :
    YulangClosure.OriginalSourceInterpretation.Event
      (YulangClosure.OriginalNameForceExtraction.S b D ViewData Rest Body View)),
  YulangClosure.OriginalReturnWorld.fields readout frames before parameter views packet =
      YulangClosure.OriginalNameEntryCorrespondence.eventFields event ↔
    packet.history = event.history ∧
      (readout.eta frames before (YulangClosure.OriginalFormalShared.returnBinder parameter)
              (YulangClosure.OriginalSourceEnvironment.Runtime.returnRebind
                (packet.outcome views parameter))).original =
          event.eta.original ∧
        (readout.witness frames before (YulangClosure.OriginalFormalShared.returnBinder parameter)
                (YulangClosure.OriginalSourceEnvironment.Runtime.returnRebind
                  (packet.outcome views parameter))).current =
            event.witness.current ∧
          readout.scope frames before (YulangClosure.OriginalFormalShared.returnBinder parameter)
                (YulangClosure.OriginalSourceEnvironment.Runtime.returnRebind (packet.outcome views parameter)) =
              event.scope ∧
            readout.authority frames before (YulangClosure.OriginalFormalShared.returnBinder parameter)
                  (YulangClosure.OriginalSourceEnvironment.Runtime.returnRebind (packet.outcome views parameter)) =
                event.authority ∧
              readout.incidence frames before (YulangClosure.OriginalFormalShared.returnBinder parameter)
                    (YulangClosure.OriginalSourceEnvironment.Runtime.returnRebind (packet.outcome views parameter)) =
                  event.incidence ∧
                readout.dictionary frames before (YulangClosure.OriginalFormalShared.returnBinder parameter)
                    (YulangClosure.OriginalSourceEnvironment.Runtime.returnRebind (packet.outcome views parameter)) =
                  event.dictionary
