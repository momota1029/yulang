YulangClosure.OriginalSource.LogicalOccurrencesR103.inventory_iff_lookup : ∀
  (index : YulangClosure.OriginalSource.LogicalOccurrencesR103.Index)
  (route : YulangClosure.OriginalSource.LogicalOccurrencesR103.Route)
  (occurrence : YulangClosure.OriginalSource.LogicalOccurrencesR103.Occurrence),
  (route, occurrence) ∈ YulangClosure.OriginalSource.LogicalOccurrencesR103.inventory index ↔
    YulangClosure.OriginalSource.LogicalOccurrencesR103.lookup index route = some occurrence
'YulangClosure.OriginalSource.LogicalOccurrencesR103.inventory_iff_lookup' depends on axioms: [propext, Quot.sound]
YulangClosure.OriginalSource.LogicalOccurrencesR103.encode_lookup : ∀
  (scope : List YulangClosure.OriginalSource.LogicalOccurrencesR103.ScopeFrame)
  (cursor : YulangClosure.OriginalSource.LogicalOccurrencesR103.Cursor)
  (route : YulangClosure.OriginalSource.LogicalOccurrencesR103.Route),
  YulangClosure.OriginalSource.LogicalOccurrencesR103.lookup
      (YulangClosure.OriginalSource.LogicalOccurrencesR103.encode scope cursor) route =
    YulangClosure.OriginalSource.LogicalOccurrencesR103.observe scope cursor route
'YulangClosure.OriginalSource.LogicalOccurrencesR103.encode_lookup' depends on axioms: [propext]
YulangClosure.OriginalSource.LogicalOccurrencesR103.observe_eq_follow : ∀
  (scope : List YulangClosure.OriginalSource.LogicalOccurrencesR103.ScopeFrame)
  (cursor : YulangClosure.OriginalSource.LogicalOccurrencesR103.Cursor)
  (route : YulangClosure.OriginalSource.LogicalOccurrencesR103.Route),
  YulangClosure.OriginalSource.LogicalOccurrencesR103.observe scope cursor route =
    (YulangClosure.OriginalSource.LogicalOccurrencesR103.follow scope cursor route).bind fun position =>
      YulangClosure.OriginalSource.LogicalOccurrencesR103.payload position.enclosing position.cursor
'YulangClosure.OriginalSource.LogicalOccurrencesR103.observe_eq_follow' depends on axioms: [propext]
YulangClosure.OriginalSource.LogicalOccurrencesR103.source_membership_iff : ∀
  (context : YulangClosure.OriginalSource.Context) {category : YulangClosure.OriginalSource.Category}
  (source : YulangClosure.OriginalSource.Source category)
  (scope : List YulangClosure.OriginalSource.LogicalOccurrencesR103.ScopeFrame)
  (route : YulangClosure.OriginalSource.LogicalOccurrencesR103.Route)
  (occurrence : YulangClosure.OriginalSource.LogicalOccurrencesR103.Occurrence),
  (route, occurrence) ∈ YulangClosure.OriginalSource.LogicalOccurrencesR103.sourceInventory context source scope ↔
    YulangClosure.OriginalSource.LogicalOccurrencesR103.observe scope
        (YulangClosure.OriginalSource.LogicalOccurrencesR103.Cursor.tree
          (YulangClosure.OriginalSource.sourceRules context source))
        route =
      some occurrence
