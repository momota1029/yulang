YulangClosure.OriginalSource.LogicalOccurrencesR103.source_provenance : ∀
  (context : YulangClosure.OriginalSource.Context) {category : YulangClosure.OriginalSource.Category}
  (source : YulangClosure.OriginalSource.Source category)
  (scope : List YulangClosure.OriginalSource.LogicalOccurrencesR103.ScopeFrame)
  (route : YulangClosure.OriginalSource.LogicalOccurrencesR103.Route)
  (occurrence : YulangClosure.OriginalSource.LogicalOccurrencesR103.Occurrence),
  (route, occurrence) ∈ YulangClosure.OriginalSource.LogicalOccurrencesR103.sourceInventory context source scope →
    ∃ binder body,
      YulangClosure.OriginalSource.LogicalOccurrencesR103.follow scope
            (YulangClosure.OriginalSource.LogicalOccurrencesR103.Cursor.tree
              (YulangClosure.OriginalSource.sourceRules context source))
            route =
          some
            { enclosing := occurrence.enclosing,
              cursor :=
                YulangClosure.OriginalSource.LogicalOccurrencesR103.Cursor.tree
                  (YulangClosure.OriginalSource.RuleTree.existsE binder body) } ∧
        YulangClosure.OriginalSource.LogicalOccurrencesR103.logicalKind binder.kind = true ∧
          occurrence.binder = binder ∧ occurrence.subtree = body
'YulangClosure.OriginalSource.LogicalOccurrencesR103.source_provenance' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
