YulangClosure.OriginalSource.LogicalOccurrencesR104.observe_eq_follow : ∀
  (scope : List YulangClosure.OriginalSource.LogicalOccurrencesR104.ScopeFrame)
  (cursor : YulangClosure.OriginalSource.LogicalOccurrencesR104.Cursor)
  (route : YulangClosure.OriginalSource.LogicalOccurrencesR104.Route),
  YulangClosure.OriginalSource.LogicalOccurrencesR104.observe scope cursor route =
    (YulangClosure.OriginalSource.LogicalOccurrencesR104.follow scope cursor route).bind fun position =>
      YulangClosure.OriginalSource.LogicalOccurrencesR104.payload position.enclosing position.cursor
