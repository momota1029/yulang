YulangClosure.OriginalSource.LogicalOccurrencesR104.source_provenance : ∀
  (context : YulangClosure.OriginalSource.Context) {category : YulangClosure.OriginalSource.Category}
  (source : YulangClosure.OriginalSource.Source category)
  (scope : List YulangClosure.OriginalSource.LogicalOccurrencesR104.ScopeFrame)
  (route : YulangClosure.OriginalSource.LogicalOccurrencesR104.Route)
  (occurrence : YulangClosure.OriginalSource.LogicalOccurrencesR104.Occurrence),
  (route, occurrence) ∈ YulangClosure.OriginalSource.LogicalOccurrencesR104.sourceInventory context source scope →
    ∃ binder body,
      YulangClosure.OriginalSource.LogicalOccurrencesR104.follow scope
            (YulangClosure.OriginalSource.LogicalOccurrencesR104.Cursor.tree
              (YulangClosure.OriginalSource.sourceRules context source))
            route =
          some
            { enclosing := occurrence.enclosing,
              cursor :=
                YulangClosure.OriginalSource.LogicalOccurrencesR104.Cursor.tree
                  (YulangClosure.OriginalSource.RuleTree.existsE binder body) } ∧
        YulangClosure.OriginalSource.LogicalOccurrencesR104.logicalKind binder.kind = true ∧
          occurrence.binder = binder ∧ occurrence.subtree = body
'YulangClosure.OriginalSource.LogicalOccurrencesR104.source_provenance' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
