YulangClosure.OriginalSource.LogicalOccurrencesR104.inventory_iff_lookup : ∀
  (index : YulangClosure.OriginalSource.LogicalOccurrencesR104.Index)
  (route : YulangClosure.OriginalSource.LogicalOccurrencesR104.Route)
  (occurrence : YulangClosure.OriginalSource.LogicalOccurrencesR104.Occurrence),
  (route, occurrence) ∈ YulangClosure.OriginalSource.LogicalOccurrencesR104.inventory index ↔
    YulangClosure.OriginalSource.LogicalOccurrencesR104.lookup index route = some occurrence
